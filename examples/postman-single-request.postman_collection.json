{
  "info": {
    "_postman_id": "3c2a344c-ff09-4b88-874b-2fd856f57bb8",
    "name": "PostMegaMan - отдельный запрос",
    "description": "Коллекция с одним запросом без папок: импортировать как новый черновик.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://postman-echo.com", "type": "string" },
    { "key": "demoToken", "value": "demo-postman-bearer-not-a-secret", "type": "string" }
  ],
  "item": [
    {
      "name": "Одиночный POST JSON",
      "request": {
        "method": "POST",
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{demoToken}}", "type": "string" }]
        },
        "url": {
          "raw": "{{baseUrl}}/post?source=single&tag=one&tag=two",
          "query": [
            { "key": "source", "value": "single" },
            { "key": "tag", "value": "one" },
            { "key": "tag", "value": "two" },
            { "key": "debug", "value": "true", "disabled": true }
          ]
        },
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "X-Import-Example", "value": "single-request" },
          { "key": "X-Disabled", "value": "must-not-be-imported", "disabled": true }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"Тест отдельного запроса\",\n    \"active\": true,\n    \"amount\": 123.45,\n    \"items\": [\n        {\"id\": 1, \"value\": null},\n        {\"id\": 2, \"value\": \"кавычки: \\\"пример\\\"\"}\n    ],\n    \"nested\": {\n        \"settings\": {\"mode\": \"demo\", \"tags\": [\"postman\", \"импорт\"]}\n    }\n}",
          "options": { "raw": { "language": "json" } }
        }
      },
      "response": []
    }
  ]
}
