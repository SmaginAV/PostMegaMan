#Область ПрограммныйИнтерфейс

#КонецОбласти
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Разбирает одну команду cURL без выполнения оболочки и без изменения формы.
// Параметры:
//  ТекстКоманды - Строка - команда с непосредственными текстовыми данными.
// Возвращаемое значение:
//  Структура - Ошибка, Вид, Имя, Узлы, Предупреждения; запросы содержат пакет версии 1.
Функция РазобратьCURL(ТекстКоманды) Экспорт

	Результат = НовыйРезультатИмпорта();
	Попытка
		Аргументы = АргументыCURL(ТекстКоманды);
		Настройка = НастройкиCURL(Аргументы, Результат.Предупреждения);
		ПроверитьЗапросИмпорта(Настройка);
		Результат.Узлы.Добавить(УзелИмпорта("Импорт cURL", Ложь, Настройка));
	Исключение
		Результат.Ошибка = ОписаниеОшибки();
		Результат.Узлы.Очистить();
	КонецПопытки;
	Возврат Результат;

КонецФункции

// Читает Postman Collection v2.0/v2.1, отдельный item либо request.
// Параметры:
//  ТекстФайла - Строка - содержимое JSON; окружение и скрипты не исполняются.
// Возвращаемое значение:
//  Структура - результат полного разбора; при ошибке Узлы пусты.
//  Узлы запросов содержат СведенияQuery - Массив исходных пар, признаков использования и неизвестных шаблонов.
Функция РазобратьPostman(ТекстФайла) Экспорт

	Результат = НовыйРезультатИмпорта();
	Попытка
		Корень = ПрочитатьJSONИмпорта(ТекстФайла);
		РазобратьКореньPostman(Корень, Результат);
	Исключение
		Результат.Ошибка = ОписаниеОшибки();
		Результат.Узлы.Очистить();
	КонецПопытки;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий
#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НовыйРезультатИмпорта()

	Возврат Новый Структура("Ошибка,Вид,Имя,Узлы,Предупреждения",
		"", "Запрос", "Импорт Postman", Новый Массив, Новый Массив);

КонецФункции

Функция ПолеИмпорта(Данные, ИмяПоля, ПоУмолчанию = Неопределено)

	ЗначениеПоля = ПоУмолчанию;
	Если ТипЗнч(Данные) = Тип("Структура") Тогда
		Если Не Данные.Свойство(ИмяПоля, ЗначениеПоля) Тогда
			Возврат ПоУмолчанию;
		КонецЕсли;
	ИначеЕсли ТипЗнч(Данные) = Тип("Соответствие") Тогда
		ЗначениеПоля = Данные.Получить(ИмяПоля);
		Если ЗначениеПоля = Неопределено Тогда
			Возврат ПоУмолчанию;
		КонецЕсли;
	КонецЕсли;
	Возврат ЗначениеПоля;

КонецФункции

Функция ЭтоОбъектИмпорта(Данные)

	Возврат ТипЗнч(Данные) = Тип("Структура") Или ТипЗнч(Данные) = Тип("Соответствие");

КонецФункции

Функция ЕстьПолеИмпорта(Данные, ИмяПоля)

	Если ТипЗнч(Данные) = Тип("Структура") Тогда
		Возврат Данные.Свойство(ИмяПоля);
	ИначеЕсли ТипЗнч(Данные) = Тип("Соответствие") Тогда
		Для Каждого Пара Из Данные Цикл
			Если Пара.Ключ = ИмяПоля Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Ложь;

КонецФункции

Функция ПрочитатьJSONИмпорта(ТекстJSON)

	Читатель = Новый ЧтениеJSON;
	Попытка
		Читатель.УстановитьСтроку(ТекстJSON);
		Данные = ПрочитатьJSON(Читатель, Истина);
		Читатель.Закрыть();
	Исключение
		Читатель.Закрыть();
		ВызватьИсключение "Некорректный JSON файла импорта.";
	КонецПопытки;
	Возврат Данные;

КонецФункции

Функция НоваяНастройкаИмпорта()

	Данные = Новый Структура;
	ПустыеПоля = "Адрес,ТелоЗапроса,ОшибкаКонструктораJSON,Логин,Пароль,ТокенBearer,ИмяКлюча,ЗначениеКлюча,"
		+ "АдресТокена,ТелоТокена,ТокенJWT,КодОтвета,ИтоговыйАдрес,ОтправленноеТело,"
		+ "ИтоговыеЗаголовкиЗапроса,ЗаголовкиОтвета,ТелоОтвета,ОшибкаЗапроса";
	Для Каждого ИмяПоля Из СтрРазделить(ПустыеПоля, ",") Цикл
		Данные.Вставить(ИмяПоля, "");
	КонецЦикла;
	Данные.Вставить("Метод", "GET");
	Данные.Вставить("СпособАвторизации", "Нет");
	Данные.Вставить("РасположениеКлюча", "Заголовок");
	Данные.Вставить("МетодТокена", "POST");
	Данные.Вставить("ПутьТокена", "access_token");
	Данные.Вставить("СостояниеТокена", "Токен не получен");
	Данные.Вставить("ТаймаутСекунд", 30);
	Данные.Вставить("ВремяЗапросаМс", Неопределено);
	Данные.Вставить("ЗаголовкиЗапроса", Новый Массив);
	Данные.Вставить("ЗаголовкиТокена", Новый Массив);
	КорниJSON = Новый Массив;
	КорниJSON.Добавить(Новый Структура("Имя,Тип,Значение,Уровень,Дети",
		"", "Объект", "", 1, Новый Массив));
	Данные.Вставить("ДеревоJSON", КорниJSON);
	Возврат Данные;

КонецФункции

Функция УзелИмпорта(ИмяУзла, Каталог, Данные = Неопределено)

	ТекстСостояния = "";
	СведенияQuery = Неопределено;
	Если Не Каталог Тогда
		ДанныеПакета = Новый Структура;
		Для Каждого Поле Из Данные Цикл
			Если Поле.Ключ = "СведенияQuery" Тогда
				СведенияQuery = Поле.Значение;
			Иначе
				ДанныеПакета.Вставить(Поле.Ключ, Поле.Значение);
			КонецЕсли;
		КонецЦикла;
		Пакет = Новый Структура("Формат,Версия,АктивнаяВкладка,Данные",
			"PostMegaMan", 1, "СтраницаЗапрос", ДанныеПакета);
		Писатель = Новый ЗаписьJSON;
		Писатель.УстановитьСтроку();
		ЗаписатьJSON(Писатель, Пакет);
		ТекстСостояния = Писатель.Закрыть();
	КонецЕсли;
	Возврат Новый Структура("Имя,Каталог,Дети,ТекстСостояния,СведенияQuery",
		ИмяУзла, Каталог, Новый Массив, ТекстСостояния, СведенияQuery);

КонецФункции

Процедура ПроверитьЗапросИмпорта(Данные)

	Данные.Метод = ВРег(Данные.Метод);
	Если ПустаяСтрока(Данные.Метод) Или СтрДлина(Данные.Метод) > 40 Тогда
		ВызватьИсключение "Недопустимый HTTP-метод.";
	КонецЕсли;
	Если Не HTTPИмяИмпорта(Данные.Метод) Тогда
		ВызватьИсключение "Недопустимые символы HTTP-метода.";
	КонецЕсли;
	Если Данные.Метод = "GET" И Не ПустаяСтрока(Данные.ТелоЗапроса) Тогда
		ВызватьИсключение "GET с телом не поддерживается отправителем PostMegaMan.";
	КонецЕсли;
	Если СтрДлина(Данные.Адрес) > 2048 Или Найти(Данные.Адрес, Символы.ПС) > 0
		Или Найти(Данные.Адрес, Символы.ВК) > 0 Или Найти(Данные.Адрес, " ") > 0 Тогда
		ВызватьИсключение "URL превышает 2048 символов или содержит недопустимые символы.";
	КонецЕсли;
	Если Лев(НРег(Данные.Адрес), 7) <> "http://" И Лев(НРег(Данные.Адрес), 8) <> "https://" Тогда
		ВызватьИсключение "Импорт поддерживает только HTTP(S) URL.";
	КонецЕсли;
	НачалоХоста = Найти(Данные.Адрес, "://") + 3;
	ЧастьХоста = СтрРазделить(Сред(Данные.Адрес, НачалоХоста), "/")[0];
	ЧастьХоста = СтрРазделить(ЧастьХоста, "?")[0];
	Если ПустаяСтрока(ЧастьХоста) Или Найти(ЧастьХоста, "@") > 0 Или Найти(Данные.Адрес, "#") > 0 Тогда
		ВызватьИсключение "URL с пустым хостом, встроенной авторизацией или фрагментом не поддерживается.";
	КонецЕсли;
	Если СтрДлина(Данные.Логин) > 256 Или СтрДлина(Данные.Пароль) > 1024
		Или СтрДлина(Данные.ИмяКлюча) > 256 Или СтрДлина(Данные.ЗначениеКлюча) > 2048 Тогда
		ВызватьИсключение "Параметр авторизации превышает размер реквизита.";
	КонецЕсли;
	Если Данные.СпособАвторизации <> "Нет" И ИндексЗаголовкаИмпорта(Данные, "Authorization") >= 0 Тогда
		ВызватьИсключение "Конфликт заголовка Authorization и выбранной авторизации.";
	КонецЕсли;
	Если Данные.СпособАвторизации = "Bearer" Тогда
		Если ПустаяСтрока(Данные.ТокенBearer) Или Найти(Данные.ТокенBearer, Символы.ПС) > 0
			Или Найти(Данные.ТокенBearer, Символы.ВК) > 0 Тогда
			ВызватьИсключение "Некорректный токен Bearer.";
		КонецЕсли;
	ИначеЕсли Данные.СпособАвторизации = "APIKey" Тогда
		Если ПустаяСтрока(Данные.ИмяКлюча) Или ПустаяСтрока(Данные.ЗначениеКлюча) Тогда
			ВызватьИсключение "API key должен содержать имя и значение.";
		КонецЕсли;
		Если Данные.РасположениеКлюча = "Заголовок" Тогда
			Если Не HTTPИмяИмпорта(Данные.ИмяКлюча) Или Найти(Данные.ЗначениеКлюча, Символы.ПС) > 0
				Или Найти(Данные.ЗначениеКлюча, Символы.ВК) > 0 Тогда
				ВызватьИсключение "Некорректное имя или значение заголовка API key.";
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Функция HTTPИмяИмпорта(Имя)

	Если ПустаяСтрока(Имя) Тогда
		Возврат Ложь;
	КонецЕсли;
	Допустимые = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!#$%&'*+-.^_`|~";
	Для Позиция = 1 По СтрДлина(Имя) Цикл
		Если Найти(Допустимые, Сред(Имя, Позиция, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

Функция ИндексЗаголовкаИмпорта(Данные, Имя)

	Для Индекс = 0 По Данные.ЗаголовкиЗапроса.Количество() - 1 Цикл
		Если НРег(Данные.ЗаголовкиЗапроса[Индекс].Имя) = НРег(Имя) Тогда
			Возврат Индекс;
		КонецЕсли;
	КонецЦикла;
	Возврат -1;

КонецФункции

Процедура ЗаголовокИмпорта(Данные, Имя, Значение, ТолькоЕслиНет = Ложь)

	Если СтрДлина(Имя) > 256 Или Не HTTPИмяИмпорта(Имя) Тогда
		ВызватьИсключение "Недопустимое имя заголовка.";
	КонецЕсли;
	Если СтрДлина(Значение) > 2048 Или Найти(Значение, Символы.ПС) > 0
		Или Найти(Значение, Символы.ВК) > 0 Тогда
		ВызватьИсключение "Значение заголовка слишком длинное или содержит перенос строки.";
	КонецЕсли;
	Если ИндексЗаголовкаИмпорта(Данные, Имя) >= 0 Тогда
		Если ТолькоЕслиНет Тогда
			Возврат;
		КонецЕсли;
		ВызватьИсключение "Повторное активное имя заголовка.";
	КонецЕсли;
	Данные.ЗаголовкиЗапроса.Добавить(Новый Структура("Имя,Значение", Имя, Значение));

КонецПроцедуры

Процедура СтрокаЗаголовкаИмпорта(Данные, Текст)

	Разделитель = Найти(Текст, ":");
	Если Разделитель < 2 Тогда
		ВызватьИсключение "Заголовок должен содержать имя и двоеточие.";
	КонецЕсли;
	ЗаголовокИмпорта(Данные, Лев(Текст, Разделитель - 1), СокрЛП(Сред(Текст, Разделитель + 1)));

КонецПроцедуры

Функция QueryИмпорта(Имя, Значение)

	Возврат КодироватьПараметрИмпорта(Имя) + "="
		+ КодироватьПараметрИмпорта(Значение);

КонецФункции

Функция ДобавитьQueryИмпорта(Адрес, Query)

	Если Query = "" Тогда
		Возврат Адрес;
	КонецЕсли;
	Разделитель = "?";
	Если Найти(Адрес, "?") > 0 Тогда
		Разделитель = "&";
		Если Прав(Адрес, 1) = "?" Или Прав(Адрес, 1) = "&" Тогда
			Разделитель = "";
		КонецЕсли;
	КонецЕсли;
	Возврат Адрес + Разделитель + Query;

КонецФункции

Функция АргументыCURL(Текст)

	Диалект = "POSIX";
	Если Найти(Текст, "`" + Символы.ПС) > 0 Или Найти(Текст, "`" + Символы.ВК) > 0 Тогда
		Диалект = "PowerShell";
	ИначеЕсли Найти(Текст, "^" + Символы.ПС) > 0 Или Найти(Текст, "^" + Символы.ВК) > 0 Тогда
		Диалект = "cmd";
	ИначеЕсли Найти(Текст, "`""") > 0 Тогда
		Диалект = "PowerShell";
	КонецЕсли;
	Аргументы = ТокеныCURL(Текст, Диалект);
	Если Диалект = "POSIX" И Найти(Текст, "''") > 0 И Найти(Текст, "'\''") = 0 Тогда
		АргументыPowerShell = ТокеныCURL(Текст, "PowerShell");
		Если СтрСоединить(Аргументы, Символы.ПС) <> СтрСоединить(АргументыPowerShell, Символы.ПС) Тогда
			ВызватьИсключение "Неоднозначные кавычки cURL: укажите диалект переносом строки или экранированием.";
		КонецЕсли;
	КонецЕсли;
	Если Аргументы.Количество() < 2 Тогда
		ВызватьИсключение "Вставьте полную команду curl с URL.";
	КонецЕсли;
	Если НРег(Аргументы[0]) <> "curl" И НРег(Аргументы[0]) <> "curl.exe" Тогда
		ВызватьИсключение "Команда должна начинаться с curl или curl.exe.";
	КонецЕсли;
	Возврат Аргументы;

КонецФункции

Функция ТокеныCURL(Текст, Диалект)

	Аргументы = Новый Массив;
	Токен = "";
	Кавычка = "";
	Начат = Ложь;
	Позиция = 1;
	Пока Позиция <= СтрДлина(Текст) Цикл
		Знак = Сред(Текст, Позиция, 1);
		Следующий = Сред(Текст, Позиция + 1, 1);
		Если Кавычка = "'" Тогда
			Если Знак = "'" Тогда
				Если Диалект = "PowerShell" И Следующий = "'" Тогда
					Токен = Токен + "'";
					Позиция = Позиция + 1;
				Иначе
					Кавычка = "";
				КонецЕсли;
			Иначе
				Токен = Токен + Знак;
			КонецЕсли;
		ИначеЕсли ЭкранирующийЗнакCURL(Знак, Кавычка, Диалект, Следующий) Тогда
			Если Позиция = СтрДлина(Текст) Тогда
				ВызватьИсключение "Незавершённое экранирование cURL.";
			КонецЕсли;
			Если Следующий = Символы.ВК Или Следующий = Символы.ПС Тогда
				Если Следующий = Символы.ВК И Сред(Текст, Позиция + 2, 1) = Символы.ПС Тогда
					Позиция = Позиция + 1;
				КонецЕсли;
			Иначе
				Токен = Токен + ЭкранированныйЗнакCURL(Следующий, Диалект);
				Начат = Истина;
			КонецЕсли;
			Позиция = Позиция + 1;
		ИначеЕсли Знак = Кавычка И Кавычка <> "" Тогда
			Кавычка = "";
		ИначеЕсли (Знак = "'" И Диалект <> "cmd" Или Знак = """") И Кавычка = "" Тогда
			Кавычка = Знак;
			Начат = Истина;
		ИначеЕсли Знак = "$" Или Знак = "`" Тогда
			ВызватьИсключение "Подстановка оболочки в cURL не поддерживается. Используйте буквальные значения.";
		ИначеЕсли Кавычка = "" И Найти(";|&<>", Знак) > 0 Тогда
			ВызватьИсключение "Операторы оболочки и дополнительные команды не поддерживаются.";
		ИначеЕсли Кавычка = "" И Найти(" " + Символы.Таб + Символы.ПС + Символы.ВК, Знак) > 0 Тогда
			Если Начат Тогда
				Аргументы.Добавить(Токен);
				Токен = "";
				Начат = Ложь;
			КонецЕсли;
		Иначе
			Токен = Токен + Знак;
			Начат = Истина;
		КонецЕсли;
		Позиция = Позиция + 1;
	КонецЦикла;
	Если Кавычка <> "" Тогда
		ВызватьИсключение "Незакрытая кавычка cURL.";
	КонецЕсли;
	Если Начат Тогда
		Аргументы.Добавить(Токен);
	КонецЕсли;
	Возврат Аргументы;

КонецФункции

Функция ЭкранированныйЗнакCURL(Знак, Диалект)

	Если Диалект = "PowerShell" Тогда
		Если Знак = "n" Тогда
			Возврат Символы.ПС;
		ИначеЕсли Знак = "r" Тогда
			Возврат Символы.ВК;
		ИначеЕсли Знак = "t" Тогда
			Возврат Символы.Таб;
		КонецЕсли;
	КонецЕсли;
	Возврат Знак;

КонецФункции

Функция ЭкранирующийЗнакCURL(Знак, Кавычка, Диалект, Следующий)

	Если Диалект = "PowerShell" Тогда
		Возврат Знак = "`";
	ИначеЕсли Диалект = "cmd" Тогда
		Возврат (Знак = "^" И Кавычка = "") Или (Знак = "\" И Следующий = """");
	КонецЕсли;
	Если Знак <> "\" Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Кавычка = "" Или Найти("\""$`" + Символы.ПС + Символы.ВК, Следующий) > 0;

КонецФункции

Функция ОпцияCURL(Аргументы, Индекс)

	Токен = Аргументы[Индекс];
	Опция = Токен;
	ЗначениеОпции = "";
	БезЗначения = "-G,--get,-I,--head,--basic,-s,--silent,-S,--show-error,-v,--verbose,-i,--include,--no-progress-meter";
	Если СтрРазделить(БезЗначения, ",").Найти(Токен) <> Неопределено Тогда
		Возврат Новый Структура("Имя,Значение", Опция, ЗначениеОпции);
	КонецЕсли;
	СЗначением = "-X,--request,--url,-H,--header,-d,--data,--data-ascii,--data-raw,--data-binary,"
		+ "--data-urlencode,--json,-u,--user,--oauth2-bearer,-A,--user-agent,-e,--referer,-b,--cookie,-m,--max-time";
	Допустимые = СтрРазделить(СЗначением, ",");
	Равно = Найти(Токен, "=");
	ЕстьЗначение = Ложь;
	Если Лев(Токен, 2) = "--" И Равно > 0 Тогда
		Опция = Лев(Токен, Равно - 1);
		ЗначениеОпции = Сред(Токен, Равно + 1);
		ЕстьЗначение = Истина;
	ИначеЕсли Лев(Токен, 2) <> "--" И СтрДлина(Токен) > 2 Тогда
		Опция = Лев(Токен, 2);
		ЗначениеОпции = Сред(Токен, 3);
		ЕстьЗначение = Истина;
	КонецЕсли;
	Если Допустимые.Найти(Опция) = Неопределено Тогда
		ВызватьИсключение "Неподдерживаемая опция cURL: " + Опция;
	КонецЕсли;
	Если Не ЕстьЗначение Тогда
		Индекс = Индекс + 1;
		Если Индекс >= Аргументы.Количество() Тогда
			ВызватьИсключение "Отсутствует значение опции cURL: " + Опция;
		КонецЕсли;
		ЗначениеОпции = Аргументы[Индекс];
	КонецЕсли;
	Возврат Новый Структура("Имя,Значение", Опция, ЗначениеОпции);

КонецФункции

Функция НастройкиCURL(Аргументы, Предупреждения)

	Данные = НоваяНастройкаИмпорта();
	Режим = Новый Структура("Метод,GET,HEAD,Данные,JSON,Basic", "", Ложь, Ложь, Ложь, Ложь, Ложь);
	ЧастиТела = Новый Массив;
	Индекс = 1;
	Пока Индекс < Аргументы.Количество() Цикл
		Если Лев(Аргументы[Индекс], 1) <> "-" Тогда
			УстановитьURLCURL(Данные, Аргументы[Индекс]);
		Иначе
			Опция = ОпцияCURL(Аргументы, Индекс);
			ПрименитьОпциюCURL(Данные, Режим, ЧастиТела, Опция, Предупреждения);
		КонецЕсли;
		Индекс = Индекс + 1;
	КонецЦикла;
	Если Режим.Данные Тогда
		Разделитель = "&";
		Если Режим.JSON Тогда
			Разделитель = "";
			ЗаголовокИмпорта(Данные, "Content-Type", "application/json", Истина);
			ЗаголовокИмпорта(Данные, "Accept", "application/json", Истина);
		Иначе
			ЗаголовокИмпорта(Данные, "Content-Type", "application/x-www-form-urlencoded", Истина);
		КонецЕсли;
		Данные.ТелоЗапроса = СтрСоединить(ЧастиТела, Разделитель);
		Данные.Метод = "POST";
	КонецЕсли;
	Если Режим.GET Тогда
		Данные.Адрес = ДобавитьQueryИмпорта(Данные.Адрес, Данные.ТелоЗапроса);
		Данные.ТелоЗапроса = "";
		Данные.Метод = "GET";
	КонецЕсли;
	Если Режим.HEAD Тогда
		Если Режим.Данные И Не Режим.GET Тогда
			ВызватьИсключение "Конфликт --head и тела cURL без --get.";
		КонецЕсли;
		Данные.Метод = "HEAD";
	КонецЕсли;
	Если Режим.Метод <> "" Тогда
		Данные.Метод = Режим.Метод;
	КонецЕсли;
	Если Режим.Basic И Данные.СпособАвторизации <> "Basic" Тогда
		ВызватьИсключение "--basic требует --user с логином и паролем.";
	КонецЕсли;
	АвторизацияИзЗаголовкаИмпорта(Данные);
	Возврат Данные;

КонецФункции

Процедура УстановитьURLCURL(Данные, Адрес)

	Если Данные.Адрес <> "" Тогда
		ВызватьИсключение "Поддерживается только один URL cURL.";
	КонецЕсли;
	Данные.Адрес = Адрес;

КонецПроцедуры

Процедура ПрименитьОпциюCURL(Данные, Режим, ЧастиТела, Опция, Предупреждения)

	Имя = Опция.Имя;
	ЗначениеОпции = Опция.Значение;
	Если Имя = "--url" Тогда
		УстановитьURLCURL(Данные, ЗначениеОпции);
	ИначеЕсли Имя = "-X" Или Имя = "--request" Тогда
		Если Режим.Метод <> "" И Режим.Метод <> ВРег(ЗначениеОпции) Тогда
			ВызватьИсключение "Противоречивые HTTP-методы cURL.";
		КонецЕсли;
		Режим.Метод = ВРег(ЗначениеОпции);
	ИначеЕсли Имя = "-G" Или Имя = "--get" Тогда
		Режим.GET = Истина;
	ИначеЕсли Имя = "-I" Или Имя = "--head" Тогда
		Режим.HEAD = Истина;
	ИначеЕсли Имя = "-H" Или Имя = "--header" Тогда
		СтрокаЗаголовкаИмпорта(Данные, ЗначениеОпции);
	ИначеЕсли Имя = "-u" Или Имя = "--user" Тогда
		ПроверитьНовуюАвторизациюИмпорта(Данные);
		Двоеточие = Найти(ЗначениеОпции, ":");
		Если Двоеточие = 0 Тогда
			ВызватьИсключение "Интерактивный пароль --user не поддерживается.";
		КонецЕсли;
		Данные.СпособАвторизации = "Basic";
		Данные.Логин = Лев(ЗначениеОпции, Двоеточие - 1);
		Данные.Пароль = Сред(ЗначениеОпции, Двоеточие + 1);
	ИначеЕсли Имя = "--basic" Тогда
		Режим.Basic = Истина;
	ИначеЕсли Имя = "--oauth2-bearer" Тогда
		ПроверитьНовуюАвторизациюИмпорта(Данные);
		Данные.СпособАвторизации = "Bearer";
		Данные.ТокенBearer = ЗначениеОпции;
	ИначеЕсли Имя = "-A" Или Имя = "--user-agent" Тогда
		ЗаголовокИмпорта(Данные, "User-Agent", ЗначениеОпции);
	ИначеЕсли Имя = "-e" Или Имя = "--referer" Тогда
		Если Прав(ЗначениеОпции, 5) = ";auto" Тогда
			ВызватьИсключение "Автоматический Referer не поддерживается.";
		КонецЕсли;
		ЗаголовокИмпорта(Данные, "Referer", ЗначениеОпции);
	ИначеЕсли Имя = "-b" Или Имя = "--cookie" Тогда
		Если Найти(ЗначениеОпции, "=") = 0 Тогда
			ВызватьИсключение "Файл cookies не поддерживается; нужна строка name=value.";
		КонецЕсли;
		ЗаголовокИмпорта(Данные, "Cookie", ЗначениеОпции);
	ИначеЕсли Имя = "-m" Или Имя = "--max-time" Тогда
		Попытка
			Таймаут = Число(ЗначениеОпции);
		Исключение
			ВызватьИсключение "Таймаут cURL должен быть целым числом секунд.";
		КонецПопытки;
		Если Таймаут <= 0 Или Таймаут > 99999 Или Таймаут <> Цел(Таймаут) Тогда
			ВызватьИсключение "Таймаут cURL должен быть целым числом от 1 до 99999.";
		КонецЕсли;
		Данные.ТаймаутСекунд = Таймаут;
	ИначеЕсли СтрРазделить("-s,--silent,-S,--show-error,-v,--verbose,-i,--include,--no-progress-meter", ",").Найти(Имя)
		<> Неопределено Тогда
		Предупреждения.Добавить("Пропущена опция вывода cURL: " + Имя);
	Иначе
		ДобавитьДанныеCURL(Режим, ЧастиТела, Опция);
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьДанныеCURL(Режим, ЧастиТела, Опция)

	JSONОпция = Опция.Имя = "--json";
	Если Режим.Данные И Режим.JSON <> JSONОпция Тогда
		ВызватьИсключение "Смешение --json с другими режимами тела не поддерживается.";
	КонецЕсли;
	Режим.Данные = Истина;
	Режим.JSON = JSONОпция;
	Тело = Опция.Значение;
	Если Опция.Имя = "--data-urlencode" Тогда
		Равно = Найти(Тело, "=");
		Собака = Найти(Тело, "@");
		Если Собака > 0 И (Равно = 0 Или Собака < Равно) Тогда
			ВызватьИсключение "Файловая форма --data-urlencode не поддерживается.";
		КонецЕсли;
		Если Равно = 0 Или Равно = 1 Тогда
			Если Равно = 1 Тогда
				Тело = Сред(Тело, 2);
			КонецЕсли;
			Тело = КодироватьПараметрИмпорта(Тело);
		Иначе
			Тело = Лев(Тело, Равно) + КодироватьПараметрИмпорта(Сред(Тело, Равно + 1));
		КонецЕсли;
	ИначеЕсли Опция.Имя <> "--data-raw" И Лев(Тело, 1) = "@" Тогда
		ВызватьИсключение "Чтение тела cURL из файла или stdin не поддерживается.";
	КонецЕсли;
	ЧастиТела.Добавить(Тело);

КонецПроцедуры

Процедура ПроверитьНовуюАвторизациюИмпорта(Данные)

	Если Данные.СпособАвторизации <> "Нет" Тогда
		ВызватьИсключение "В запросе заданы конфликтующие источники авторизации.";
	КонецЕсли;

КонецПроцедуры

Процедура АвторизацияИзЗаголовкаИмпорта(Данные)

	Индекс = ИндексЗаголовкаИмпорта(Данные, "Authorization");
	Если Индекс < 0 Тогда
		Возврат;
	КонецЕсли;
	ЗначениеЗаголовка = Данные.ЗаголовкиЗапроса[Индекс].Значение;
	Если Лев(НРег(ЗначениеЗаголовка), 7) = "bearer " Тогда
		Токен = Сред(ЗначениеЗаголовка, 8);
		Если Данные.СпособАвторизации = "Bearer" И Данные.ТокенBearer = Токен Тогда
			Данные.ЗаголовкиЗапроса.Удалить(Индекс);
			Возврат;
		КонецЕсли;
		ПроверитьНовуюАвторизациюИмпорта(Данные);
		Данные.СпособАвторизации = "Bearer";
		Данные.ТокенBearer = Токен;
		Данные.ЗаголовкиЗапроса.Удалить(Индекс);
	КонецЕсли;

КонецПроцедуры

Функция КонтекстPostman(Узел, Родитель)

	Переменные = Новый Соответствие;
	Если Родитель <> Неопределено Тогда
		Для Каждого Пара Из Родитель.Переменные Цикл
			Переменные.Вставить(Пара.Ключ, Пара.Значение);
		КонецЦикла;
		Авторизация = Родитель.Авторизация;
	Иначе
		Авторизация = Неопределено;
	КонецЕсли;
	Определения = ПолеИмпорта(Узел, "variable", Новый Массив);
	Если ТипЗнч(Определения) <> Тип("Массив") Тогда
		ВызватьИсключение "Список переменных Postman должен быть массивом.";
	КонецЕсли;
	Для Каждого Определение Из Определения Цикл
		Если ПолеИмпорта(Определение, "disabled", Ложь) Тогда
			Продолжить;
		КонецЕсли;
		ИмяПеременной = ПолеИмпорта(Определение, "key", "");
		Если ИмяПеременной = "" Тогда
			ИмяПеременной = ПолеИмпорта(Определение, "id", "");
		КонецЕсли;
		Если ТипЗнч(ИмяПеременной) <> Тип("Строка") Или ИмяПеременной = "" Тогда
			ВызватьИсключение "Переменная Postman не имеет имени.";
		КонецЕсли;
		Переменные.Вставить(ИмяПеременной, ПолеИмпорта(Определение, "value"));
	КонецЦикла;
	СобственнаяАвторизация = ПолеИмпорта(Узел, "auth");
	Если СобственнаяАвторизация <> Неопределено Тогда
		Авторизация = СобственнаяАвторизация;
	КонецЕсли;
	Возврат Новый Структура("Переменные,Авторизация", Переменные, Авторизация);

КонецФункции

Функция ТекстЗначенияPostman(Значение)

	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат Значение;
	КонецЕсли;
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Писатель = Новый ЗаписьJSON;
	Писатель.УстановитьСтроку();
	ЗаписатьJSON(Писатель, Значение);
	Возврат Писатель.Закрыть();

КонецФункции

Функция ТекстPostman(Текст, Контекст, Цепочка = Неопределено)

	Текст = ТекстЗначенияPostman(Текст);
	Если Цепочка = Неопределено Тогда
		Цепочка = Новый Массив;
	КонецЕсли;
	Результат = "";
	Пока Найти(Текст, "{{") > 0 Цикл
		Начало = Найти(Текст, "{{");
		Остаток = Сред(Текст, Начало + 2);
		Конец = Найти(Остаток, "}}");
		Если Конец = 0 Тогда
			ВызватьИсключение "Незавершённая переменная Postman.";
		КонецЕсли;
		ИмяПеременной = Лев(Остаток, Конец - 1);
		Если Лев(ИмяПеременной, 1) = "$" Или Лев(НРег(ИмяПеременной), 6) = "vault:" Тогда
			ВызватьИсключение "Динамическая или Vault-переменная Postman не поддерживается: " + ИмяПеременной;
		КонецЕсли;
		Если Цепочка.Найти(ИмяПеременной) <> Неопределено Тогда
			ВызватьИсключение "Циклическая переменная Postman: " + ИмяПеременной;
		КонецЕсли;
		ЗначениеПеременной = Контекст.Переменные.Получить(ИмяПеременной);
		Если ЗначениеПеременной = Неопределено Тогда
			ВызватьИсключение "Не определена переменная Postman: " + ИмяПеременной;
		КонецЕсли;
		Цепочка.Добавить(ИмяПеременной);
		Подстановка = ТекстPostman(ЗначениеПеременной, Контекст, Цепочка);
		Цепочка.Удалить(Цепочка.Количество() - 1);
		Результат = Результат + Лев(Текст, Начало - 1) + Подстановка;
		Текст = Сред(Остаток, Конец + 2);
	КонецЦикла;
	Возврат Результат + Текст;

КонецФункции

Процедура ПроверитьСлужебныеДанныеPostman(Узел, Предупреждения)

	События = ПолеИмпорта(Узел, "event", Новый Массив);
	Если ТипЗнч(События) <> Тип("Массив") Тогда
		ВызватьИсключение "Некорректный список событий Postman.";
	КонецЕсли;
	Для Каждого Событие Из События Цикл
		Если ПолеИмпорта(Событие, "disabled", Ложь) Тогда
			Продолжить;
		КонецЕсли;
		Скрипт = ПолеИмпорта(Событие, "script");
		КодСкрипта = ПолеИмпорта(Скрипт, "exec", "");
		Если ТипЗнч(КодСкрипта) = Тип("Массив") Тогда
			КодСкрипта = СтрСоединить(КодСкрипта, Символы.ПС);
		КонецЕсли;
		ЕстьСкрипт = Не ПустаяСтрока(ТекстЗначенияPostman(КодСкрипта))
			Или ПолеИмпорта(Скрипт, "src") <> Неопределено;
		Если ЕстьСкрипт И ПолеИмпорта(Событие, "listen", "") = "prerequest" Тогда
			ВызватьИсключение "Активный pre-request-скрипт Postman не поддерживается.";
		КонецЕсли;
		Если ЕстьСкрипт Тогда
			Предупреждения.Добавить("Скрипты после ответа не перенесены и не выполнялись.");
		КонецЕсли;
	КонецЦикла;
	ПримерыОтвета = ПолеИмпорта(Узел, "response", Новый Массив);
	Если ТипЗнч(ПримерыОтвета) = Тип("Массив") Тогда
		Если ПримерыОтвета.Количество() > 0 Тогда
			Предупреждения.Добавить("Сохраненные примеры ответа не перенесены.");
		КонецЕсли;
	ИначеЕсли ПримерыОтвета <> Неопределено Тогда
		Предупреждения.Добавить("Сохраненные примеры ответа не перенесены.");
	КонецЕсли;
	ОписаниеУзла = ПолеИмпорта(Узел, "description", "");
	Если ЭтоОбъектИмпорта(ОписаниеУзла) Тогда
		ОписаниеУзла = ПолеИмпорта(ОписаниеУзла, "content", "");
	КонецЕсли;
	Если Не ПустаяСтрока(ТекстЗначенияPostman(ОписаниеУзла)) Тогда
		Предупреждения.Добавить("Описание не перенесено.");
	КонецЕсли;
	Если ПолеИмпорта(Узел, "protocolProfileBehavior") <> Неопределено Тогда
		Профиль = ПолеИмпорта(Узел, "protocolProfileBehavior");
		Если Не ЭтоОбъектИмпорта(Профиль) Или Профиль.Количество() > 0 Тогда
			ВызватьИсключение "Транспортные настройки protocolProfileBehavior не поддерживаются.";
		КонецЕсли;
	КонецЕсли;
	Для Каждого ИмяПоля Из СтрРазделить("proxy,certificate", ",") Цикл
		Если ПолеИмпорта(Узел, ИмяПоля) <> Неопределено Тогда
			ВызватьИсключение "Неподдерживаемая настройка Postman: " + ИмяПоля;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьПредупрежденияУзлаPostman(Предупреждения, ПредупрежденияУзла, ПредставлениеУзла)

	Если ПредупрежденияУзла.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Подробности = Новый Массив;
	Для Каждого Предупреждение Из ПредупрежденияУзла Цикл
		Если Подробности.Найти(Предупреждение) = Неопределено Тогда
			Подробности.Добавить(Предупреждение);
		КонецЕсли;
	КонецЦикла;
	Предупреждения.Добавить(СтрШаблон("%1:%2  - %3", ПредставлениеУзла, Символы.ПС,
		СтрСоединить(Подробности, Символы.ПС + "  - ")));

КонецПроцедуры

Процедура РазобратьКореньPostman(Корень, Результат)

	Если Не ЭтоОбъектИмпорта(Корень) Тогда
		ВызватьИсключение "Ожидался объект запроса или коллекции Postman.";
	КонецЕсли;
	Контекст = КонтекстPostman(Корень, Неопределено);
	Если ЕстьПолеИмпорта(Корень, "item") Тогда
		ОписаниеКоллекции = ПолеИмпорта(Корень, "info");
		Схема = ПолеИмпорта(ОписаниеКоллекции, "schema", "");
		Если Найти(Схема, "/collection/v2.1.0/") = 0 И Найти(Схема, "/collection/v2.0.0/") = 0 Тогда
			ВызватьИсключение "Поддерживаются только Postman Collection v2.0 и v2.1.";
		КонецЕсли;
		Результат.Имя = ТекстЗначенияPostman(ПолеИмпорта(ОписаниеКоллекции, "name", "Импорт Postman"));
		ПредупрежденияКоллекции = Новый Массив;
		ПроверитьСлужебныеДанныеPostman(Корень, ПредупрежденияКоллекции);
		ПроверитьСлужебныеДанныеPostman(ОписаниеКоллекции, ПредупрежденияКоллекции);
		ДобавитьПредупрежденияУзлаPostman(Результат.Предупреждения, ПредупрежденияКоллекции,
			СтрШаблон("Коллекция «%1»", Результат.Имя));
		ОбойтиPostman(ПолеИмпорта(Корень, "item"), Результат.Узлы, Контекст,
			Результат.Имя, Результат.Предупреждения);
		Если Результат.Узлы.Количество() = 0 Тогда
			ВызватьИсключение "Нет запросов для импорта.";
		КонецЕсли;
		Если Результат.Узлы.Количество() <> 1 Или Результат.Узлы[0].Каталог Тогда
			Результат.Вид = "Дерево";
		КонецЕсли;
	ИначеЕсли ЕстьПолеИмпорта(Корень, "request") Тогда
		ЭлементыКорня = Новый Массив;
		ЭлементыКорня.Добавить(Корень);
		ОбойтиPostman(ЭлементыКорня, Результат.Узлы, Контекст, "", Результат.Предупреждения);
	ИначеЕсли ЕстьПолеИмпорта(Корень, "method") И ЕстьПолеИмпорта(Корень, "url") Тогда
		ПредупрежденияЗапроса = Новый Массив;
		Данные = НастройкиPostman(Корень, Контекст, ПредупрежденияЗапроса);
		ДобавитьПредупрежденияУзлаPostman(Результат.Предупреждения, ПредупрежденияЗапроса,
			"Запрос «Импорт Postman»");
		Результат.Узлы.Добавить(УзелИмпорта("Импорт Postman", Ложь, Данные));
	Иначе
		ВызватьИсключение "Файл не является запросом или коллекцией Postman; окружения не импортируются.";
	КонецЕсли;

КонецПроцедуры

Процедура ОбойтиPostman(ЭлементыPostman, Узлы, Родитель, Путь, Предупреждения)

	Если ТипЗнч(ЭлементыPostman) <> Тип("Массив") Тогда
		ВызватьИсключение "Список item Postman должен быть массивом.";
	КонецЕсли;
	Для Каждого ЭлементPostman Из ЭлементыPostman Цикл
		ИмяУзла = ТекстЗначенияPostman(ПолеИмпорта(ЭлементPostman, "name", "Запрос"));
		ПутьУзла = ИмяУзла;
		Если Не ПустаяСтрока(Путь) Тогда
			ПутьУзла = СтрШаблон("%1 / %2", Путь, ИмяУзла);
		КонецЕсли;
		Попытка
			Контекст = КонтекстPostman(ЭлементPostman, Родитель);
			ПредупрежденияУзла = Новый Массив;
			ПроверитьСлужебныеДанныеPostman(ЭлементPostman, ПредупрежденияУзла);
			Если ЕстьПолеИмпорта(ЭлементPostman, "item") Тогда
				Узел = УзелИмпорта(ИмяУзла, Истина);
				ДобавитьПредупрежденияУзлаPostman(Предупреждения, ПредупрежденияУзла,
					СтрШаблон("Каталог «%1»", ПутьУзла));
				ОбойтиPostman(ПолеИмпорта(ЭлементPostman, "item"), Узел.Дети, Контекст, ПутьУзла, Предупреждения);
			ИначеЕсли ЕстьПолеИмпорта(ЭлементPostman, "request") Тогда
				Данные = НастройкиPostman(ПолеИмпорта(ЭлементPostman, "request"), Контекст, ПредупрежденияУзла);
				Узел = УзелИмпорта(ИмяУзла, Ложь, Данные);
				ДобавитьПредупрежденияУзлаPostman(Предупреждения, ПредупрежденияУзла,
					СтрШаблон("Запрос «%1»", ПутьУзла));
			Иначе
				ВызватьИсключение "Узел не содержит item или request.";
			КонецЕсли;
			Узлы.Добавить(Узел);
		Исключение
			ВызватьИсключение "Запрос/каталог Postman " + ПутьУзла + ": " + ОписаниеОшибки();
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

Функция НастройкиPostman(Запрос, Родитель, Предупреждения)

	Данные = НоваяНастройкаИмпорта();
	Если ТипЗнч(Запрос) = Тип("Строка") Тогда
		Данные.Адрес = ТекстPostman(Запрос, Родитель);
		АвторизацияPostman(Данные, Родитель);
	ИначеЕсли ЭтоОбъектИмпорта(Запрос) Тогда
		Контекст = КонтекстPostman(Запрос, Родитель);
		ПроверитьСлужебныеДанныеPostman(Запрос, Предупреждения);
		Данные.Метод = ТекстPostman(ПолеИмпорта(Запрос, "method", "GET"), Контекст);
		Данные.Адрес = АдресPostman(ПолеИмпорта(Запрос, "url"), Контекст);
		ЗаголовкиPostman(Данные, ПолеИмпорта(Запрос, "header", Новый Массив), Контекст);
		ТелоPostman(Данные, ПолеИмпорта(Запрос, "body"), Контекст);
		АвторизацияPostman(Данные, Контекст);
		Данные.Вставить("СведенияQuery", СведенияПараметровPostman(ПолеИмпорта(Запрос, "url"), Контекст, Данные));
	Иначе
		ВызватьИсключение "Некорректный request Postman.";
	КонецЕсли;
	АвторизацияИзЗаголовкаИмпорта(Данные);
	ПроверитьЗапросИмпорта(Данные);
	Возврат Данные;

КонецФункции

Функция АдресPostman(ОписаниеURL, Контекст)

	Если ТипЗнч(ОписаниеURL) = Тип("Строка") Тогда
		Возврат ТекстPostman(ОписаниеURL, Контекст);
	КонецЕсли;
	Если Не ЭтоОбъектИмпорта(ОписаниеURL) Тогда
		ВызватьИсключение "Отсутствует URL Postman.";
	КонецЕсли;
	Адрес = ПолеИмпорта(ОписаниеURL, "raw", "");
	Если Адрес = "" Тогда
		Хост = ПолеИмпорта(ОписаниеURL, "host", "");
		Если ТипЗнч(Хост) = Тип("Массив") Тогда
			Хост = СтрСоединить(Хост, ".");
		КонецЕсли;
		Путь = ПолеИмпорта(ОписаниеURL, "path", "");
		Если ТипЗнч(Путь) = Тип("Массив") Тогда
			Путь = СтрСоединить(Путь, "/");
		КонецЕсли;
		Адрес = ПолеИмпорта(ОписаниеURL, "protocol", "https") + "://" + Хост;
		Порт = ПолеИмпорта(ОписаниеURL, "port", "");
		Если Порт <> "" Тогда
			Адрес = Адрес + ":" + ТекстЗначенияPostman(Порт);
		КонецЕсли;
		Адрес = Адрес + "/" + Путь;
	КонецЕсли;
	КонтекстURL = КонтекстPostman(ОписаниеURL, Контекст);
	Если ЕстьПолеИмпорта(ОписаниеURL, "query") И Найти(Адрес, "?") > 0 Тогда
		Адрес = Лев(Адрес, Найти(Адрес, "?") - 1);
	КонецЕсли;
	Адрес = ТекстPostman(Адрес, КонтекстURL);
	РазделительQuery = Найти(Адрес, "?");
	БазаАдреса = Адрес;
	Query = "";
	Если РазделительQuery > 0 Тогда
		БазаАдреса = Лев(Адрес, РазделительQuery - 1);
		Query = Сред(Адрес, РазделительQuery + 1);
	КонецЕсли;
	Сегменты = СтрРазделить(БазаАдреса, "/", Истина);
	Для Индекс = 3 По Сегменты.Количество() - 1 Цикл
		Если Лев(Сегменты[Индекс], 1) = ":" Тогда
			ИмяПеременной = Сред(Сегменты[Индекс], 2);
			Сегменты[Индекс] = КодироватьПараметрИмпорта(ТекстPostman("{{" + ИмяПеременной + "}}", КонтекстURL));
		КонецЕсли;
	КонецЦикла;
	БазаАдреса = СтрСоединить(Сегменты, "/");
	Если ЕстьПолеИмпорта(ОписаниеURL, "query") Тогда
		Query = ПарыPostman(ПолеИмпорта(ОписаниеURL, "query"), КонтекстURL, Истина);
	КонецЕсли;
	Возврат ДобавитьQueryИмпорта(БазаАдреса, Query);

КонецФункции

Функция СведенияПараметровPostman(ОписаниеURL, Контекст, Данные)

	Если Не ЭтоОбъектИмпорта(ОписаниеURL) Или Не ЕстьПолеИмпорта(ОписаниеURL, "query") Тогда
		Возврат Неопределено;
	КонецЕсли;
	КонтекстURL = КонтекстPostman(ОписаниеURL, Контекст);
	Результат = Новый Массив;
	Для Каждого Пара Из ПолеИмпорта(ОписаниеURL, "query") Цикл
		Используется = Не ПолеИмпорта(Пара, "disabled", Ложь);
		Имя = ТекстПараметраPostman(ПолеИмпорта(Пара, "key", ""), КонтекстURL, Используется);
		ЗначениеПараметра = ТекстПараметраPostman(ПолеИмпорта(Пара, "value", ""), КонтекстURL, Используется);
		ЗакодированнаяПара = URLЗначениеPostman(Имя) + "=" + URLЗначениеPostman(ЗначениеПараметра);
		Если Используется И Данные.СпособАвторизации = "APIKey"
			И Данные.РасположениеКлюча = "ПараметрURL" Тогда
			ДекодированноеИмя = РаскодироватьСтроку(СтрЗаменить(URLЗначениеPostman(Имя), "+", "%20"),
				СпособКодированияСтроки.КодировкаURL);
			Если ДекодированноеИмя = Данные.ИмяКлюча Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		НеразрешенныйШаблон = Найти(Имя, "{{") > 0 Или Найти(ЗначениеПараметра, "{{") > 0;
		Результат.Добавить(Новый Структура("Пара,Используется,НеразрешенныйШаблон",
			ЗакодированнаяПара, Используется, НеразрешенныйШаблон));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ТекстПараметраPostman(ЗначениеПоля, Контекст, Используется)

	Если Используется Тогда
		Возврат ТекстPostman(ЗначениеПоля, Контекст);
	КонецЕсли;
	Остаток = ТекстЗначенияPostman(ЗначениеПоля);
	Результат = "";
	Пока Найти(Остаток, "{{") > 0 Цикл
		Начало = Найти(Остаток, "{{");
		Результат = Результат + Лев(Остаток, Начало - 1);
		Остаток = Сред(Остаток, Начало);
		Конец = Найти(Остаток, "}}");
		Если Конец = 0 Тогда
			Прервать;
		КонецЕсли;
		Шаблон = Лев(Остаток, Конец + 1);
		Попытка
			Подстановка = ТекстPostman(Шаблон, Контекст);
		Исключение
			Подстановка = Шаблон;
		КонецПопытки;
		Результат = Результат + Подстановка;
		Остаток = Сред(Остаток, Конец + 2);
	КонецЦикла;
	Возврат Результат + Остаток;

КонецФункции

Функция ПарыPostman(Пары, Контекст, СохранитьКодирование = Ложь)

	Если ТипЗнч(Пары) <> Тип("Массив") Тогда
		ВызватьИсключение "Список параметров Postman должен быть массивом.";
	КонецЕсли;
	Строки = Новый Массив;
	Для Каждого Пара Из Пары Цикл
		Если ПолеИмпорта(Пара, "disabled", Ложь) Тогда
			Продолжить;
		КонецЕсли;
		Имя = ТекстPostman(ПолеИмпорта(Пара, "key", ""), Контекст);
		ЗначениеПары = ТекстPostman(ПолеИмпорта(Пара, "value", ""), Контекст);
		Если СохранитьКодирование Тогда
			Строки.Добавить(URLЗначениеPostman(Имя) + "=" + URLЗначениеPostman(ЗначениеПары));
		Иначе
			Строки.Добавить(QueryИмпорта(Имя, ЗначениеПары));
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Строки, "&");

КонецФункции

// Кодирование query выполняется так же, как в клиентском конструкторе параметров.
Функция КодироватьПараметрИмпорта(Текст)

	Результат = "";
	Позиция = 1;
	БезКодирования = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-._~";
	Пока Позиция <= СтрДлина(Текст) Цикл
		Знак = Сред(Текст, Позиция, 1);
		Код = КодСимвола(Текст, Позиция);
		Если Код >= 55296 И Код <= 56319 И Позиция < СтрДлина(Текст) Тогда
			Младший = КодСимвола(Текст, Позиция + 1);
			Если Младший >= 56320 И Младший <= 57343 Тогда
				Код = 65536 + (Код - 55296) * 1024 + Младший - 56320;
				Позиция = Позиция + 1;
			КонецЕсли;
		КонецЕсли;
		Если Найти(БезКодирования, Знак) > 0 Тогда
			Результат = Результат + Знак;
		ИначеЕсли Код < 128 Тогда
			Результат = Результат + ПроцентныйБайтИмпорта(Код);
		ИначеЕсли Код < 2048 Тогда
			Результат = Результат + ПроцентныйБайтИмпорта(192 + Цел(Код / 64))
				+ ПроцентныйБайтИмпорта(128 + Код % 64);
		ИначеЕсли Код >= 55296 И Код <= 57343 Тогда
			ВызватьИсключение "Некорректный символ Unicode в параметре URL.";
		ИначеЕсли Код < 65536 Тогда
			Результат = Результат + ПроцентныйБайтИмпорта(224 + Цел(Код / 4096))
				+ ПроцентныйБайтИмпорта(128 + Цел(Код / 64) % 64) + ПроцентныйБайтИмпорта(128 + Код % 64);
		Иначе
			Результат = Результат + ПроцентныйБайтИмпорта(240 + Цел(Код / 262144))
				+ ПроцентныйБайтИмпорта(128 + Цел(Код / 4096) % 64)
				+ ПроцентныйБайтИмпорта(128 + Цел(Код / 64) % 64) + ПроцентныйБайтИмпорта(128 + Код % 64);
		КонецЕсли;
		Позиция = Позиция + 1;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПроцентныйБайтИмпорта(Код)

	Цифры = "0123456789ABCDEF";
	Возврат "%" + Сред(Цифры, Цел(Код / 16) + 1, 1) + Сред(Цифры, Код % 16 + 1, 1);

КонецФункции

Функция URLЗначениеPostman(Текст)

	Результат = КодироватьПараметрИмпорта(Текст);
	Позиция = 1;
	Пока Позиция <= СтрДлина(Текст) - 2 Цикл
		Если Сред(Текст, Позиция, 1) = "%" Тогда
			Код = Сред(Текст, Позиция + 1, 2);
			Если Найти("0123456789abcdefABCDEF", Лев(Код, 1)) > 0
				И Найти("0123456789abcdefABCDEF", Прав(Код, 1)) > 0 Тогда
				Результат = СтрЗаменить(Результат, "%25" + Код, "%" + Код);
			КонецЕсли;
		КонецЕсли;
		Позиция = Позиция + 1;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Процедура ЗаголовкиPostman(Данные, Заголовки, Контекст)

	Если ТипЗнч(Заголовки) = Тип("Строка") Тогда
		Для Каждого СтрокаЗаголовка Из СтрРазделить(СтрЗаменить(Заголовки, Символы.ВК, ""), Символы.ПС) Цикл
			Если Не ПустаяСтрока(СтрокаЗаголовка) Тогда
				СтрокаЗаголовкаИмпорта(Данные, ТекстPostman(СтрокаЗаголовка, Контекст));
			КонецЕсли;
		КонецЦикла;
		Возврат;
	КонецЕсли;
	Если ТипЗнч(Заголовки) <> Тип("Массив") Тогда
		ВызватьИсключение "Некорректные заголовки Postman.";
	КонецЕсли;
	Для Каждого Заголовок Из Заголовки Цикл
		Если Не ПолеИмпорта(Заголовок, "disabled", Ложь) Тогда
			ЗаголовокИмпорта(Данные, ТекстPostman(ПолеИмпорта(Заголовок, "key", ""), Контекст),
				ТекстPostman(ПолеИмпорта(Заголовок, "value", ""), Контекст));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ТелоPostman(Данные, Тело, Контекст)

	Если Тело = Неопределено Или ПолеИмпорта(Тело, "disabled", Ложь) Тогда
		Возврат;
	КонецЕсли;
	Режим = ПолеИмпорта(Тело, "mode", "");
	Если Режим = "raw" Тогда
		Данные.ТелоЗапроса = ТекстPostman(ПолеИмпорта(Тело, "raw", ""), Контекст);
		Опции = ПолеИмпорта(Тело, "options");
		ОпцииRaw = ПолеИмпорта(Опции, "raw");
		Язык = ПолеИмпорта(ОпцииRaw, "language", "");
		Типы = Новый Структура("json,xml,html,text,javascript",
			"application/json", "application/xml", "text/html", "text/plain", "application/javascript");
		ТипТела = "";
		Если СтрРазделить("json,xml,html,text,javascript", ",").Найти(Язык) <> Неопределено Тогда
			Типы.Свойство(Язык, ТипТела);
			ЗаголовокИмпорта(Данные, "Content-Type", ТипТела, Истина);
		КонецЕсли;
	ИначеЕсли Режим = "urlencoded" Тогда
		Данные.ТелоЗапроса = ПарыPostman(ПолеИмпорта(Тело, "urlencoded", Новый Массив), Контекст);
		ЗаголовокИмпорта(Данные, "Content-Type", "application/x-www-form-urlencoded", Истина);
	ИначеЕсли Режим <> "" Тогда
		ВызватьИсключение "Неподдерживаемый режим тела Postman: " + Режим;
	КонецЕсли;

КонецПроцедуры

Функция ЗначениеAuthPostman(Авторизация, Вид, Ключ, Контекст)

	ПараметрыAuth = ПолеИмпорта(Авторизация, Вид);
	ЗначениеAuth = "";
	Если ЭтоОбъектИмпорта(ПараметрыAuth) Тогда
		ЗначениеAuth = ПолеИмпорта(ПараметрыAuth, Ключ, "");
	ИначеЕсли ТипЗнч(ПараметрыAuth) = Тип("Массив") Тогда
		Найден = Ложь;
		Для Каждого Пара Из ПараметрыAuth Цикл
			Если ПолеИмпорта(Пара, "key", "") = Ключ Тогда
				Если Найден Тогда
					ВызватьИсключение "Повторный параметр авторизации Postman.";
				КонецЕсли;
				ЗначениеAuth = ПолеИмпорта(Пара, "value", "");
				Найден = Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат ТекстPostman(ЗначениеAuth, Контекст);

КонецФункции

Процедура АвторизацияPostman(Данные, Контекст)

	Авторизация = Контекст.Авторизация;
	Если Авторизация = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Вид = ПолеИмпорта(Авторизация, "type", "");
	Если Вид = "noauth" Тогда
		Возврат;
	ИначеЕсли Вид = "basic" Тогда
		Данные.СпособАвторизации = "Basic";
		Данные.Логин = ЗначениеAuthPostman(Авторизация, Вид, "username", Контекст);
		Данные.Пароль = ЗначениеAuthPostman(Авторизация, Вид, "password", Контекст);
	ИначеЕсли Вид = "bearer" Тогда
		Данные.СпособАвторизации = "Bearer";
		Данные.ТокенBearer = ЗначениеAuthPostman(Авторизация, Вид, "token", Контекст);
	ИначеЕсли Вид = "apikey" Тогда
		Данные.СпособАвторизации = "APIKey";
		Данные.ИмяКлюча = ЗначениеAuthPostman(Авторизация, Вид, "key", Контекст);
		Данные.ЗначениеКлюча = ЗначениеAuthPostman(Авторизация, Вид, "value", Контекст);
		Расположение = ЗначениеAuthPostman(Авторизация, Вид, "in", Контекст);
		Если Данные.ИмяКлюча = "" Тогда
			ВызватьИсключение "Не задано имя API key Postman.";
		КонецЕсли;
		Если Расположение = "header" Тогда
			Данные.РасположениеКлюча = "Заголовок";
			Индекс = ИндексЗаголовкаИмпорта(Данные, Данные.ИмяКлюча);
			Если Индекс >= 0 Тогда
				Если Данные.ЗаголовкиЗапроса[Индекс].Значение <> Данные.ЗначениеКлюча Тогда
					ВызватьИсключение "Конфликт материализованного API key в заголовке.";
				КонецЕсли;
				Данные.ЗаголовкиЗапроса.Удалить(Индекс);
			КонецЕсли;
		ИначеЕсли Расположение = "query" Тогда
			Данные.РасположениеКлюча = "ПараметрURL";
			УбратьКлючQueryPostman(Данные);
		Иначе
			ВызватьИсключение "API key Postman должен находиться в header или query.";
		КонецЕсли;
	Иначе
		ВызватьИсключение "Неподдерживаемая авторизация Postman: " + Вид;
	КонецЕсли;

КонецПроцедуры

Процедура УбратьКлючQueryPostman(Данные)

	Начало = Найти(Данные.Адрес, "?");
	Если Начало = 0 Тогда
		Возврат;
	КонецЕсли;
	База = Лев(Данные.Адрес, Начало - 1);
	Пары = СтрРазделить(Сред(Данные.Адрес, Начало + 1), "&");
	Остальные = Новый Массив;
	Для Каждого Пара Из Пары Цикл
		Равно = Найти(Пара, "=");
		Имя = Пара;
		ЗначениеПары = "";
		Если Равно > 0 Тогда
			Имя = Лев(Пара, Равно - 1);
			ЗначениеПары = Сред(Пара, Равно + 1);
		КонецЕсли;
		Имя = РаскодироватьСтроку(Имя, СпособКодированияСтроки.КодировкаURL);
		Если Имя = Данные.ИмяКлюча Тогда
			ЗначениеПары = РаскодироватьСтроку(СтрЗаменить(ЗначениеПары, "+", "%20"),
				СпособКодированияСтроки.КодировкаURL);
			Если ЗначениеПары <> Данные.ЗначениеКлюча Тогда
				ВызватьИсключение "Конфликт материализованного API key в query.";
			КонецЕсли;
		Иначе
			Остальные.Добавить(Пара);
		КонецЕсли;
	КонецЦикла;
	Данные.Адрес = ДобавитьQueryИмпорта(База, СтрСоединить(Остальные, "&"));

КонецПроцедуры

#КонецОбласти

#КонецЕсли
