&НаКлиенте
Перем ЧерновикиWorkSpace, АктивныйЧерновикWorkSpace, ТекущийЗапросWorkSpace;
&НаКлиенте
Перем ПутьОтображаемогоWorkSpace, ОбновлениеWorkSpace, ЗагрузкаWorkSpace;
&НаКлиенте
Перем ЧтениеДереваWorkSpace, ОткрытьПервыйПослеЧтенияWorkSpace;
&НаКлиенте
Перем ПодготовкаУзлаWorkSpace;
&НаКлиенте
Перем ПеретаскиваниеWorkSpace, ИмпортВыполняется;
&НаКлиенте
Перем ЗапросИзменен, ПодавлениеИзмененийЗапроса, ОжидаемыйПереходWorkSpace, СнимокТаблицЗапроса;

&НаКлиенте
Перем РедакторТелаАктивен, СеансРедактораТела, РевизияРедактораТела, РевизияТекстаРедактора;
&НаКлиенте
Перем ОжиданиеРедактораТела, ПопыткиРедактораТела, ДоступностьРедактораТела;

&НаКлиенте
Перем HTTPЗапросВыполняется, ФормаHTTPЗакрыта, ПричинаКлиентскогоHTTP;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	СброситьВсеНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ПодготовкаУзлаWorkSpace = Неопределено;
	ЧтениеДереваWorkSpace = Неопределено;
	ОткрытьПервыйПослеЧтенияWorkSpace = Ложь;
	ИнициализироватьКлиентскийHTTP();
	ОбновитьВидимостьАвторизации();
	Элементы.СтраницаDoom.Видимость = Ложь;
	ЧерновикиWorkSpace = Новый Соответствие;
	АктивныйЧерновикWorkSpace = "";
	ТекущийЗапросWorkSpace = "";
	ПутьОтображаемогоWorkSpace = "";
	ОбновлениеWorkSpace = Ложь;
	ЗагрузкаWorkSpace = Ложь;
	ПеретаскиваниеWorkSpace = Ложь;
	ИмпортВыполняется = Ложь;
	ЗапросИзменен = Ложь;
	ПодавлениеИзмененийЗапроса = Ложь;
	ОжидаемыйПереходWorkSpace = Неопределено;
	СнимокТаблицЗапроса = ТекстТаблицЗапроса();
	ИнициализироватьРедакторТела();
	Элементы.ГруппаWorkSpace.Видимость = Ложь;
	Попытка
		ПутьWorkSpace = ПутьWorkSpaceИзНастроек(ИмяКомпьютера());
	Исключение
		СообщитьОФайле("Не удалось прочитать настройку WorkSpace: " + ОписаниеОшибки());
	КонецПопытки;
	ПеречитатьWorkSpace();
	Если Не ПустаяСтрока(ПутьWorkSpace) Тогда
		ОткрытьПервыйЗапросWorkSpace();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии()
	ЧтениеДереваWorkSpace = Неопределено;
	ОткрытьПервыйПослеЧтенияWorkSpace = Ложь;
	ЗавершитьКлиентскийHTTP();
	ЗакрытьРедакторТела();
	СкрытьСтраницуDoom();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СпособАвторизацииПриИзменении(Элемент)
	ОбновитьВидимостьАвторизации();
	ОбновитьПредпросмотрURL();
	ОтметитьИзменениеЗапроса();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовЗапроса

&НаКлиенте
Процедура ТелоЗапросаПриИзменении(Элемент)
	Если НРег(СокрЛП(ТелоЗапроса)) = "doom" Тогда
		ОткрытьСтраницуDoom();
	Иначе
		СкрытьСтраницуDoom();
	КонецЕсли;
	ОтметитьИзменениеЗапроса();
КонецПроцедуры

&НаКлиенте
Процедура АдресПриИзменении(Элемент)
	ЗаполнитьПараметрыИзАдресаURL();
	ОтметитьИзменениеЗапроса();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыЗаголовкиЗапроса

&НаКлиенте
Процедура ЗаголовкиЗапросаПриАктивизацииСтроки(Элемент)
	ОбновитьСписокЗначенийЗаголовка(Элемент, Элементы.ЗначениеЗаголовка);
КонецПроцедуры

&НаКлиенте
Процедура ИмяЗаголовкаПриИзменении(Элемент)
	ОбновитьСписокЗначенийЗаголовка(Элементы.ЗаголовкиЗапроса, Элементы.ЗначениеЗаголовка);
	ОтметитьИзменениеЗапроса();
КонецПроцедуры

&НаКлиенте
Процедура ЗначениеЗаголовкаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ОбновитьСписокЗначенийЗаголовка(Элементы.ЗаголовкиЗапроса, Элемент);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыЗаголовкиТокена

&НаКлиенте
Процедура ЗаголовкиТокенаПриАктивизацииСтроки(Элемент)
	ОбновитьСписокЗначенийЗаголовка(Элемент, Элементы.ЗначениеЗаголовкаТокена);
КонецПроцедуры

&НаКлиенте
Процедура ИмяЗаголовкаТокенаПриИзменении(Элемент)
	ОбновитьСписокЗначенийЗаголовка(Элементы.ЗаголовкиТокена, Элементы.ЗначениеЗаголовкаТокена);
	ОтметитьИзменениеЗапроса();
КонецПроцедуры

&НаКлиенте
Процедура ЗначениеЗаголовкаТокенаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ОбновитьСписокЗначенийЗаголовка(Элементы.ЗаголовкиТокена, Элемент);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДеревоJSON

&НаКлиенте
Процедура ПоискЗначенияJSONПриИзменении(Элемент)
	ПоследнийПоискJSON = "";
	Если ПустаяСтрока(СокрЛП(ПоискЗначенияJSON)) Тогда
		ОшибкаКонструктораJSON = "";
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ТипУзлаJSONПриИзменении(Элемент)
	ДеревоJSONПриАктивизацииСтроки(Элементы.ДеревоJSON);
	ОтметитьИзменениеЗапроса();
КонецПроцедуры

&НаКлиенте
Процедура ДеревоJSONПриАктивизацииСтроки(Элемент)
	БулевУзел = Элемент.ТекущиеДанные <> Неопределено
		И Элемент.ТекущиеДанные.Тип = "Булево";
	Элементы.ЗначениеУзлаJSON.РежимВыбораИзСписка = БулевУзел;
	Элементы.ЗначениеУзлаJSON.СписокВыбора.Очистить();
	Если БулевУзел Тогда
		Элементы.ЗначениеУзлаJSON.СписокВыбора.Добавить("true");
		Элементы.ЗначениеУзлаJSON.СписокВыбора.Добавить("false");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗначениеУзлаJSONНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ДеревоJSONПриАктивизацииСтроки(Элементы.ДеревоJSON);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОтправитьОбработка(Команда)
	Если HTTPЗапросВыполняется Тогда
		Возврат;
	КонецЕсли;
	Если Не ПодготовитьПараметрыURLКДействию() Тогда
		Возврат;
	КонецЕсли;
	Если Не ПолучитьАктуальноеТелоЗапроса() Тогда
		Возврат;
	КонецЕсли;
	ОчиститьОтвет();
	ИтоговыйАдрес = Адрес;
	ОтправленноеТело = ТелоЗапроса;
	Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаОтвет;
	Если ПустаяСтрока(СокрЛП(Адрес)) Тогда
		ОшибкаЗапроса = "Укажите URL запроса.";
		Возврат;
	КонецЕсли;

	Если ВРег(СокрЛП(Метод)) = "GET" И Не ПустаяСтрока(ТелоЗапроса) Тогда
		ОшибкаЗапроса = "Метод GET не передает тело. Удалите тело или выберите другой метод.";
		Возврат;
	КонецЕсли;

	Настройки = НастройкиОсновногоHTTP();
	НачатьHTTPВКонтексте(Настройки);
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьТокенОбработка(Команда)

	Если HTTPЗапросВыполняется Тогда

		Возврат;

	КонецЕсли;
	ТокенJWT = "";
	СостояниеТокена = "Токен не получен";
	ОчиститьОтвет();
	ИтоговыйАдрес = АдресТокена;
	ОтправленноеТело = ТелоТокена;
	Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаОтвет;
	Если ПустаяСтрока(СокрЛП(АдресТокена)) Тогда

		ОшибкаЗапроса = "Укажите URL получения токена.";
		Возврат;

	КонецЕсли;
	Настройки = НоваяНастройкаЗапроса(АдресТокена, МетодТокена, ТелоТокена, ЗаголовкиТокена);
	Настройки.ТаймаутСекунд = ТаймаутСекунд;
	Настройки.ЗапросТокена = Истина;
	Настройки.Вставить("ПутьТокена", ПутьТокена);
	Настройки.Вставить("КонтекстВыполнения", КонтекстВыполнения);
	НачатьHTTPВКонтексте(Настройки);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСправкуОбработка(Команда)
	Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаСправка;
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьУзелJSONОбработка(Команда)
	РодительJSON = Элементы.ДеревоJSON.ТекущиеДанные;
	Если РодительJSON = Неопределено Тогда
		ОшибкаКонструктораJSON = "Выберите в дереве объект или массив, внутрь которого нужно добавить узел.";
		Возврат;
	КонецЕсли;
	Если РодительJSON.Тип <> "Объект" И РодительJSON.Тип <> "Массив" Тогда
		ОшибкаКонструктораJSON = "Дочерний узел можно добавить только в объект или массив.";
		Возврат;
	КонецЕсли;
	Если РодительJSON.Уровень >= 10 Тогда
		ОшибкаКонструктораJSON = "Достигнута максимальная глубина JSON: 10 уровней.";
		Возврат;
	КонецЕсли;
	УзелJSON = РодительJSON.ПолучитьЭлементы().Добавить();
	УзелJSON.Тип = "Строка";
	УзелJSON.Уровень = РодительJSON.Уровень + 1;
	ОшибкаКонструктораJSON = "";
	ОтметитьИзменениеЗапроса();
КонецПроцедуры

&НаКлиенте
Процедура УдалитьУзелJSONОбработка(Команда)
	УзелJSON = Элементы.ДеревоJSON.ТекущиеДанные;
	Если УзелJSON = Неопределено Тогда
		ОшибкаКонструктораJSON = "Выберите узел для удаления.";
		Возврат;
	КонецЕсли;
	Если УзелJSON.Уровень = 1 Тогда
		ОшибкаКонструктораJSON = "Корневой объект или массив удалить нельзя. Измените его тип или удалите дочерние узлы.";
		Возврат;
	КонецЕсли;
	РодительJSON = УзелJSON.ПолучитьРодителя();
	РодительJSON.ПолучитьЭлементы().Удалить(УзелJSON);
	ОшибкаКонструктораJSON = "";
	ОтметитьИзменениеЗапроса();
КонецПроцедуры

&НаКлиенте
Процедура СвернутьВсеJSONОбработка(Команда)
	СвернутьПоддеревьяJSON(ДеревоJSON.ПолучитьЭлементы());
КонецПроцедуры

&НаКлиенте
Процедура РазвернутьВсеJSONОбработка(Команда)
	Для Каждого УзелJSON Из ДеревоJSON.ПолучитьЭлементы() Цикл
		Если УзелJSON.ПолучитьЭлементы().Количество() > 0 Тогда
			Элементы.ДеревоJSON.Развернуть(УзелJSON.ПолучитьИдентификатор(), Истина);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура НайтиДалееJSONОбработка(Команда)
	ИскомоеЗначение = НРег(СокрЛП(ПоискЗначенияJSON));
	Если ПустаяСтрока(ИскомоеЗначение) Тогда
		ПоследнийПоискJSON = "";
		ОшибкаКонструктораJSON = "";
		Возврат;
	КонецЕсли;

	Совпадения = НайтиЗначенияJSON(ДеревоJSON.ПолучитьЭлементы(), ИскомоеЗначение, Новый Массив);
	Если Совпадения.Количество() = 0 Тогда
		ПоследнийПоискJSON = "";
		ОшибкаКонструктораJSON = "Совпадений по значениям дерева JSON не найдено.";
		Возврат;
	КонецЕсли;

	НомерСовпадения = 0;
	Если ПоследнийПоискJSON = ИскомоеЗначение Тогда
		Для Индекс = 0 По Совпадения.Количество() - 1 Цикл
			Если Совпадения[Индекс].Идентификатор = Элементы.ДеревоJSON.ТекущаяСтрока Тогда
				НомерСовпадения = Индекс + 1;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если НомерСовпадения = Совпадения.Количество() Тогда
		НомерСовпадения = 0;
	КонецЕсли;

	Совпадение = Совпадения[НомерСовпадения];
	Для Каждого ИдентификаторПредка Из Совпадение.Предки Цикл
		Элементы.ДеревоJSON.Развернуть(ИдентификаторПредка);
	КонецЦикла;
	Элементы.ДеревоJSON.ТекущаяСтрока = Совпадение.Идентификатор;
	ПоследнийПоискJSON = ИскомоеЗначение;
	ОшибкаКонструктораJSON = СтрШаблон("Совпадение %1 из %2.", НомерСовпадения + 1, Совпадения.Количество());
КонецПроцедуры

&НаКлиенте
Процедура СформироватьJSONОбработка(Команда)
	Если Не ПолучитьАктуальноеТелоЗапроса() Тогда
		Возврат;
	КонецЕсли;
	РезультатJSON = СформироватьJSONНаСервере();
	Если Не ПустаяСтрока(РезультатJSON.Ошибка) Тогда
		ОшибкаКонструктораJSON = РезультатJSON.Ошибка;
		Возврат;
	КонецЕсли;

	Если ТелоЗапроса <> РезультатJSON.Тело Тогда
		ОтметитьИзменениеЗапроса();
	КонецЕсли;
	ТелоЗапроса = РезультатJSON.Тело;
	ЗаменитьТелоВРедакторе();
	СкрытьСтраницуDoom();
	ОшибкаКонструктораJSON = "JSON сформирован и перенесён в тело запроса.";
	Для Каждого СтрокаЗаголовка Из ЗаголовкиЗапроса Цикл
		Если НРег(СокрЛП(СтрокаЗаголовка.Имя)) = "content-type" Тогда
			Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаЗапрос;
			Возврат;
		КонецЕсли;
	КонецЦикла;
	ОтметитьИзменениеЗапроса();
	СтрокаЗаголовка = ЗаголовкиЗапроса.Добавить();
	СтрокаЗаголовка.Имя = "Content-Type";
	СтрокаЗаголовка.Значение = "application/json";
	Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаЗапрос;
КонецПроцедуры

&НаКлиенте
Процедура ПеренестиВКонструкторОбработка(Команда)
	Если Не ПолучитьАктуальноеТелоЗапроса() Тогда
		Возврат;
	КонецЕсли;
	ПрежнееДерево = ТекстДанныхДляСравнения(УзлыВМассив(ДеревоJSON.ПолучитьЭлементы()));
	РезультатПереноса = ПеренестиТелоВКонструкторНаСервере();
	Если Не ПустаяСтрока(РезультатПереноса.Ошибка) Тогда
		ОшибкаКонструктораJSON = РезультатПереноса.Ошибка;
	Иначе
		ОшибкаКонструктораJSON = "JSON из тела запроса перенесён в конструктор.";
	КонецЕсли;
	Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаКонструкторJSON;
	Если ПустаяСтрока(РезультатПереноса.Ошибка) Тогда
		Если ПрежнееДерево <> ТекстДанныхДляСравнения(УзлыВМассив(ДеревоJSON.ПолучитьЭлементы())) Тогда
			ОтметитьИзменениеЗапроса();
		КонецЕсли;
		СнимокТаблицЗапроса = ТекстТаблицЗапроса();
		РазвернутьВсеJSONОбработка(Неопределено);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СохранитьВФайлОбработка(Команда)
	Если Не ПодготовитьПараметрыURLКДействию() Тогда
		Возврат;
	КонецЕсли;
	Если Не ПолучитьАктуальноеТелоЗапроса() Тогда
		Возврат;
	КонецЕсли;
	Если ОжидаемыйПереходWorkSpace <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	Оповещение = Новый ОписаниеОповещения("ПослеПодтвержденияСохранения", ЭтаФорма);
	ПоказатьВопрос(Оповещение,
		"В файл будут записаны все вкладки, включая ответ, пароли, API-ключи и токены открытым текстом. Продолжить?",
		РежимДиалогаВопрос.ДаНет, 0, КодВозвратаДиалога.Нет,
		"Сохранение PostMegaMan");
КонецПроцедуры

&НаКлиенте
Процедура ПослеПодтвержденияСохранения(Ответ, ДополнительныеПараметры) Экспорт
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	Если Не ПолучитьАктуальноеТелоЗапроса() Тогда
		Возврат;
	КонецЕсли;
	АдресХранения = "";
	Попытка
		ИмяСтраницы = АктивнаяВкладкаДляСохранения();
		Если Не ПустаяСтрока(ПутьWorkSpace) Тогда
			СохранитьЗапросWorkSpace(ИмяСтраницы);
			Возврат;
		КонецЕсли;
		АдресХранения = ПодготовитьФайлНастроекНаСервере(ИмяСтраницы);
		Файлы = Новый Массив;
		Файлы.Добавить(Новый ОписаниеПередаваемогоФайла("PostMegaMan.json", АдресХранения));
		Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
		Диалог.Фильтр = "Файлы JSON (*.json)|*.json";
		Диалог.ПолноеИмяФайла = "PostMegaMan.json";
		Диалог.Заголовок = "Сохранить состояние PostMegaMan";
		Оповещение = Новый ОписаниеОповещения("ПослеСохраненияФайла", ЭтаФорма, АдресХранения);
		НачатьПолучениеФайлов(Оповещение, Файлы, Диалог, Истина);
	Исключение
		Если Не ПустаяСтрока(АдресХранения) Тогда
			УдалитьПодготовленныйФайлНаСервере(АдресХранения);
		КонецЕсли;
		СообщитьОФайле("Не удалось сохранить файл: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ПослеСохраненияФайла(ПолученныеФайлы, АдресХранения) Экспорт
	УдалитьПодготовленныйФайлНаСервере(АдресХранения);
	Если ПолученныеФайлы <> Неопределено
		И ПолученныеФайлы.Количество() > 0 Тогда
		ЗапросИзменен = Ложь;
		СообщитьОФайле("Состояние PostMegaMan сохранено в файл.");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзФайлаОбработка(Команда)
	Попытка
		Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
		Диалог.Фильтр = "Файлы JSON (*.json)|*.json";
		Диалог.Заголовок = "Загрузить состояние PostMegaMan";
		Оповещение = Новый ОписаниеОповещения("ПослеВыбораФайлаНастроек", ЭтаФорма);
		НачатьПомещениеФайлов(Оповещение, Диалог, Истина, УникальныйИдентификатор);
	Исключение
		СообщитьОФайле("Не удалось выбрать файл: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораФайлаНастроек(ПомещенныеФайлы, ДополнительныеПараметры) Экспорт
	Если ПомещенныеФайлы = Неопределено
		Или ПомещенныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Попытка
		РезультатЗагрузки = ЗагрузитьСостояниеНаСервере(ПомещенныеФайлы[0].Хранение);
	Исключение
		СообщитьОФайле("Не удалось загрузить файл: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	Если Не ПустаяСтрока(РезультатЗагрузки.Ошибка) Тогда
		СообщитьОФайле("Файл не загружен: " + РезультатЗагрузки.Ошибка);
		Возврат;
	КонецЕсли;
	ПрименитьРезультатЗагрузки(РезультатЗагрузки);
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьВсеОбработка(Команда)
	Если Не ПодавлениеИзмененийЗапроса И Не ПолучитьАктуальноеТелоЗапроса() Тогда
		Возврат;
	КонецЕсли;
	ПрежниеПараметры = ТекстПараметровЗапроса();
	СкрытьСтраницуDoom();
	СброситьВсеНаСервере();
	ЗаменитьТелоВРедакторе();
	ОбновитьВидимостьАвторизации();
	Элементы.ЗначениеЗаголовка.СписокВыбора.Очистить();
	Элементы.ЗначениеЗаголовкаТокена.СписокВыбора.Очистить();
	Элементы.ЗначениеУзлаJSON.РежимВыбораИзСписка = Ложь;
	Элементы.ЗначениеУзлаJSON.СписокВыбора.Очистить();
	Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаЗапрос;
	Если ПрежниеПараметры <> ТекстПараметровЗапроса() Тогда
		ОтметитьИзменениеЗапроса();
	КонецЕсли;
	СнимокТаблицЗапроса = ТекстТаблицЗапроса();
	ОбновитьКомандыWorkSpace();
КонецПроцедуры

&НаКлиенте
Процедура ПерейтиНаСтраницу(ИмяСтраницы)
	Если ИмяСтраницы = "СтраницаПараметры" Тогда
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаПараметры;
	ИначеЕсли ИмяСтраницы = "СтраницаКонструкторJSON" Тогда
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаКонструкторJSON;
	ИначеЕсли ИмяСтраницы = "СтраницаАвторизация" Тогда
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаАвторизация;
	ИначеЕсли ИмяСтраницы = "СтраницаОтвет" Тогда
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаОтвет;
	ИначеЕсли ИмяСтраницы = "СтраницаСправка" Тогда
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаСправка;
	Иначе
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаЗапрос;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСтраницуDoom()
	Попытка
		Если ПустаяСтрока(ТекстDoom) Тогда
			ТекстDoom = ПолучитьHTMLDoomНаСервере();
		КонецЕсли;
	Исключение
		ТекстDoom = "<html><body><p>Не удалось загрузить игру. HTTP-инструмент доступен на других вкладках.</p></body></html>";
	КонецПопытки;
	Элементы.СтраницаDoom.Видимость = Истина;
	Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаDoom;
КонецПроцедуры

&НаСервере
Функция ПолучитьHTMLDoomНаСервере()
	Обработка = РеквизитФормыВЗначение("Объект");
	Возврат Обработка.ПолучитьМакет("DoomHTML").ПолучитьТекст();
КонецФункции

&НаКлиенте
Процедура СкрытьСтраницуDoom()
	Если Не ПустаяСтрока(ТекстDoom) Тогда
		Попытка
			Элементы.HTMLDoom.Документ.defaultView.postMegaManStopDoom();
		Исключение
			// Если HTML-движок не открывает окно через DOM, остановку выполнит обработчик выгрузки документа.
			ТекстDoom = "";
		КонецПопытки;
	КонецЕсли;
	Если Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаDoom Тогда
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаЗапрос;
	КонецЕсли;
	Элементы.СтраницаDoom.Видимость = Ложь;
	ТекстDoom = "";
КонецПроцедуры

&НаКлиенте
Процедура СообщитьОФайле(ТекстСообщения)
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстСообщения;
	Сообщение.Сообщить();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Функция НайтиЗначенияJSON(УзлыJSON, ИскомоеЗначение, Предки)
	Совпадения = Новый Массив;
	Для Каждого УзелJSON Из УзлыJSON Цикл
		Если Найти(НРег(УзелJSON.Значение), ИскомоеЗначение) > 0 Тогда
			Совпадения.Добавить(Новый Структура("Идентификатор,Предки",
				УзелJSON.ПолучитьИдентификатор(), Предки));
		КонецЕсли;

		ПредкиУзла = Новый Массив;
		Для Каждого ИдентификаторПредка Из Предки Цикл
			ПредкиУзла.Добавить(ИдентификаторПредка);
		КонецЦикла;
		ПредкиУзла.Добавить(УзелJSON.ПолучитьИдентификатор());
		ВложенныеСовпадения = НайтиЗначенияJSON(УзелJSON.ПолучитьЭлементы(), ИскомоеЗначение, ПредкиУзла);
		Для Каждого Совпадение Из ВложенныеСовпадения Цикл
			Совпадения.Добавить(Совпадение);
		КонецЦикла;
	КонецЦикла;
	Возврат Совпадения;
КонецФункции

&НаКлиенте
Процедура СвернутьПоддеревьяJSON(УзлыJSON)
	Для Каждого УзелJSON Из УзлыJSON Цикл
		ДочерниеУзлы = УзелJSON.ПолучитьЭлементы();
		Если ДочерниеУзлы.Количество() > 0 Тогда
			СвернутьПоддеревьяJSON(ДочерниеУзлы);
			Элементы.ДеревоJSON.Свернуть(УзелJSON.ПолучитьИдентификатор());
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Функция ПеренестиТелоВКонструкторНаСервере()
	РезультатПереноса = Новый Структура("Ошибка", "");
	Если ПустаяСтрока(СокрЛП(ТелоЗапроса)) Тогда
		РезультатПереноса.Ошибка = "Тело запроса пустое. Введите JSON-объект или JSON-массив.";
		Возврат РезультатПереноса;
	КонецЕсли;
	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоЗапроса);
		Если Не ЧтениеJSON.Прочитать() Тогда
			РезультатПереноса.Ошибка = "Тело запроса пустое. Введите JSON-объект или JSON-массив.";
			Возврат РезультатПереноса;
		КонецЕсли;
		Если ЧтениеJSON.ТипТекущегоЗначения <> ТипЗначенияJSON.НачалоОбъекта
			И ЧтениеJSON.ТипТекущегоЗначения <> ТипЗначенияJSON.НачалоМассива Тогда
			РезультатПереноса.Ошибка = "Корень JSON должен быть объектом или массивом.";
			Возврат РезультатПереноса;
		КонецЕсли;
		НовоеДерево = Новый ДеревоЗначений;
		НовоеДерево.Колонки.Добавить("Имя");
		НовоеДерево.Колонки.Добавить("Тип");
		НовоеДерево.Колонки.Добавить("Значение");
		НовоеДерево.Колонки.Добавить("Уровень");
		РезультатПереноса.Ошибка = ЗаполнитьТекущийУзелJSON(ЧтениеJSON, НовоеДерево.Строки, "", 1, "$");
		Если ПустаяСтрока(РезультатПереноса.Ошибка) И ЧтениеJSON.Прочитать() Тогда
			РезультатПереноса.Ошибка = "После корневого JSON-объекта или массива есть лишние данные.";
		КонецЕсли;
		ЧтениеJSON.Закрыть();
	Исключение
		РезультатПереноса.Ошибка = "Тело запроса не является корректным JSON.";
		Возврат РезультатПереноса;
	КонецПопытки;
	Если Не ПустаяСтрока(РезультатПереноса.Ошибка) Тогда
		Возврат РезультатПереноса;
	КонецЕсли;
	ЗначениеВРеквизитФормы(НовоеДерево, "ДеревоJSON");
	Возврат РезультатПереноса;
КонецФункции

&НаСервереБезКонтекста
Функция ЗаполнитьТекущийУзелJSON(ЧтениеJSON, СтрокиДерева, ИмяСвойства, УровеньJSON, ПутьJSON)
	Если УровеньJSON > 10 Тогда
		Возврат СтрШаблон("Узел %1 находится глубже 10-го уровня.", ПутьJSON);
	КонецЕсли;
	УзелJSON = СтрокиДерева.Добавить();
	УзелJSON.Имя = ИмяСвойства;
	УзелJSON.Уровень = УровеньJSON;
	ВидТокена = ЧтениеJSON.ТипТекущегоЗначения;
	Если ВидТокена = ТипЗначенияJSON.НачалоОбъекта Тогда
		УзелJSON.Тип = "Объект";
		ИменаСвойств = Новый Соответствие;
		Пока ЧтениеJSON.Прочитать() Цикл
			Если ЧтениеJSON.ТипТекущегоЗначения = ТипЗначенияJSON.КонецОбъекта Тогда
				Возврат "";
			КонецЕсли;
			Если ЧтениеJSON.ТипТекущегоЗначения <> ТипЗначенияJSON.ИмяСвойства Тогда
				Возврат СтрШаблон("Узел %1: ожидалось имя свойства объекта.", ПутьJSON);
			КонецЕсли;
			ИмяДочернегоСвойства = ЧтениеJSON.ТекущееЗначение;
			Если ПустаяСтрока(СокрЛП(ИмяДочернегоСвойства)) Тогда
				Возврат СтрШаблон("У объекта %1 есть свойство без имени.", ПутьJSON);
			КонецЕсли;
			Если ИменаСвойств.Получить(ИмяДочернегоСвойства) <> Неопределено Тогда
				Возврат СтрШаблон("В объекте %1 повторяется имя свойства «%2».", ПутьJSON, ИмяДочернегоСвойства);
			КонецЕсли;
			ИменаСвойств.Вставить(ИмяДочернегоСвойства, Истина);
			Если Не ЧтениеJSON.Прочитать() Тогда
				Возврат СтрШаблон("У свойства %1 отсутствует значение.", ИмяДочернегоСвойства);
			КонецЕсли;
			ОшибкаУзла = ЗаполнитьТекущийУзелJSON(ЧтениеJSON, УзелJSON.Строки,
				ИмяДочернегоСвойства, УровеньJSON + 1, ПутьJSON + "." + ИмяДочернегоСвойства);
			Если Не ПустаяСтрока(ОшибкаУзла) Тогда
				Возврат ОшибкаУзла;
			КонецЕсли;
		КонецЦикла;
		Возврат СтрШаблон("Объект %1 не закрыт.", ПутьJSON);
	ИначеЕсли ВидТокена = ТипЗначенияJSON.НачалоМассива Тогда
		УзелJSON.Тип = "Массив";
		ИндексУзла = 0;
		Пока ЧтениеJSON.Прочитать() Цикл
			Если ЧтениеJSON.ТипТекущегоЗначения = ТипЗначенияJSON.КонецМассива Тогда
				Возврат "";
			КонецЕсли;
			ОшибкаУзла = ЗаполнитьТекущийУзелJSON(ЧтениеJSON, УзелJSON.Строки, "",
				УровеньJSON + 1, СтрШаблон("%1[%2]", ПутьJSON, ИндексУзла));
			Если Не ПустаяСтрока(ОшибкаУзла) Тогда
				Возврат ОшибкаУзла;
			КонецЕсли;
			ИндексУзла = ИндексУзла + 1;
		КонецЦикла;
		Возврат СтрШаблон("Массив %1 не закрыт.", ПутьJSON);
	ИначеЕсли ВидТокена = ТипЗначенияJSON.Строка Тогда
		УзелJSON.Тип = "Строка";
		УзелJSON.Значение = ЧтениеJSON.ТекущееЗначение;
	ИначеЕсли ВидТокена = ТипЗначенияJSON.Число Тогда
		УзелJSON.Тип = "Число";
		ПисательЧисла = Новый ЗаписьJSON;
		ПисательЧисла.УстановитьСтроку();
		ПисательЧисла.ЗаписатьЗначение(ЧтениеJSON.ТекущееЗначение);
		УзелJSON.Значение = ПисательЧисла.Закрыть();
	ИначеЕсли ВидТокена = ТипЗначенияJSON.Булево Тогда
		УзелJSON.Тип = "Булево";
		Если ЧтениеJSON.ТекущееЗначение Тогда
			УзелJSON.Значение = "true";
		Иначе
			УзелJSON.Значение = "false";
		КонецЕсли;
	ИначеЕсли ВидТокена = ТипЗначенияJSON.Null Тогда
		УзелJSON.Тип = "null";
	Иначе
		Возврат СтрШаблон("Узел %1 имеет неподдерживаемый тип JSON.", ПутьJSON);
	КонецЕсли;
	Возврат "";
КонецФункции

&НаСервере
Функция СформироватьJSONНаСервере()
	РезультатJSON = Новый Структура("Ошибка,Тело", "", "");
	КорниJSON = ДеревоJSON.ПолучитьЭлементы();
	Если КорниJSON.Количество() <> 1 Тогда
		РезультатJSON.Ошибка = "Конструктор должен содержать один корневой объект или массив.";
		Возврат РезультатJSON;
	КонецЕсли;
	КореньJSON = КорниJSON[0];
	Если КореньJSON.Тип <> "Объект" И КореньJSON.Тип <> "Массив" Тогда
		РезультатJSON.Ошибка = "Корень JSON должен иметь тип «Объект» или «Массив».";
		Возврат РезультатJSON;
	КонецЕсли;
	РезультатJSON.Ошибка = ПроверитьУзелJSON(КореньJSON, "$", 1);
	Если Не ПустаяСтрока(РезультатJSON.Ошибка) Тогда
		Возврат РезультатJSON;
	КонецЕсли;
	ПисательJSON = Новый ЗаписьJSON;
	ПараметрыФормированияJSON = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, Символы.Таб);
	ПисательJSON.УстановитьСтроку(ПараметрыФормированияJSON);
	ЗаписатьУзелJSON(ПисательJSON, КореньJSON);
	РезультатJSON.Тело = ПисательJSON.Закрыть();
	Возврат РезультатJSON;
КонецФункции

&НаСервереБезКонтекста
Функция ПроверитьУзелJSON(УзелJSON, ПутьJSON, УровеньJSON)
	Если УровеньJSON > 10 Тогда
		Возврат СтрШаблон("Узел %1 находится глубже 10-го уровня.", ПутьJSON);
	КонецЕсли;
	Если УзелJSON.Тип = "Объект" Тогда
		ИспользованныеИмена = Новый Соответствие;
		Для Каждого ДочернийУзел Из УзелJSON.ПолучитьЭлементы() Цикл
			ИмяСвойства = ДочернийУзел.Имя;
			Если ПустаяСтрока(СокрЛП(ИмяСвойства)) Тогда
				Возврат СтрШаблон("У объекта %1 есть свойство без имени.", ПутьJSON);
			КонецЕсли;
			Если ИспользованныеИмена.Получить(ИмяСвойства) <> Неопределено Тогда
				Возврат СтрШаблон("В объекте %1 повторяется имя свойства «%2».", ПутьJSON, ИмяСвойства);
			КонецЕсли;
			ИспользованныеИмена.Вставить(ИмяСвойства, Истина);
			ОшибкаУзла = ПроверитьУзелJSON(ДочернийУзел, ПутьJSON + "." + ИмяСвойства, УровеньJSON + 1);
			Если Не ПустаяСтрока(ОшибкаУзла) Тогда
				Возврат ОшибкаУзла;
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли УзелJSON.Тип = "Массив" Тогда
		ИндексУзла = 0;
		Для Каждого ДочернийУзел Из УзелJSON.ПолучитьЭлементы() Цикл
			ОшибкаУзла = ПроверитьУзелJSON(ДочернийУзел,
				СтрШаблон("%1[%2]", ПутьJSON, ИндексУзла), УровеньJSON + 1);
			Если Не ПустаяСтрока(ОшибкаУзла) Тогда
				Возврат ОшибкаУзла;
			КонецЕсли;
			ИндексУзла = ИндексУзла + 1;
		КонецЦикла;
	Иначе
		Если УзелJSON.ПолучитьЭлементы().Количество() > 0 Тогда
			Возврат СтрШаблон("Узел %1 имеет значение и не может содержать вложенные узлы.", ПутьJSON);
		КонецЕсли;
		Если УзелJSON.Тип = "Число" Тогда
			Если Не КорректноеЧислоJSON(УзелJSON.Значение) Тогда
				Возврат СтрШаблон("Узел %1: значение «%2» не является числом JSON.",
					ПутьJSON, УзелJSON.Значение);
			КонецЕсли;
			Попытка
				ЧтениеЧисла = Новый ЧтениеJSON;
				ЧтениеЧисла.УстановитьСтроку(СокрЛП(УзелJSON.Значение));
				ПрочитатьJSON(ЧтениеЧисла, Истина);
			Исключение
				Возврат СтрШаблон("Узел %1: число не поддерживается платформой 1С.", ПутьJSON);
			КонецПопытки;
		ИначеЕсли УзелJSON.Тип = "Булево" Тогда
			Если НРег(СокрЛП(УзелJSON.Значение)) <> "true"
				И НРег(СокрЛП(УзелJSON.Значение)) <> "false" Тогда
				Возврат СтрШаблон("Узел %1: выберите true или false.", ПутьJSON);
			КонецЕсли;
		ИначеЕсли УзелJSON.Тип <> "Строка" И УзелJSON.Тип <> "null" Тогда
			Возврат СтрШаблон("Узел %1: выберите тип JSON из списка.", ПутьJSON);
		КонецЕсли;
	КонецЕсли;
	Возврат "";
КонецФункции

&НаСервереБезКонтекста
Функция КорректноеЧислоJSON(ТекстЧисла)
	ТекстЧисла = СокрЛП(ТекстЧисла);
	ДлинаЧисла = СтрДлина(ТекстЧисла);
	Если ДлинаЧисла = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Позиция = 1;
	Если Сред(ТекстЧисла, Позиция, 1) = "-" Тогда
		Позиция = Позиция + 1;
	КонецЕсли;
	Если Позиция > ДлинаЧисла Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Сред(ТекстЧисла, Позиция, 1) = "0" Тогда
		Позиция = Позиция + 1;
	Иначе
		Если Найти("123456789", Сред(ТекстЧисла, Позиция, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
		Пока Позиция <= ДлинаЧисла И Найти("0123456789", Сред(ТекстЧисла, Позиция, 1)) > 0 Цикл
			Позиция = Позиция + 1;
		КонецЦикла;
	КонецЕсли;
	Если Позиция <= ДлинаЧисла И Сред(ТекстЧисла, Позиция, 1) = "." Тогда
		Позиция = Позиция + 1;
		НачалоДроби = Позиция;
		Пока Позиция <= ДлинаЧисла И Найти("0123456789", Сред(ТекстЧисла, Позиция, 1)) > 0 Цикл
			Позиция = Позиция + 1;
		КонецЦикла;
		Если Позиция = НачалоДроби Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	Если Позиция <= ДлинаЧисла И Найти("eE", Сред(ТекстЧисла, Позиция, 1)) > 0 Тогда
		Позиция = Позиция + 1;
		Если Позиция <= ДлинаЧисла И Найти("+-", Сред(ТекстЧисла, Позиция, 1)) > 0 Тогда
			Позиция = Позиция + 1;
		КонецЕсли;
		НачалоПорядка = Позиция;
		Пока Позиция <= ДлинаЧисла И Найти("0123456789", Сред(ТекстЧисла, Позиция, 1)) > 0 Цикл
			Позиция = Позиция + 1;
		КонецЦикла;
		Если Позиция = НачалоПорядка Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	Возврат Позиция > ДлинаЧисла;
КонецФункции

&НаСервереБезКонтекста
Процедура ЗаписатьУзелJSON(ПисательJSON, УзелJSON)
	Если УзелJSON.Тип = "Объект" Тогда
		ПисательJSON.ЗаписатьНачалоОбъекта();
		Для Каждого ДочернийУзел Из УзелJSON.ПолучитьЭлементы() Цикл
			ПисательJSON.ЗаписатьИмяСвойства(ДочернийУзел.Имя);
			ЗаписатьУзелJSON(ПисательJSON, ДочернийУзел);
		КонецЦикла;
		ПисательJSON.ЗаписатьКонецОбъекта();
	ИначеЕсли УзелJSON.Тип = "Массив" Тогда
		ПисательJSON.ЗаписатьНачалоМассива();
		Для Каждого ДочернийУзел Из УзелJSON.ПолучитьЭлементы() Цикл
			ЗаписатьУзелJSON(ПисательJSON, ДочернийУзел);
		КонецЦикла;
		ПисательJSON.ЗаписатьКонецМассива();
	ИначеЕсли УзелJSON.Тип = "Число" Тогда
		ЧтениеЧисла = Новый ЧтениеJSON;
		ЧтениеЧисла.УстановитьСтроку(СокрЛП(УзелJSON.Значение));
		ПисательJSON.ЗаписатьЗначение(ПрочитатьJSON(ЧтениеЧисла, Истина));
	ИначеЕсли УзелJSON.Тип = "Булево" Тогда
		ПисательJSON.ЗаписатьЗначение(НРег(СокрЛП(УзелJSON.Значение)) = "true");
	ИначеЕсли УзелJSON.Тип = "null" Тогда
		ПисательJSON.ЗаписатьЗначение(Неопределено);
	Иначе
		ПисательJSON.ЗаписатьЗначение(УзелJSON.Значение);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьВидимостьАвторизации()
	Элементы.ГруппаBasic.Видимость = (СпособАвторизации = "Basic");
	Элементы.ГруппаBearer.Видимость = (СпособАвторизации = "Bearer");
	Элементы.ГруппаAPIKey.Видимость = (СпособАвторизации = "APIKey");
	Элементы.ГруппаJWT.Видимость = (СпособАвторизации = "JWT");
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСписокЗначенийЗаголовка(ТаблицаЗаголовков, ПолеЗначения)
	ТекущаяСтрока = ТаблицаЗаголовков.ТекущиеДанные;
	ПолеЗначения.СписокВыбора.Очистить();
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Имя = НРег(СокрЛП(ТекущаяСтрока.Имя));
	Если Имя = "accept" Тогда
		ПолеЗначения.СписокВыбора.Добавить("application/json");
		ПолеЗначения.СписокВыбора.Добавить("text/plain");
		ПолеЗначения.СписокВыбора.Добавить("text/html");
		ПолеЗначения.СписокВыбора.Добавить("*/*");
	ИначеЕсли Имя = "content-type" Тогда
		ПолеЗначения.СписокВыбора.Добавить("application/json");
		ПолеЗначения.СписокВыбора.Добавить("application/json; charset=utf-8");
		ПолеЗначения.СписокВыбора.Добавить("application/x-www-form-urlencoded");
		ПолеЗначения.СписокВыбора.Добавить("text/plain; charset=utf-8");
	ИначеЕсли Имя = "authorization" Тогда
		ПолеЗначения.СписокВыбора.Добавить("Bearer ");
		ПолеЗначения.СписокВыбора.Добавить("Basic ");
	ИначеЕсли Имя = "user-agent" Тогда
		ПолеЗначения.СписокВыбора.Добавить("PostMegaMan/1.0");
		ПолеЗначения.СписокВыбора.Добавить("1C-Enterprise/8.3");
	ИначеЕсли Имя = "cache-control" Тогда
		ПолеЗначения.СписокВыбора.Добавить("no-cache");
		ПолеЗначения.СписокВыбора.Добавить("no-store");
		ПолеЗначения.СписокВыбора.Добавить("max-age=0");
	ИначеЕсли Имя = "accept-language" Тогда
		ПолеЗначения.СписокВыбора.Добавить("ru-RU");
		ПолеЗначения.СписокВыбора.Добавить("en-US");
		ПолеЗначения.СписокВыбора.Добавить("ru-RU,ru;q=0.9,en;q=0.8");
	ИначеЕсли Имя = "if-none-match" Тогда
		ПолеЗначения.СписокВыбора.Добавить("*");
		ПолеЗначения.СписокВыбора.Добавить("W/""etag""");
	ИначеЕсли Имя = "x-api-key" Тогда
		ПолеЗначения.СписокВыбора.Добавить("test-value");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьОтвет()
	КодОтвета = "";
	ВремяЗапросаМс = 0;
	ИзмереноВремяЗапроса = Ложь;
	ВремяЗапросаДляПоказа = "";
	ЗаголовкиОтвета = "";
	ТелоОтвета = "";
	ОшибкаЗапроса = "";
	ИтоговыйАдрес = "";
	ОтправленноеТело = "";
	ИтоговыеЗаголовкиЗапроса = "";
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьРезультат(Результат)
	ИзмереноВремяЗапроса = ТипЗнч(Результат.ВремяЗапросаМс) = Тип("Число");
	ВремяЗапросаМс = 0;
	Если ИзмереноВремяЗапроса Тогда
		ВремяЗапросаМс = Результат.ВремяЗапросаМс;
	КонецЕсли;
	ВремяЗапросаДляПоказа = ПредставлениеВремениЗапроса(Результат.ВремяЗапросаМс);
	Если Результат.Код > 0 Тогда
		КодОтвета = Строка(Результат.Код);
	КонецЕсли;
	ЗаголовкиОтвета = Результат.Заголовки;
	ТелоОтвета = ПодготовитьТелоОтветаДляПоказа(Результат.Тело);
	ОшибкаЗапроса = Результат.Ошибка;
	ИтоговыйАдрес = Результат.ИтоговыйАдрес;
	ИтоговыеЗаголовкиЗапроса = Результат.ЗаголовкиЗапроса;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПодготовитьТелоОтветаДляПоказа(ИсходноеТело)
	Если ПустаяСтрока(ИсходноеТело)
		Или Найти(ИсходноеТело, Символы.ПС) > 0
		Или Найти(ИсходноеТело, Символы.ВК) > 0 Тогда
		Возврат ИсходноеТело;
	КонецЕсли;

	ПервыйСимвол = Лев(СокрЛП(ИсходноеТело), 1);
	Если ПервыйСимвол <> "{" И ПервыйСимвол <> "[" Тогда
		Возврат ИсходноеТело;
	КонецЕсли;

	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(ИсходноеТело);
		ДанныеJSON = ПрочитатьJSON(Чтение, Истина);
		Если Чтение.Прочитать() Тогда
			Чтение.Закрыть();
			Возврат ИсходноеТело;
		КонецЕсли;
		Чтение.Закрыть();
		Если ТипЗнч(ДанныеJSON) <> Тип("Соответствие")
			И ТипЗнч(ДанныеJSON) <> Тип("Массив") Тогда
			Возврат ИсходноеТело;
		КонецЕсли;

		Возврат ФорматироватьПроверенныйJSON(ИсходноеТело);
	Исключение
		Возврат ИсходноеТело;
	КонецПопытки;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ФорматироватьПроверенныйJSON(ИсходноеТело)
	Фрагменты = Новый Массив;
	Отступ = "";
	ПоследнийЗначимыйСимвол = "";
	ВСтроке = Ложь;
	Экранирован = Ложь;
	Для Позиция = 1 По СтрДлина(ИсходноеТело) Цикл
		Символ = Сред(ИсходноеТело, Позиция, 1);
		Если ВСтроке Тогда
			Фрагменты.Добавить(Символ);
			Если Экранирован Тогда
				Экранирован = Ложь;
			ИначеЕсли Символ = "\" Тогда
				Экранирован = Истина;
			ИначеЕсли Символ = """" Тогда
				ВСтроке = Ложь;
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		Если Символ = """" Тогда
			ВСтроке = Истина;
			Фрагменты.Добавить(Символ);
		ИначеЕсли Символ = "{" Или Символ = "[" Тогда
			Фрагменты.Добавить(Символ);
			Отступ = Отступ + Символы.Таб;
			Фрагменты.Добавить(Символы.ПС);
			Фрагменты.Добавить(Отступ);
		ИначеЕсли Символ = "}" Или Символ = "]" Тогда
			Отступ = Лев(Отступ, СтрДлина(Отступ) - 1);
			Если ПоследнийЗначимыйСимвол = "{" Или ПоследнийЗначимыйСимвол = "[" Тогда
				Фрагменты.Удалить(Фрагменты.Количество() - 1);
			Иначе
				Фрагменты.Добавить(Символы.ПС);
				Фрагменты.Добавить(Отступ);
			КонецЕсли;
			Фрагменты.Добавить(Символ);
		ИначеЕсли Символ = "," Тогда
			Фрагменты.Добавить(Символ);
			Фрагменты.Добавить(Символы.ПС);
			Фрагменты.Добавить(Отступ);
		ИначеЕсли Символ = ":" Тогда
			Фрагменты.Добавить(": ");
		ИначеЕсли Символ = " " Или Символ = Символы.Таб Тогда
			Продолжить;
		Иначе
			Фрагменты.Добавить(Символ);
		КонецЕсли;
		ПоследнийЗначимыйСимвол = Символ;
	КонецЦикла;
	Возврат СтрСоединить(Фрагменты, "");
КонецФункции

&НаСервере
Функция ВыполнитьОсновнойЗапросНаСервере()
	Настройки = НоваяНастройкаЗапроса(Адрес, Метод, ТелоЗапроса, ЗаголовкиЗапроса);
	Настройки.СпособАвторизации = СпособАвторизации;
	Настройки.Логин = Логин;
	Настройки.Пароль = Пароль;
	Настройки.ТокенBearer = ТокенBearer;
	Настройки.ТокенJWT = ТокенJWT;
	Настройки.ИмяКлюча = ИмяКлюча;
	Настройки.ЗначениеКлюча = ЗначениеКлюча;
	Настройки.РасположениеКлюча = РасположениеКлюча;
	Настройки.ТаймаутСекунд = ТаймаутСекунд;
	Возврат ВыполнитьHTTPЗапрос(Настройки);
КонецФункции

&НаСервере
Функция ПолучитьТокенНаСервере()
	Настройки = НоваяНастройкаЗапроса(АдресТокена, МетодТокена, ТелоТокена, ЗаголовкиТокена);
	Настройки.ТаймаутСекунд = ТаймаутСекунд;
	Настройки.ЗапросТокена = Истина;
	Результат = ВыполнитьHTTPЗапрос(Настройки);
	Возврат ДополнитьРезультатТокеном(Результат, ПутьТокена);
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ДополнитьРезультатТокеном(Результат, ПутьИзОтвета)
	Результат.Вставить("Токен", "");
	Если Не ПустаяСтрока(Результат.Ошибка) Тогда
		Возврат Результат;
	КонецЕсли;
	Если Результат.Код < 200 Или Результат.Код >= 300 Тогда
		Результат.Ошибка = "Сервер токена вернул HTTP " + Строка(Результат.Код) + ".";
		Возврат Результат;
	КонецЕсли;
	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Результат.Тело);
		ДанныеТокена = ПрочитатьJSON(Чтение, Истина);
		Результат.Токен = ТокенПоПути(ДанныеТокена, ПутьИзОтвета);
	Исключение
		Результат.Ошибка = "Ответ сервера токена не является корректным JSON.";
	КонецПопытки;
	Если ПустаяСтрока(Результат.Токен) И ПустаяСтрока(Результат.Ошибка) Тогда
		Результат.Ошибка = "Строковый токен по указанному пути не найден.";
	КонецЕсли;
	Возврат Результат;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция НоваяНастройкаЗапроса(АдресЗапроса, МетодЗапроса, Тело, ТаблицаЗаголовков)
	Настройки = Новый Структура;
	Настройки.Вставить("Адрес", АдресЗапроса);
	Настройки.Вставить("Метод", МетодЗапроса);
	Настройки.Вставить("Тело", Тело);
	Настройки.Вставить("Заголовки", Новый Массив);
	Для Каждого СтрокаЗаголовка Из ТаблицаЗаголовков Цикл
		Настройки.Заголовки.Добавить(Новый Структура(
			"Имя,Значение", СтрокаЗаголовка.Имя, СтрокаЗаголовка.Значение));
	КонецЦикла;
	Настройки.Вставить("СпособАвторизации", "Нет");
	Настройки.Вставить("Логин", "");
	Настройки.Вставить("Пароль", "");
	Настройки.Вставить("ТокенBearer", "");
	Настройки.Вставить("ТокенJWT", "");
	Настройки.Вставить("ИмяКлюча", "");
	Настройки.Вставить("ЗначениеКлюча", "");
	Настройки.Вставить("РасположениеКлюча", "Заголовок");
	Настройки.Вставить("ТаймаутСекунд", 30);
	Настройки.Вставить("ЗапросТокена", Ложь);
	Возврат Настройки;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПодготовитьHTTPЗапрос(Настройки)
	Результат = Новый Структура("Код,Заголовки,Тело,Ошибка,ИтоговыйАдрес,ЗаголовкиЗапроса",
		0, "", "", "", Настройки.Адрес, "");
	Результат.Вставить("ВремяЗапросаМс", Неопределено);
	Подготовка = Новый Структура("Результат", Результат);
	МетодЗапроса = ВРег(СокрЛП(Настройки.Метод));
	Если Не ДопустимоеИмяHTTP(МетодЗапроса) Тогда
		Результат.Ошибка = "Укажите корректный HTTP-метод.";
		Возврат Подготовка;
	КонецЕсли;
	Если МетодЗапроса = "GET" И Не ПустаяСтрока(Настройки.Тело) Тогда
		Результат.Ошибка = "Метод GET не передает тело.";
		Возврат Подготовка;
	КонецЕсли;
	Если Настройки.ТаймаутСекунд < 1 Тогда
		Результат.Ошибка = "Таймаут должен быть больше нуля.";
		Возврат Подготовка;
	КонецЕсли;

	ЧастиАдреса = ПодготовитьАдресОтправкиURL(Настройки.Адрес, Настройки.СпособАвторизации,
		Настройки.РасположениеКлюча, Настройки.ИмяКлюча, Настройки.ЗначениеКлюча);
	Если Не ПустаяСтрока(ЧастиАдреса.Ошибка) Тогда
		Результат.Ошибка = ЧастиАдреса.Ошибка;
		Возврат Подготовка;
	КонецЕсли;
	Заголовки = Новый Соответствие;
	Для Каждого Заголовок Из Настройки.Заголовки Цикл
		Имя = СокрЛП(Заголовок.Имя);
		Если ПустаяСтрока(Имя) И ПустаяСтрока(Заголовок.Значение) Тогда
			Продолжить;
		КонецЕсли;
		Если Не ДопустимоеИмяHTTP(Имя)
			Или Найти(Заголовок.Значение, Символы.ПС) > 0
			Или Найти(Заголовок.Значение, Символы.ВК) > 0 Тогда
			Результат.Ошибка = "Некорректное имя или значение HTTP-заголовка.";
			Возврат Подготовка;
		КонецЕсли;
		Если ЕстьЗаголовок(Заголовки, Имя) Тогда
			Результат.Ошибка = "Повторяется HTTP-заголовок " + Имя + ".";
			Возврат Подготовка;
		КонецЕсли;
		Заголовки.Вставить(Имя, Заголовок.Значение);
	КонецЦикла;

	ЛогинСоединения = "";
	ПарольСоединения = "";
	Если Настройки.СпособАвторизации = "Basic" Тогда
		Если ЕстьЗаголовок(Заголовки, "Authorization") Тогда
			Результат.Ошибка = "Заголовок Authorization конфликтует с Basic.";
			Возврат Подготовка;
		КонецЕсли;
		ЛогинСоединения = Настройки.Логин;
		ПарольСоединения = Настройки.Пароль;
	ИначеЕсли Настройки.СпособАвторизации = "Bearer"
		Или Настройки.СпособАвторизации = "JWT" Тогда
		Если ЕстьЗаголовок(Заголовки, "Authorization") Тогда
			Результат.Ошибка = "Заголовок Authorization задан дважды.";
			Возврат Подготовка;
		КонецЕсли;
		Если Настройки.СпособАвторизации = "JWT" Тогда
			Токен = Настройки.ТокенJWT;
		Иначе
			Токен = Настройки.ТокенBearer;
		КонецЕсли;
		Если ПустаяСтрока(Токен)
			Или Найти(Токен, Символы.ПС) > 0
			Или Найти(Токен, Символы.ВК) > 0 Тогда
			Результат.Ошибка = "Укажите корректный токен авторизации.";
			Возврат Подготовка;
		КонецЕсли;
		Заголовки.Вставить("Authorization", "Bearer " + Токен);
	ИначеЕсли Настройки.СпособАвторизации = "APIKey" Тогда
		Если ПустаяСтрока(Настройки.ИмяКлюча) Или ПустаяСтрока(Настройки.ЗначениеКлюча) Тогда
			Результат.Ошибка = "Укажите имя и значение API key.";
			Возврат Подготовка;
		КонецЕсли;
		Если Настройки.РасположениеКлюча = "Заголовок" Тогда
			Если Не ДопустимоеИмяHTTP(Настройки.ИмяКлюча)
				Или ЕстьЗаголовок(Заголовки, Настройки.ИмяКлюча) Тогда
				Результат.Ошибка = "Имя API key некорректно или уже есть в заголовках.";
				Возврат Подготовка;
			КонецЕсли;
			Если Найти(Настройки.ЗначениеКлюча, Символы.ПС) > 0
				Или Найти(Настройки.ЗначениеКлюча, Символы.ВК) > 0 Тогда
				Результат.Ошибка = "Значение API key не должно содержать перевод строки.";
				Возврат Подготовка;
			КонецЕсли;
			Заголовки.Вставить(Настройки.ИмяКлюча, Настройки.ЗначениеКлюча);
		ИначеЕсли Настройки.РасположениеКлюча <> "ПараметрURL" Тогда
			Результат.Ошибка = "Неизвестное размещение API key.";
			Возврат Подготовка;
		КонецЕсли;
	ИначеЕсли Настройки.СпособАвторизации <> "Нет" Тогда
		Результат.Ошибка = "Неизвестный способ авторизации.";
		Возврат Подготовка;
	КонецЕсли;

	Если Не ПустаяСтрока(Настройки.Тело) И Не ЕстьЗаголовок(Заголовки, "Content-Type")
		И Настройки.ЗапросТокена Тогда
		Заголовки.Вставить("Content-Type", "application/json");
	КонецЕсли;
	Для Каждого ЗаголовокЗапроса Из Заголовки Цикл
		Результат.ЗаголовкиЗапроса = Результат.ЗаголовкиЗапроса
			+ ЗаголовокЗапроса.Ключ + ": " + ЗаголовокЗапроса.Значение + Символы.ПС;
	КонецЦикла;
	Если Настройки.СпособАвторизации = "Basic" Тогда
		Результат.ЗаголовкиЗапроса = Результат.ЗаголовкиЗапроса
			+ "Authorization: Basic [формируется платформой 1С]" + Символы.ПС;
	КонецЕсли;
	Если ЧастиАдреса.HTTPS Тогда
		Протокол = "https://";
	Иначе
		Протокол = "http://";
	КонецЕсли;
	Результат.ИтоговыйАдрес = Протокол + ЧастиАдреса.Узел + ЧастиАдреса.Ресурс;

	Подготовка.Вставить("ЧастиАдреса", ЧастиАдреса);
	Подготовка.Вставить("Заголовки", Заголовки);
	Подготовка.Вставить("ЛогинСоединения", ЛогинСоединения);
	Подготовка.Вставить("ПарольСоединения", ПарольСоединения);
	Подготовка.Вставить("МетодЗапроса", МетодЗапроса);
	Подготовка.Вставить("Тело", Настройки.Тело);
	Подготовка.Вставить("ТаймаутСекунд", Настройки.ТаймаутСекунд);
	Возврат Подготовка;
КонецФункции

&НаСервереБезКонтекста
Функция ВыполнитьПодготовленныйHTTPНаСервере(Подготовка)
	Результат = Подготовка.Результат;
	Если Не ПустаяСтрока(Результат.Ошибка) Тогда

		Возврат Результат;

	КонецЕсли;
	ЧастиАдреса = Подготовка.ЧастиАдреса;
	Заголовки = Подготовка.Заголовки;
	ЛогинСоединения = Подготовка.ЛогинСоединения;
	ПарольСоединения = Подготовка.ПарольСоединения;
	МетодЗапроса = Подготовка.МетодЗапроса;
	НачалоЗапросаМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Попытка
		Если ЧастиАдреса.HTTPS Тогда
			ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL;
		Иначе
			ЗащищенноеСоединение = Неопределено;
		КонецЕсли;
		Соединение = Новый HTTPСоединение(ЧастиАдреса.Сервер, ЧастиАдреса.Порт,
			ЛогинСоединения, ПарольСоединения, Неопределено,
			Подготовка.ТаймаутСекунд, ЗащищенноеСоединение);
		Запрос = Новый HTTPЗапрос(ЧастиАдреса.Ресурс, Заголовки);
		Если Не ПустаяСтрока(Подготовка.Тело) Тогда
			Запрос.УстановитьТелоИзСтроки(Подготовка.Тело, КодировкаТекста.UTF8);
		КонецЕсли;
		Ответ = Соединение.ВызватьHTTPМетод(МетодЗапроса, Запрос);
		Результат.Код = Ответ.КодСостояния;
		Для Каждого ЗаголовокОтвета Из Ответ.Заголовки Цикл
			Результат.Заголовки = Результат.Заголовки + ЗаголовокОтвета.Ключ
				+ ": " + ЗаголовокОтвета.Значение + Символы.ПС;
		КонецЦикла;
	Исключение
		Результат.Код = 0;
		Результат.Заголовки = "";
		Результат.Тело = "";
		Результат.Ошибка = "Ошибка HTTP-соединения или чтения ответа. Проверьте адрес, сертификат и сеть.";
		Результат.ВремяЗапросаМс = Макс(0, Цел(ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоЗапросаМс));
		Возврат Результат;
	КонецПопытки;
	Попытка
		Результат.Тело = Ответ.ПолучитьТелоКакСтроку();
	Исключение
		Результат.Тело = "[Тело ответа не удалось прочитать как текст.]";
	КонецПопытки;
	Результат.ВремяЗапросаМс = Макс(0, Цел(ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоЗапросаМс));
	Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция ВыполнитьHTTPЗапрос(Настройки)

	Подготовка = ПодготовитьHTTPЗапрос(Настройки);
	Возврат ВыполнитьПодготовленныйHTTPНаСервере(Подготовка);

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция РазобратьАдрес(АдресЗапроса)
	Результат = Новый Структура("Сервер,Порт,Ресурс,HTTPS,Ошибка,Узел", "", 0, "/", Ложь, "", "");
	АдресЗапроса = СокрЛП(АдресЗапроса);
	Если НРег(Лев(АдресЗапроса, 8)) = "https://" Тогда
		Результат.HTTPS = Истина;
		Остаток = Сред(АдресЗапроса, 9);
		Результат.Порт = 443;
	ИначеЕсли НРег(Лев(АдресЗапроса, 7)) = "http://" Тогда
		Остаток = Сред(АдресЗапроса, 8);
		Результат.Порт = 80;
	Иначе
		Результат.Ошибка = "URL должен начинаться с http:// или https://.";
		Возврат Результат;
	КонецЕсли;
	Если Найти(Остаток, "#") > 0 Тогда
		Результат.Ошибка = "URL не должен содержать фрагмент.";
		Возврат Результат;
	КонецЕсли;
	ПозицияПути = Найти(Остаток, "/");
	ПозицияЗапроса = Найти(Остаток, "?");
	Если ПозицияПути = 0 Или (ПозицияЗапроса > 0 И ПозицияЗапроса < ПозицияПути) Тогда
		ПозицияПути = ПозицияЗапроса;
	КонецЕсли;
	Если ПозицияПути = 0 Тогда
		Узел = Остаток;
	Иначе
		Узел = Лев(Остаток, ПозицияПути - 1);
		Результат.Ресурс = Сред(Остаток, ПозицияПути);
		Если Лев(Результат.Ресурс, 1) = "?" Тогда
			Результат.Ресурс = "/" + Результат.Ресурс;
		КонецЕсли;
	КонецЕсли;
	Если ПустаяСтрока(Узел) Или Найти(Узел, " ") > 0 Или Найти(Узел, "@") > 0 Тогда
		Результат.Ошибка = "В URL не указан корректный сервер.";
		Возврат Результат;
	КонецЕсли;
	Результат.Узел = Узел;
	Если Лев(Узел, 1) = "[" Тогда
		КонецАдреса = Найти(Узел, "]");
		Если КонецАдреса = 0 Тогда
			Результат.Ошибка = "Некорректный IPv6-адрес сервера.";
			Возврат Результат;
		КонецЕсли;
		Результат.Сервер = Сред(Узел, 2, КонецАдреса - 2);
		ХвостУзла = Сред(Узел, КонецАдреса + 1);
		Если Не ПустаяСтрока(ХвостУзла) Тогда
			Если Лев(ХвостУзла, 1) <> ":" Тогда
				Результат.Ошибка = "Некорректный порт в URL.";
				Возврат Результат;
			КонецЕсли;
			ПортСтрокой = Сред(ХвостУзла, 2);
			Если ПустаяСтрока(ПортСтрокой) Тогда
				Результат.Ошибка = "В URL после двоеточия не указан порт.";
				Возврат Результат;
			КонецЕсли;
		Иначе
			ПортСтрокой = "";
		КонецЕсли;
	Иначе
		ПозицияПорта = Найти(Узел, ":");
		Если ПозицияПорта > 0 Тогда
			Результат.Сервер = Лев(Узел, ПозицияПорта - 1);
			ПортСтрокой = Сред(Узел, ПозицияПорта + 1);
			Если ПустаяСтрока(ПортСтрокой) Тогда
				Результат.Ошибка = "В URL после двоеточия не указан порт.";
				Возврат Результат;
			КонецЕсли;
		Иначе
			Результат.Сервер = Узел;
			ПортСтрокой = "";
		КонецЕсли;
	КонецЕсли;
	Если ПустаяСтрока(Результат.Сервер) Тогда
		Результат.Ошибка = "В URL не указан сервер.";
		Возврат Результат;
	КонецЕсли;
	Если Не ПустаяСтрока(ПортСтрокой) Тогда
		Попытка
			Результат.Порт = Число(ПортСтрокой);
		Исключение
			Результат.Ошибка = "Некорректный порт в URL.";
			Возврат Результат;
		КонецПопытки;
		Если Результат.Порт < 1 Или Результат.Порт > 65535
			Или Результат.Порт <> Цел(Результат.Порт) Тогда
			Результат.Ошибка = "Порт должен быть целым числом от 1 до 65535.";
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ДопустимоеИмяHTTP(Имя)
	Если ПустаяСтрока(Имя) Тогда
		Возврат Ложь;
	КонецЕсли;
	ДопустимыеСимволы = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
		+ "0123456789!#$%&'*+-.^_`|~";
	Для Номер = 1 По СтрДлина(Имя) Цикл
		Если Найти(ДопустимыеСимволы, Сред(Имя, Номер, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЕстьЗаголовок(Заголовки, Имя)
	Для Каждого Пара Из Заголовки Цикл
		Если НРег(Пара.Ключ) = НРег(Имя) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ДобавитьКлючКАдресу(ЧастиАдреса, Имя, Значение)
	Разделитель = "?";
	Если Найти(ЧастиАдреса.Ресурс, "?") > 0 Тогда
		Разделитель = "&";
	КонецЕсли;
	Если Прав(ЧастиАдреса.Ресурс, 1) = "?" Или Прав(ЧастиАдреса.Ресурс, 1) = "&" Тогда
		Разделитель = "";
	КонецЕсли;
	ЧастиАдреса.Ресурс = ЧастиАдреса.Ресурс + Разделитель
		+ ЗакодироватьПараметрURL(Имя) + "=" + ЗакодироватьПараметрURL(Значение);
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ЕстьПараметрВАдресе(Ресурс, Имя)
	НачалоЗапроса = Найти(Ресурс, "?");
	Если НачалоЗапроса = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Параметры = СтрРазделить(Сред(Ресурс, НачалоЗапроса + 1), "&");
	Для Каждого Параметр Из Параметры Цикл
		ПозицияРавно = Найти(Параметр, "=");
		Если ПозицияРавно > 0 Тогда
			ИмяПараметра = Лев(Параметр, ПозицияРавно - 1);
		Иначе
			ИмяПараметра = Параметр;
		КонецЕсли;
		Если РаскодироватьПараметрURL(ИмяПараметра) = Имя Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ТокенПоПути(Данные, Путь)
	Если ПустаяСтрока(СокрЛП(Путь)) Тогда
		Возврат "";
	КонецЕсли;
	Ключи = СтрРазделить(Путь, ".");
	Значение = Данные;
	Для Каждого Ключ Из Ключи Цикл
		Если ТипЗнч(Значение) <> Тип("Соответствие") Или ПустаяСтрока(Ключ) Тогда
			Возврат "";
		КонецЕсли;
		Значение = Значение.Получить(Ключ);
	КонецЦикла;
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат "";
	КонецЕсли;
	Возврат Значение;
КонецФункции

