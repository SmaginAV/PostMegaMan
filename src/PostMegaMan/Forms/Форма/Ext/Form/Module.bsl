&НаСервере
Функция СериализоватьСостояниеНаСервере(ИмяСтраницы, ДляФайла = Истина)
	Данные = Новый Структура;
	Данные.Вставить("Метод", Метод);
	Данные.Вставить("КонтекстВыполнения", КонтекстВыполнения);
	Данные.Вставить("Адрес", АдресПараметровURL);
	Данные.Вставить("ПараметрыURL", ПараметрыURLВМассив(ПараметрыURL));
	Данные.Вставить("ТелоЗапроса", ТелоЗапроса);
	Данные.Вставить("ОшибкаКонструктораJSON", ОшибкаКонструктораJSON);
	Данные.Вставить("СпособАвторизации", СпособАвторизации);
	Данные.Вставить("Логин", Логин);
	Данные.Вставить("Пароль", Пароль);
	Данные.Вставить("ТокенBearer", ТокенBearer);
	Данные.Вставить("ИмяКлюча", ИмяКлюча);
	Данные.Вставить("ЗначениеКлюча", ЗначениеКлюча);
	Данные.Вставить("РасположениеКлюча", РасположениеКлюча);
	Данные.Вставить("АдресТокена", АдресТокена);
	Данные.Вставить("МетодТокена", МетодТокена);
	Данные.Вставить("ТелоТокена", ТелоТокена);
	Данные.Вставить("ПутьТокена", ПутьТокена);
	Данные.Вставить("ТокенJWT", ТокенJWT);
	Данные.Вставить("СостояниеТокена", СостояниеТокена);
	Данные.Вставить("КодОтвета", КодОтвета);
	ВремяДляСохранения = Неопределено;
	Если ИзмереноВремяЗапроса Тогда
		ВремяДляСохранения = ВремяЗапросаМс;
	КонецЕсли;
	Данные.Вставить("ВремяЗапросаМс", ВремяДляСохранения);
	Данные.Вставить("ИтоговыйАдрес", ИтоговыйАдрес);
	Данные.Вставить("ОтправленноеТело", ОтправленноеТело);
	Данные.Вставить("ИтоговыеЗаголовкиЗапроса", ИтоговыеЗаголовкиЗапроса);
	Данные.Вставить("ЗаголовкиОтвета", ЗаголовкиОтвета);
	Данные.Вставить("ТелоОтвета", ТелоОтвета);
	Данные.Вставить("ОшибкаЗапроса", ОшибкаЗапроса);
	Данные.Вставить("ТаймаутСекунд", ТаймаутСекунд);
	Данные.Вставить("ЗаголовкиЗапроса", ЗаголовкиВМассив(ЗаголовкиЗапроса));
	Данные.Вставить("ЗаголовкиТокена", ЗаголовкиВМассив(ЗаголовкиТокена));
	Данные.Вставить("ДеревоJSON", УзлыВМассив(ДеревоJSON.ПолучитьЭлементы()));
	Пакет = Новый Структура("Формат,Версия,АктивнаяВкладка,Данные",
		"PostMegaMan", 1, ИмяСтраницы, Данные);
	Если ДляФайла Тогда
		ОшибкаПараметров = ПроверитьПараметрыПакетаURL(Данные, Ложь);
		Если Не ПустаяСтрока(ОшибкаПараметров) Тогда
			ВызватьИсключение ОшибкаПараметров;
		КонецЕсли;
	КонецЕсли;
	Писатель = Новый ЗаписьJSON;
	Писатель.УстановитьСтроку();
	ЗаписатьJSON(Писатель, Пакет);
	ТекстJSON = Писатель.Закрыть();
	Возврат ТекстJSON;
КонецФункции

&НаСервере
Функция ПодготовитьФайлНастроекНаСервере(ИмяСтраницы)
	ТекстJSON = СериализоватьСостояниеНаСервере(ИмяСтраницы);
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("json");
	Попытка
		Документ = Новый ТекстовыйДокумент;
		Документ.УстановитьТекст(ТекстJSON);
		Документ.Записать(ИмяВременногоФайла, КодировкаТекста.UTF8);
		ДанныеФайла = Новый ДвоичныеДанные(ИмяВременногоФайла);
		АдресХранения = ПоместитьВоВременноеХранилище(ДанныеФайла, УникальныйИдентификатор);
	Исключение
		УдалитьФайлы(ИмяВременногоФайла);
		ВызватьИсключение;
	КонецПопытки;
	УдалитьФайлы(ИмяВременногоФайла);
	Возврат АдресХранения;
КонецФункции

&НаСервере
Процедура УдалитьПодготовленныйФайлНаСервере(АдресХранения)
	Если Не ПустаяСтрока(АдресХранения) Тогда
		УдалитьИзВременногоХранилища(АдресХранения);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ЗагрузитьСостояниеНаСервере(АдресХранения)
	Результат = Новый Структура("Ошибка,АктивнаяВкладка", "", "");
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("json");
	Попытка
		ДанныеФайла = ПолучитьИзВременногоХранилища(АдресХранения);
		УдалитьИзВременногоХранилища(АдресХранения);
		Если ТипЗнч(ДанныеФайла) <> Тип("ДвоичныеДанные") Тогда
			Результат.Ошибка = "Выбранный файл не был передан.";
			Возврат Результат;
		КонецЕсли;
		ДанныеФайла.Записать(ИмяВременногоФайла);
		Документ = Новый ТекстовыйДокумент;
		Документ.Прочитать(ИмяВременногоФайла, КодировкаТекста.UTF8);
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Документ.ПолучитьТекст());
		Пакет = ПрочитатьJSON(Чтение);
		Чтение.Закрыть();
	Исключение
		ВременныйФайл = Новый Файл(ИмяВременногоФайла);
		Если ВременныйФайл.Существует() Тогда
			УдалитьФайлы(ИмяВременногоФайла);
		КонецЕсли;
		Результат.Ошибка = "Файл не является корректным UTF-8 JSON: " + ОписаниеОшибки();
		Возврат Результат;
	КонецПопытки;
	УдалитьФайлы(ИмяВременногоФайла);
	Возврат ПрименитьПакетСостоянияНаСервере(Пакет);
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЗаголовкиВМассив(ТаблицаЗаголовков)
	МассивЗаголовков = Новый Массив;
	Для Каждого СтрокаЗаголовка Из ТаблицаЗаголовков Цикл
		МассивЗаголовков.Добавить(Новый Структура("Имя,Значение",
			СтрокаЗаголовка.Имя, СтрокаЗаголовка.Значение));
	КонецЦикла;
	Возврат МассивЗаголовков;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция УзлыВМассив(СтрокиДерева)
	МассивУзлов = Новый Массив;
	Для Каждого Узел Из СтрокиДерева Цикл
		МассивУзлов.Добавить(Новый Структура("Имя,Тип,Значение,Уровень,Дети",
			Узел.Имя, Узел.Тип, Узел.Значение, Узел.Уровень,
			УзлыВМассив(Узел.ПолучитьЭлементы())));
	КонецЦикла;
	Возврат МассивУзлов;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПроверитьПакетСостояния(Пакет, Черновик = Ложь)
	Если ТипЗнч(Пакет) <> Тип("Структура") Тогда
		Возврат "Корень файла должен быть объектом.";
	КонецЕсли;
	Если Не Пакет.Свойство("Формат") Или Пакет.Формат <> "PostMegaMan" Тогда
		Возврат "Это не файл PostMegaMan.";
	КонецЕсли;
	Если Не Пакет.Свойство("Версия") Или ТипЗнч(Пакет.Версия) <> Тип("Число")
		Или Пакет.Версия <> 1 Тогда
		Возврат "Версия файла не поддерживается.";
	КонецЕсли;
	Если Не Пакет.Свойство("АктивнаяВкладка")
		Или ТипЗнч(Пакет.АктивнаяВкладка) <> Тип("Строка") Тогда
		Возврат "Не указана активная вкладка.";
	КонецЕсли;
	Если Пакет.АктивнаяВкладка <> "СтраницаЗапрос"
		И Пакет.АктивнаяВкладка <> "СтраницаПараметры"
		И Пакет.АктивнаяВкладка <> "СтраницаКонструкторJSON"
		И Пакет.АктивнаяВкладка <> "СтраницаАвторизация"
		И Пакет.АктивнаяВкладка <> "СтраницаОтвет"
		И Пакет.АктивнаяВкладка <> "СтраницаСправка" Тогда
		Возврат "Неизвестная активная вкладка.";
	КонецЕсли;
	Если Не Пакет.Свойство("Данные") Или ТипЗнч(Пакет.Данные) <> Тип("Структура") Тогда
		Возврат "Отсутствуют данные формы.";
	КонецЕсли;
	Данные = Пакет.Данные;
	Ошибка = ПроверитьКонтекстПакета(Данные);
	Если Не ПустаяСтрока(Ошибка) Тогда
		Возврат Ошибка;
	КонецЕсли;
	Если Данные.Свойство("ВремяЗапросаМс") Тогда
		ОшибкаВремени = ПроверитьВремяЗапроса(Данные.ВремяЗапросаМс);
		Если Не ПустаяСтрока(ОшибкаВремени) Тогда
			Возврат ОшибкаВремени;
		КонецЕсли;
	КонецЕсли;
	Ошибка = ПроверитьСтроковоеПоле(Данные, "Метод", 40);
	Если Не ПустаяСтрока(Ошибка) Тогда Возврат Ошибка; КонецЕсли;
	ПределАдреса = 2048;
	Если Черновик Тогда
		ПределАдреса = 0;
	КонецЕсли;
	Ошибка = ПроверитьСтроковоеПоле(Данные, "Адрес", ПределАдреса);
	Если Не ПустаяСтрока(Ошибка) Тогда Возврат Ошибка; КонецЕсли;
	Ошибка = ПроверитьСтроковоеПоле(Данные, "ТелоЗапроса", 0);
	Если Не ПустаяСтрока(Ошибка) Тогда Возврат Ошибка; КонецЕсли;
	Ошибка = ПроверитьСтроковоеПоле(Данные, "ОшибкаКонструктораJSON", 0);
	Если Не ПустаяСтрока(Ошибка) Тогда Возврат Ошибка; КонецЕсли;
	Ошибка = ПроверитьСтроковоеПоле(Данные, "СпособАвторизации", 20);
	Если Не ПустаяСтрока(Ошибка) Тогда Возврат Ошибка; КонецЕсли;
	Ошибка = ПроверитьСтроковоеПоле(Данные, "Логин", 256);
	Если Не ПустаяСтрока(Ошибка) Тогда Возврат Ошибка; КонецЕсли;
	Ошибка = ПроверитьСтроковоеПоле(Данные, "Пароль", 1024);
	Если Не ПустаяСтрока(Ошибка) Тогда Возврат Ошибка; КонецЕсли;
	Ошибка = ПроверитьСтроковоеПоле(Данные, "ТокенBearer", 0);
	Если Не ПустаяСтрока(Ошибка) Тогда Возврат Ошибка; КонецЕсли;
	Ошибка = ПроверитьСтроковоеПоле(Данные, "ИмяКлюча", 256);
	Если Не ПустаяСтрока(Ошибка) Тогда Возврат Ошибка; КонецЕсли;
	Ошибка = ПроверитьСтроковоеПоле(Данные, "ЗначениеКлюча", 2048);
	Если Не ПустаяСтрока(Ошибка) Тогда Возврат Ошибка; КонецЕсли;
	Ошибка = ПроверитьСтроковоеПоле(Данные, "РасположениеКлюча", 20);
	Если Не ПустаяСтрока(Ошибка) Тогда Возврат Ошибка; КонецЕсли;
	Ошибка = ПроверитьСтроковоеПоле(Данные, "АдресТокена", 2048);
	Если Не ПустаяСтрока(Ошибка) Тогда Возврат Ошибка; КонецЕсли;
	Ошибка = ПроверитьСтроковоеПоле(Данные, "МетодТокена", 40);
	Если Не ПустаяСтрока(Ошибка) Тогда Возврат Ошибка; КонецЕсли;
	Ошибка = ПроверитьСтроковоеПоле(Данные, "ТелоТокена", 0);
	Если Не ПустаяСтрока(Ошибка) Тогда Возврат Ошибка; КонецЕсли;
	Ошибка = ПроверитьСтроковоеПоле(Данные, "ПутьТокена", 256);
	Если Не ПустаяСтрока(Ошибка) Тогда Возврат Ошибка; КонецЕсли;
	Ошибка = ПроверитьСтроковоеПоле(Данные, "ТокенJWT", 0);
	Если Не ПустаяСтрока(Ошибка) Тогда Возврат Ошибка; КонецЕсли;
	Ошибка = ПроверитьСтроковоеПоле(Данные, "СостояниеТокена", 200);
	Если Не ПустаяСтрока(Ошибка) Тогда Возврат Ошибка; КонецЕсли;
	Ошибка = ПроверитьСтроковоеПоле(Данные, "КодОтвета", 10);
	Если Не ПустаяСтрока(Ошибка) Тогда Возврат Ошибка; КонецЕсли;
	Ошибка = ПроверитьСтроковоеПоле(Данные, "ИтоговыйАдрес", 0);
	Если Не ПустаяСтрока(Ошибка) Тогда Возврат Ошибка; КонецЕсли;
	Ошибка = ПроверитьСтроковоеПоле(Данные, "ОтправленноеТело", 0);
	Если Не ПустаяСтрока(Ошибка) Тогда Возврат Ошибка; КонецЕсли;
	Ошибка = ПроверитьСтроковоеПоле(Данные, "ИтоговыеЗаголовкиЗапроса", 0);
	Если Не ПустаяСтрока(Ошибка) Тогда Возврат Ошибка; КонецЕсли;
	Ошибка = ПроверитьСтроковоеПоле(Данные, "ЗаголовкиОтвета", 0);
	Если Не ПустаяСтрока(Ошибка) Тогда Возврат Ошибка; КонецЕсли;
	Ошибка = ПроверитьСтроковоеПоле(Данные, "ТелоОтвета", 0);
	Если Не ПустаяСтрока(Ошибка) Тогда Возврат Ошибка; КонецЕсли;
	Ошибка = ПроверитьСтроковоеПоле(Данные, "ОшибкаЗапроса", 0);
	Если Не ПустаяСтрока(Ошибка) Тогда Возврат Ошибка; КонецЕсли;
	Если Не Данные.Свойство("ТаймаутСекунд")
		Или ТипЗнч(Данные.ТаймаутСекунд) <> Тип("Число")
		Или Данные.ТаймаутСекунд < 0
		Или Данные.ТаймаутСекунд > 99999
		Или Данные.ТаймаутСекунд <> Цел(Данные.ТаймаутСекунд) Тогда
		Возврат "Некорректное значение таймаута.";
	КонецЕсли;
	Ошибка = ПроверитьМассивЗаголовков(Данные, "ЗаголовкиЗапроса");
	Если Не ПустаяСтрока(Ошибка) Тогда Возврат Ошибка; КонецЕсли;
	Ошибка = ПроверитьМассивЗаголовков(Данные, "ЗаголовкиТокена");
	Если Не ПустаяСтрока(Ошибка) Тогда Возврат Ошибка; КонецЕсли;
	Если Не Данные.Свойство("ДеревоJSON")
		Или ТипЗнч(Данные.ДеревоJSON) <> Тип("Массив")
		Или Данные.ДеревоJSON.Количество() <> 1 Тогда
		Возврат "Дерево JSON должно содержать один корень.";
	КонецЕсли;
	Ошибка = ПроверитьПараметрыПакетаURL(Данные, Черновик);
	Если Не ПустаяСтрока(Ошибка) Тогда
		Возврат Ошибка;
	КонецЕсли;
	Возврат ПроверитьМассивУзлов(Данные.ДеревоJSON, 1);
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПроверитьСтроковоеПоле(Данные, ИмяПоля, МаксимальнаяДлина)
	Если Не Данные.Свойство(ИмяПоля)
		Или ТипЗнч(Данные[ИмяПоля]) <> Тип("Строка") Тогда
		Возврат "Отсутствует или повреждено поле «" + ИмяПоля + "».";
	КонецЕсли;
	Если МаксимальнаяДлина > 0
		И СтрДлина(Данные[ИмяПоля]) > МаксимальнаяДлина Тогда
		Возврат "Поле «" + ИмяПоля + "» слишком длинное.";
	КонецЕсли;
	Возврат "";
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПроверитьМассивЗаголовков(Данные, ИмяПоля)
	Если Не Данные.Свойство(ИмяПоля)
		Или ТипЗнч(Данные[ИмяПоля]) <> Тип("Массив") Тогда
		Возврат "Повреждена таблица «" + ИмяПоля + "».";
	КонецЕсли;
	Для Каждого Заголовок Из Данные[ИмяПоля] Цикл
		Если ТипЗнч(Заголовок) <> Тип("Структура") Тогда
			Возврат "Повреждена строка таблицы «" + ИмяПоля + "».";
		КонецЕсли;
		Ошибка = ПроверитьСтроковоеПоле(Заголовок, "Имя", 256);
		Если Не ПустаяСтрока(Ошибка) Тогда Возврат Ошибка; КонецЕсли;
		Ошибка = ПроверитьСтроковоеПоле(Заголовок, "Значение", 2048);
		Если Не ПустаяСтрока(Ошибка) Тогда Возврат Ошибка; КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПроверитьМассивУзлов(МассивУзлов, Уровень)
	Для Каждого Узел Из МассивУзлов Цикл
		Если ТипЗнч(Узел) <> Тип("Структура") Тогда
			Возврат "Повреждён узел дерева JSON.";
		КонецЕсли;
		Ошибка = ПроверитьСтроковоеПоле(Узел, "Имя", 0);
		Если Не ПустаяСтрока(Ошибка) Тогда Возврат Ошибка; КонецЕсли;
		Ошибка = ПроверитьСтроковоеПоле(Узел, "Тип", 20);
		Если Не ПустаяСтрока(Ошибка) Тогда Возврат Ошибка; КонецЕсли;
		Ошибка = ПроверитьСтроковоеПоле(Узел, "Значение", 0);
		Если Не ПустаяСтрока(Ошибка) Тогда Возврат Ошибка; КонецЕсли;
		Если Не Узел.Свойство("Уровень")
			Или ТипЗнч(Узел.Уровень) <> Тип("Число")
			Или Узел.Уровень <> Уровень
			Или Уровень > 10 Тогда
			Возврат "Некорректный уровень дерева JSON.";
		КонецЕсли;
		Если Не Узел.Свойство("Дети")
			Или ТипЗнч(Узел.Дети) <> Тип("Массив") Тогда
			Возврат "Повреждены дочерние узлы дерева JSON.";
		КонецЕсли;
		Если Узел.Дети.Количество() > 0 Тогда
			Ошибка = ПроверитьМассивУзлов(Узел.Дети, Уровень + 1);
			Если Не ПустаяСтрока(Ошибка) Тогда Возврат Ошибка; КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

&НаСервереБезКонтекста
Функция МассивВТаблицуЗаголовков(МассивЗаголовков)
	ТаблицаЗаголовков = Новый ТаблицаЗначений;
	ТаблицаЗаголовков.Колонки.Добавить("Имя");
	ТаблицаЗаголовков.Колонки.Добавить("Значение");
	Для Каждого Заголовок Из МассивЗаголовков Цикл
		СтрокаЗаголовка = ТаблицаЗаголовков.Добавить();
		СтрокаЗаголовка.Имя = Заголовок.Имя;
		СтрокаЗаголовка.Значение = Заголовок.Значение;
	КонецЦикла;
	Возврат ТаблицаЗаголовков;
КонецФункции

&НаСервереБезКонтекста
Функция МассивВДерево(МассивУзлов)
	Дерево = Новый ДеревоЗначений;
	Дерево.Колонки.Добавить("Имя");
	Дерево.Колонки.Добавить("Тип");
	Дерево.Колонки.Добавить("Значение");
	Дерево.Колонки.Добавить("Уровень");
	ЗаполнитьДеревоИзМассива(Дерево.Строки, МассивУзлов);
	Возврат Дерево;
КонецФункции

&НаСервереБезКонтекста
Процедура ЗаполнитьДеревоИзМассива(СтрокиДерева, МассивУзлов)
	Для Каждого ДанныеУзла Из МассивУзлов Цикл
		Узел = СтрокиДерева.Добавить();
		Узел.Имя = ДанныеУзла.Имя;
		Узел.Тип = ДанныеУзла.Тип;
		Узел.Значение = ДанныеУзла.Значение;
		Узел.Уровень = ДанныеУзла.Уровень;
		ЗаполнитьДеревоИзМассива(Узел.Строки, ДанныеУзла.Дети);
	КонецЦикла;
КонецПроцедуры

#КонецОбласти


#Область ВосстановлениеСостояния

&НаКлиенте
Процедура ПрименитьРезультатЗагрузки(РезультатЗагрузки)
	ЗаменитьТелоВРедакторе();
	ЗапросИзменен = Ложь;
	СнимокТаблицЗапроса = ТекстТаблицЗапроса();
	ПоискЗначенияJSON = "";
	ПоследнийПоискJSON = "";
	СкрытьСтраницуDoom();
	ОбновитьВидимостьАвторизации();
	ПерейтиНаСтраницу(РезультатЗагрузки.АктивнаяВкладка);
	ОбновитьСписокЗначенийЗаголовка(Элементы.ЗаголовкиЗапроса, Элементы.ЗначениеЗаголовка);
	ОбновитьСписокЗначенийЗаголовка(Элементы.ЗаголовкиТокена, Элементы.ЗначениеЗаголовкаТокена);
	ДеревоJSONПриАктивизацииСтроки(Элементы.ДеревоJSON);
	СнимокПараметровURL = ТекстДанныхДляСравнения(ПараметрыURLВМассив(ПараметрыURL));
	ОбновитьПредпросмотрURL();
	ОбновитьКомандыWorkSpace();
КонецПроцедуры


&НаСервере
Функция ЗагрузитьТекстСостоянияНаСервере(ТекстJSON, Черновик = Ложь)
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ТекстJSON);
	Пакет = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();
	Возврат ПрименитьПакетСостоянияНаСервере(Пакет, Черновик);
КонецФункции

&НаСервере
Функция ПрименитьПакетСостоянияНаСервере(Пакет, Черновик = Ложь)
	Результат = Новый Структура("Ошибка,АктивнаяВкладка", "", "");
	Результат.Ошибка = ПроверитьПакетСостояния(Пакет, Черновик);
	Если Не ПустаяСтрока(Результат.Ошибка) Тогда
		Возврат Результат;
	КонецЕсли;
	Данные = Пакет.Данные;
	НовыйКонтекст = КонтекстДанныхЗапроса(Данные);
	Если НовыйКонтекст = "Клиент" И Не КлиентскийHTTPДоступен Тогда

		Результат.Ошибка = "Запрос сохранен для клиента, но клиентский HTTP недоступен в текущем сеансе.";
		Возврат Результат;

	КонецЕсли;
	ТаблицаЗапроса = МассивВТаблицуЗаголовков(Данные.ЗаголовкиЗапроса);
	ТаблицаТокена = МассивВТаблицуЗаголовков(Данные.ЗаголовкиТокена);
	НовоеДерево = МассивВДерево(Данные.ДеревоJSON);
	Метод = Данные.Метод;
	КонтекстВыполнения = НовыйКонтекст;
	АдресПараметровURL = Данные.Адрес;
	АдресДляПоказа = Данные.Адрес;
	Адрес = "";
	Если СтрДлина(Данные.Адрес) <= 2048 Тогда
		Адрес = Данные.Адрес;
	КонецЕсли;
	ЗаполнитьСтрокиПараметровURL(ПараметрыURL, ПараметрыПакетаURL(Данные));
	СнимокПараметровURL = "";
	ТелоЗапроса = Данные.ТелоЗапроса;
	ОшибкаКонструктораJSON = Данные.ОшибкаКонструктораJSON;
	СпособАвторизации = Данные.СпособАвторизации;
	Логин = Данные.Логин;
	Пароль = Данные.Пароль;
	ТокенBearer = Данные.ТокенBearer;
	ИмяКлюча = Данные.ИмяКлюча;
	ЗначениеКлюча = Данные.ЗначениеКлюча;
	РасположениеКлюча = Данные.РасположениеКлюча;
	АдресТокена = Данные.АдресТокена;
	МетодТокена = Данные.МетодТокена;
	ТелоТокена = Данные.ТелоТокена;
	ПутьТокена = Данные.ПутьТокена;
	ТокенJWT = Данные.ТокенJWT;
	СостояниеТокена = Данные.СостояниеТокена;
	КодОтвета = Данные.КодОтвета;
	ВремяЗапросаМс = 0;
	ИзмереноВремяЗапроса = Ложь;
	ВремяДляПоказа = Неопределено;
	Если Данные.Свойство("ВремяЗапросаМс") И ТипЗнч(Данные.ВремяЗапросаМс) = Тип("Число") Тогда
		ВремяЗапросаМс = Данные.ВремяЗапросаМс;
		ИзмереноВремяЗапроса = Истина;
		ВремяДляПоказа = ВремяЗапросаМс;
	КонецЕсли;
	ВремяЗапросаДляПоказа = ПредставлениеВремениЗапроса(ВремяДляПоказа);
	ИтоговыйАдрес = Данные.ИтоговыйАдрес;
	ОтправленноеТело = Данные.ОтправленноеТело;
	ИтоговыеЗаголовкиЗапроса = Данные.ИтоговыеЗаголовкиЗапроса;
	ЗаголовкиОтвета = Данные.ЗаголовкиОтвета;
	ТелоОтвета = Данные.ТелоОтвета;
	ОшибкаЗапроса = Данные.ОшибкаЗапроса;
	ТаймаутСекунд = Данные.ТаймаутСекунд;
	ЗначениеВРеквизитФормы(ТаблицаЗапроса, "ЗаголовкиЗапроса");
	ЗначениеВРеквизитФормы(ТаблицаТокена, "ЗаголовкиТокена");
	ЗначениеВРеквизитФормы(НовоеДерево, "ДеревоJSON");
	ТекстСправки = ПолучитьHTMLСправки();
	Результат.АктивнаяВкладка = Пакет.АктивнаяВкладка;
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область WorkSpace

&НаКлиенте
Процедура ПереключитьПанельWorkSpaceОбработка(Команда)
	Если ОжидаемыйПереходWorkSpace <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	Элементы.ГруппаWorkSpace.Видимость = Не Элементы.ГруппаWorkSpace.Видимость;
	Если Элементы.ГруппаWorkSpace.Видимость Тогда
		Элементы.ПереключитьПанельWorkSpace.Заголовок = "Скрыть боковую панель";
	Иначе
		Элементы.ПереключитьПанельWorkSpace.Заголовок = "Показать боковую панель";
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьКаталогWorkSpaceОбработка(Команда)
	Если ОжидаемыйПереходWorkSpace <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	Диалог.Заголовок = "Выберите каталог WorkSpace";
	Диалог.Каталог = ПутьWorkSpace;
	Диалог.Показать(Новый ОписаниеОповещения("ПослеВыбораКаталогаWorkSpace", ЭтаФорма));
КонецПроцедуры

// Принимает выбранный каталог и сохраняет путь для текущего компьютера.
// Параметры:
//  ВыбранныеКаталоги - Массив, Неопределено - результат файлового диалога.
//  ДополнительныеПараметры - Произвольный - данные оповещения.
&НаКлиенте
Процедура ПослеВыбораКаталогаWorkSpace(ВыбранныеКаталоги, ДополнительныеПараметры) Экспорт
	Если ВыбранныеКаталоги = Неопределено Или ВыбранныеКаталоги.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	ПутьWorkSpace = ВыбранныеКаталоги[0];
	ПутьWorkSpaceПриИзменении(Элементы.ПутьWorkSpace);
КонецПроцедуры

&НаКлиенте
Процедура ПутьWorkSpaceПриИзменении(Элемент)
	Если ОжидаемыйПереходWorkSpace <> Неопределено Тогда
		ПутьWorkSpace = ОжидаемыйПереходWorkSpace.Корень;
		Возврат;
	КонецЕсли;
	Если Не ПолучитьАктуальноеТелоЗапроса() Тогда
		ПутьWorkSpace = ПутьОтображаемогоWorkSpace;
		Возврат;
	КонецЕсли;
	СохранитьАктивныйЧерновикWorkSpace();
	ПутьWorkSpace = СокрЛП(ПутьWorkSpace);
	Если Не ПустаяСтрока(ПутьWorkSpace) Тогда
		Каталог = Новый Файл(ПутьWorkSpace);
		ПутьWorkSpace = Каталог.ПолноеИмя;
	КонецЕсли;
	АктивныйЧерновикWorkSpace = "";
	ТекущийЗапросWorkSpace = "";
	ЗапросИзменен = Ложь;
	Попытка
		СохранитьПутьWorkSpaceНаСервере(ИмяКомпьютера(), ПутьWorkSpace);
	Исключение
		СообщитьОФайле("Путь действует в этой форме, но не сохранен в базе: " + ОписаниеОшибки());
	КонецПопытки;
	ПеречитатьWorkSpace();
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПутьWorkSpaceИзНастроек(Компьютер)
	Путь = ХранилищеОбщихНастроек.Загрузить("PostMegaMan.WorkSpace", Компьютер);
	Если ТипЗнч(Путь) = Тип("Строка") Тогда
		Возврат Путь;
	КонецЕсли;
	Возврат "";
КонецФункции

&НаСервереБезКонтекста
Процедура СохранитьПутьWorkSpaceНаСервере(Компьютер, Путь)
	ХранилищеОбщихНастроек.Сохранить("PostMegaMan.WorkSpace", Компьютер, Путь);
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьWorkSpaceОбработка(Команда)
	Если ОжидаемыйПереходWorkSpace <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПеречитатьWorkSpace();
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьКомандыWorkSpace()
	ЗанятаФорма = HTTPЗапросВыполняется Или ЗагрузкаWorkSpace Или ИмпортВыполняется
		Или ОжидаемыйПереходWorkSpace <> Неопределено Или ЧтениеДереваWorkSpace <> Неопределено
		Или ПодготовкаУзлаWorkSpace <> Неопределено;
	Включен = Не ПустаяСтрока(ПутьWorkSpace);
	Узел = Элементы.ДеревоWorkSpace.ТекущиеДанные;
	ГотовыйЗапрос = Ложь;
	Если Узел <> Неопределено Тогда
		Если Узел.ВидУзла = "Запрос" Или Узел.ВидУзла = "Черновик" Тогда
			ГотовыйЗапрос = ТекущийЗапросWorkSpace = ПолныйПутьWorkSpace(Узел.ОтносительныйПуть);
		КонецЕсли;
	КонецЕсли;
	ОжиданиеВыбора = Включен И Не ГотовыйЗапрос;
	Если ОжиданиеВыбора Тогда
		Элементы.ГруппаWorkSpace.Видимость = Истина;
		Элементы.ПереключитьПанельWorkSpace.Заголовок = "Скрыть боковую панель";
		АдресДляПоказа = "Выберите запрос или создайте новый";
	Иначе
		АдресДляПоказа = АдресПараметровURL;
	КонецЕсли;
	Элементы.ПраваяОбласть.Доступность = Не ЗанятаФорма;
	Элементы.ОсновнаяОбласть.Доступность = Не ОжиданиеВыбора И Не ЗанятаФорма;
	Элементы.ГруппаИмпорт.Доступность = Не ЗанятаФорма;
	Элементы.Отправить.Доступность = Не ОжиданиеВыбора И Не ЗанятаФорма;
	Элементы.ЗагрузитьИзФайла.Доступность = Не ОжиданиеВыбора И Не ЗанятаФорма;
	Элементы.ОчиститьВсе.Доступность = Не ОжиданиеВыбора И Не ЗанятаФорма;
	Элементы.ПереключитьПанельWorkSpace.Доступность = Не ОжиданиеВыбора И Не ЗанятаФорма;
	Элементы.ОткрытьСправку.Доступность = Не ОжиданиеВыбора И Не ЗанятаФорма;
	Элементы.ЗагрузитьИзФайла.Видимость = Не Включен;
	Элементы.ОбновитьWorkSpace.Доступность = Включен И Не ЗанятаФорма;
	Элементы.ДобавитьЗапросWorkSpace.Доступность = Включен И Не ЗанятаФорма;
	Элементы.ДобавитьКаталогWorkSpace.Доступность = Включен И Не ЗанятаФорма;
	Элементы.УдалитьWorkSpace.Доступность = Включен И Узел <> Неопределено И Не ЗанятаФорма;
	Элементы.ДеревоWorkSpace.Доступность = Не ЗанятаФорма;
	Элементы.ПутьWorkSpace.Доступность = Не ЗанятаФорма;
	Элементы.ВыбратьКаталогWorkSpace.Доступность = Не ЗанятаФорма;
	Элементы.СохранитьВФайл.Доступность = Не ЗанятаФорма И (Не Включен Или ГотовыйЗапрос);
	ОбновитьДоступностьРедактораТела();
КонецПроцедуры

&НаКлиенте
Процедура ПеречитатьWorkSpace(ПутьДляВыделения = Неопределено)
	Если ЗагрузкаWorkSpace Или ЧтениеДереваWorkSpace <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Не ПолучитьАктуальноеТелоЗапроса() Тогда
		Возврат;
	КонецЕсли;
	СохранитьАктивныйЧерновикWorkSpace();
	ВыбранныйПуть = "";
	ТотЖеКорень = ПутьОтображаемогоWorkSpace = ПутьWorkSpace;
	Если ТотЖеКорень Тогда
		Узел = Элементы.ДеревоWorkSpace.ТекущиеДанные;
		Если Узел <> Неопределено Тогда
			ВыбранныйПуть = Узел.ОтносительныйПуть;
		КонецЕсли;
	КонецЕсли;
	Если ПутьДляВыделения <> Неопределено Тогда
		ВыбранныйПуть = ПутьДляВыделения;
	КонецЕсли;
	Если Не ПустаяСтрока(ПутьWorkSpace) И ПустаяСтрока(ТекущийЗапросWorkSpace) Тогда
		Элементы.ГруппаWorkSpace.Видимость = Истина;
		Элементы.ПереключитьПанельWorkSpace.Заголовок = "Скрыть боковую панель";
	КонецЕсли;
	ОбновлениеWorkSpace = Истина;
	Попытка
		Если КлиентскийHTTPДоступен И Не ПустаяСтрока(ПутьWorkSpace) Тогда
			ЧтениеДереваWorkSpace = Новый Структура("Корень,Выбор", ПутьWorkSpace, ВыбранныйПуть);
			ОбновитьКомандыWorkSpace();
			ПрочитатьWorkSpaceАсинх(ПутьWorkSpace, ЧтениеДереваWorkSpace);
			Возврат;
		КонецЕсли;
		ДеревоWorkSpace.ПолучитьЭлементы().Очистить();
		Элементы.ДеревоWorkSpace.ТекущаяСтрока = Неопределено;
		ПутьОтображаемогоWorkSpace = ПутьWorkSpace;
		Если Не ПустаяСтрока(ПутьWorkSpace) Тогда
			ПрочитатьУровеньWorkSpace(ДеревоWorkSpace.ПолучитьЭлементы(), "");
			РазвернутьКаталогиWorkSpace();
			Узел = НайтиУзелWorkSpace(ДеревоWorkSpace.ПолучитьЭлементы(), ВыбранныйПуть);
			Если Узел <> Неопределено Тогда
				Элементы.ДеревоWorkSpace.ТекущаяСтрока = Узел.ПолучитьИдентификатор();
			Иначе
				Элементы.ДеревоWorkSpace.ТекущаяСтрока = Неопределено;
			КонецЕсли;
		КонецЕсли;
	Исключение
		// Черновики остаются в памяти, даже если корень временно недоступен.
		СообщитьОФайле("Не удалось прочитать WorkSpace. Выберите доступный каталог: " + ОписаниеОшибки());
	КонецПопытки;
	ЧтениеДереваWorkSpace = Неопределено;
	ОбновитьОтметкиWorkSpace(ДеревоWorkSpace.ПолучитьЭлементы());
	ОбновлениеWorkSpace = Ложь;
	ОбновитьКомандыWorkSpace();
КонецПроцедуры

// Применяет завершённый клиентский снимок к живому экземпляру формы.
// Параметры:
//  Результат - Структура - узлы, ошибка корня и предупреждения вложенных каталогов.
//  Чтение - Структура - захваченные корень и выделение текущего чтения.
&НаКлиенте
Процедура ПослеЧтенияДереваWorkSpace(Результат, Чтение) Экспорт
	Если ФормаHTTPЗакрыта Или ЧтениеДереваWorkSpace <> Чтение Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Если Чтение.Корень <> ПутьWorkSpace Тогда
			ВызватьИсключение "Корневой каталог изменился во время чтения.";
		КонецЕсли;
		ДеревоWorkSpace.ПолучитьЭлементы().Очистить();
		Элементы.ДеревоWorkSpace.ТекущаяСтрока = Неопределено;
		ПутьОтображаемогоWorkSpace = Чтение.Корень;
		Если Не ПустаяСтрока(Результат.Ошибка) Тогда
			ВызватьИсключение Результат.Ошибка;
		КонецЕсли;
		ПрименитьУровеньWorkSpace(ДеревоWorkSpace.ПолучитьЭлементы(), "", Результат.Узлы);
		РазвернутьКаталогиWorkSpace();
		Узел = НайтиУзелWorkSpace(ДеревоWorkSpace.ПолучитьЭлементы(), Чтение.Выбор);
		Если Узел <> Неопределено Тогда
			Элементы.ДеревоWorkSpace.ТекущаяСтрока = Узел.ПолучитьИдентификатор();
		КонецЕсли;
		Для Каждого Предупреждение Из Результат.Предупреждения Цикл
			СообщитьОФайле(Предупреждение);
		КонецЦикла;
	Исключение
		СообщитьОФайле("Не удалось прочитать WorkSpace. Выберите доступный каталог: " + ОписаниеОшибки());
	КонецПопытки;
	ЧтениеДереваWorkSpace = Неопределено;
	ОбновитьОтметкиWorkSpace(ДеревоWorkSpace.ПолучитьЭлементы());
	ОбновлениеWorkSpace = Ложь;
	ОбновитьКомандыWorkSpace();
	Если ОткрытьПервыйПослеЧтенияWorkSpace Тогда
		ОткрытьПервыйПослеЧтенияWorkSpace = Ложь;
		ОткрытьПервыйЗапросWorkSpace();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПрименитьУровеньWorkSpace(Узлы, ОтносительныйКаталог, ДанныеУзлов)
	Для Каждого ДанныеУзла Из ДанныеУзлов Цикл
		Если ДанныеУзла.Каталог Тогда
			Узел = ДобавитьУзелWorkSpace(Узлы, ДанныеУзла.Имя,
				ОтносительныйПутьWorkSpace(ОтносительныйКаталог, ДанныеУзла.Имя), "Каталог");
			ПрименитьУровеньWorkSpace(Узел.ПолучитьЭлементы(), Узел.ОтносительныйПуть, ДанныеУзла.Дети);
		КонецЕсли;
	КонецЦикла;
	Для Каждого ДанныеУзла Из ДанныеУзлов Цикл
		Если Не ДанныеУзла.Каталог И ТекстФайлаPostMegaMan(ДанныеУзла.Текст) Тогда
			ОтносительныйПуть = ОтносительныйПутьWorkSpace(ОтносительныйКаталог, ДанныеУзла.Имя);
			Если ЧерновикиWorkSpace.Получить(ПолныйПутьWorkSpace(ОтносительныйПуть)) = Неопределено Тогда
				ДобавитьУзелWorkSpace(Узлы, ДанныеУзла.Имя, ОтносительныйПуть, "Запрос");
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	ПолныйКаталог = ПолныйПутьWorkSpace(ОтносительныйКаталог);
	Для Каждого Черновик Из ЧерновикиWorkSpace Цикл
		ФайлЧерновика = Новый Файл(Черновик.Ключ);
		Если НРег(СтрЗаменить(ФайлЧерновика.Путь, "\", "/"))
			= НРег(ПутьСРазделителемWorkSpace(ПолныйКаталог)) Тогда
			ДобавитьУзелWorkSpace(Узлы, ФайлЧерновика.Имя,
				ОтносительныйПутьWorkSpace(ОтносительныйКаталог, ФайлЧерновика.Имя), "Черновик");
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ДеревоWorkSpaceПередРазворачиванием(Элемент, Строка, Отказ)
	// Вложенные строки уже прочитаны при полном обновлении дерева.
КонецПроцедуры

&НаКлиенте
Процедура ПрочитатьУровеньWorkSpace(Узлы, ОтносительныйКаталог)
	ПолныйКаталог = ПолныйПутьWorkSpace(ОтносительныйКаталог);
	Каталог = Новый Файл(ПолныйКаталог);
	Если Не Каталог.Существует() Или Не Каталог.ЭтоКаталог() Тогда
		ВызватьИсключение "Каталог отсутствует: " + ПолныйКаталог;
	КонецЕсли;
	Файлы = НайтиФайлы(ПолныйКаталог, "*", Ложь);
	Узлы.Очистить();
	Для Каждого ФайлКаталога Из Файлы Цикл
		Если ФайлКаталога.ЭтоКаталог() Тогда
			Узел = ДобавитьУзелWorkSpace(Узлы, ФайлКаталога.Имя,
				ОтносительныйПутьWorkSpace(ОтносительныйКаталог, ФайлКаталога.Имя), "Каталог");
			Попытка
				ПрочитатьУровеньWorkSpace(Узел.ПолучитьЭлементы(), Узел.ОтносительныйПуть);
			Исключение
				СообщитьОФайле("Не удалось прочитать каталог «" + ФайлКаталога.Имя + "»: " + ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	Для Каждого ФайлКаталога Из Файлы Цикл
		Если Не ФайлКаталога.ЭтоКаталог() И НРег(ФайлКаталога.Расширение) = ".json" Тогда
			Если ФайлPostMegaMan(ФайлКаталога.ПолноеИмя) Тогда
				ОтносительныйПуть = ОтносительныйПутьWorkSpace(ОтносительныйКаталог, ФайлКаталога.Имя);
				Если ЧерновикиWorkSpace.Получить(ПолныйПутьWorkSpace(ОтносительныйПуть)) = Неопределено Тогда
					ДобавитьУзелWorkSpace(Узлы, ФайлКаталога.Имя, ОтносительныйПуть, "Запрос");
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Черновик Из ЧерновикиWorkSpace Цикл
		ФайлЧерновика = Новый Файл(Черновик.Ключ);
		Если НРег(СтрЗаменить(ФайлЧерновика.Путь, "\", "/"))
			= НРег(ПутьСРазделителемWorkSpace(ПолныйКаталог)) Тогда
			ДобавитьУзелWorkSpace(Узлы, ФайлЧерновика.Имя,
				ОтносительныйПутьWorkSpace(ОтносительныйКаталог, ФайлЧерновика.Имя), "Черновик");
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Функция ДобавитьУзелWorkSpace(Узлы, Имя, ОтносительныйПуть, ВидУзла)
	Узел = Узлы.Добавить();
	Узел.Имя = Имя;
	Узел.ОтносительныйПуть = ОтносительныйПуть;
	Узел.ВидУзла = ВидУзла;
	Если ВидУзла = "Каталог" Тогда
		Узел.Картинка = Элементы.ВыбратьКаталогWorkSpace.Картинка;
	Иначе
		Узел.Картинка = Элементы.ДобавитьЗапросWorkSpace.Картинка;
	КонецЕсли;
	Возврат Узел;
КонецФункции

&НаКлиенте
Функция ФайлPostMegaMan(ПолныйПуть)
	Попытка
		Документ = Новый ТекстовыйДокумент;
		Документ.Прочитать(ПолныйПуть, КодировкаТекста.UTF8);
		Возврат ТекстФайлаPostMegaMan(Документ.ПолучитьТекст());
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

&НаКлиенте
Функция ТекстФайлаPostMegaMan(Текст)
	Чтение = Новый ЧтениеJSON;
	Попытка
		Чтение.УстановитьСтроку(Текст);
		Пакет = ПрочитатьJSON(Чтение);
		Если Чтение.Прочитать() Тогда
			Чтение.Закрыть();
			Возврат Ложь;
		КонецЕсли;
		Чтение.Закрыть();
		Возврат ПустаяСтрока(ПроверитьПакетСостояния(Пакет));
	Исключение
		Чтение.Закрыть();
		Возврат Ложь;
	КонецПопытки;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ОтносительныйПутьWorkSpace(Каталог, Имя)
	Если ПустаяСтрока(Каталог) Тогда
		Возврат Имя;
	КонецЕсли;
	Возврат ПутьСРазделителемWorkSpace(Каталог) + Имя;
КонецФункции

&НаКлиенте
Функция ПолныйПутьWorkSpace(ОтносительныйПуть)
	Возврат ПутьСРазделителемWorkSpace(ПутьWorkSpace) + ОтносительныйПуть;
КонецФункции

&НаКлиенте
Функция НайтиУзелWorkSpace(Узлы, ОтносительныйПуть)
	Для Каждого Узел Из Узлы Цикл
		Если Узел.ОтносительныйПуть = ОтносительныйПуть И Узел.ВидУзла <> "Заглушка" Тогда
			Возврат Узел;
		КонецЕсли;
		Найденный = НайтиУзелWorkSpace(Узел.ПолучитьЭлементы(), ОтносительныйПуть);
		Если Найденный <> Неопределено Тогда
			Возврат Найденный;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

&НаКлиенте
Процедура ДеревоWorkSpaceПриАктивизацииСтроки(Элемент)
	Если ОбновлениеWorkSpace Или ЗагрузкаWorkSpace Или ПеретаскиваниеWorkSpace Тогда
		Возврат;
	КонецЕсли;
	Если ОжидаемыйПереходWorkSpace <> Неопределено Тогда
		Если ОжидаемыйПереходWorkSpace.Начат Тогда
			ВосстановитьИсходныйВыборWorkSpace();
		КонецЕсли;
		Возврат;
	КонецЕсли;
	Узел = Элемент.ТекущиеДанные;
	Если Узел = Неопределено Или Узел.ВидУзла = "Заглушка" Тогда
		Возврат;
	КонецЕсли;
	Если ТекущийЗапросWorkSpace = ПолныйПутьWorkSpace(Узел.ОтносительныйПуть) Тогда
		Возврат;
	КонецЕсли;
	НачатьПереходWorkSpace(ПараметрыПереходаWorkSpace(Узел.ОтносительныйПуть, Узел.ВидУзла));
КонецПроцедуры

// Применяет выбранный запрос после передачи файла с компьютера пользователя.
// Параметры:
//  ПомещенныеФайлы - Массив, Неопределено - результат передачи файлов.
//  ПолныйПуть - Строка - выбранный путь запроса.
&НаКлиенте
Процедура ПослеЗагрузкиWorkSpace(ПомещенныеФайлы, ПолныйПуть) Экспорт
	ЗагрузкаWorkSpace = Ложь;
	Загружен = Ложь;
	Если ПомещенныеФайлы <> Неопределено И ПомещенныеФайлы.Количество() > 0 Тогда
		Попытка
			ПодавлениеИзмененийЗапроса = Истина;
			РезультатЗагрузки = ЗагрузитьСостояниеНаСервере(ПомещенныеФайлы[0].Хранение);
			Загружен = ПустаяСтрока(РезультатЗагрузки.Ошибка);
			Если Загружен Тогда
				ПрименитьРезультатЗагрузки(РезультатЗагрузки);
				ТекущийЗапросWorkSpace = ПолныйПуть;
			Иначе
				СообщитьОФайле("Запрос не загружен: " + РезультатЗагрузки.Ошибка);
			КонецЕсли;
		Исключение
			СообщитьОФайле("Не удалось загрузить запрос: " + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
	Если Не Загружен Тогда
		Элементы.ДеревоWorkSpace.ТекущаяСтрока = Неопределено;
	КонецЕсли;
	ЗавершитьПереходWorkSpace();
КонецПроцедуры

&НаКлиенте
Процедура СохранитьАктивныйЧерновикWorkSpace()
	Если Не ПустаяСтрока(АктивныйЧерновикWorkSpace) Тогда
		Если Не ПолучитьАктуальноеТелоЗапроса() Тогда
			ВызватьИсключение "Черновик не обновлен: актуальное тело недоступно.";
		КонецЕсли;
		ЧерновикиWorkSpace.Вставить(АктивныйЧерновикWorkSpace,
			СериализоватьСостояниеНаСервере(АктивнаяВкладкаДляСохранения(), Ложь));
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция АктивнаяВкладкаДляСохранения()
	ИмяСтраницы = Элементы.Страницы.ТекущаяСтраница.Имя;
	Если ИмяСтраницы = "СтраницаDoom" Тогда
		Возврат "СтраницаЗапрос";
	КонецЕсли;
	Возврат ИмяСтраницы;
КонецФункции

&НаКлиенте
Процедура ДобавитьЗапросWorkSpaceОбработка(Команда)
	ЗапроситьИмяWorkSpace("Черновик", "Имя нового запроса (без .json)");
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьКаталогWorkSpaceОбработка(Команда)
	ЗапроситьИмяWorkSpace("Каталог", "Имя нового каталога запросов");
КонецПроцедуры

&НаКлиенте
Процедура ЗапроситьИмяWorkSpace(ВидУзла, Подсказка)
	Если ОжидаемыйПереходWorkSpace <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ПустаяСтрока(ПутьWorkSpace) Тогда
		Возврат;
	КонецЕсли;
	Каталог = "";
	Узел = Элементы.ДеревоWorkSpace.ТекущиеДанные;
	Если Узел <> Неопределено И Узел.ВидУзла = "Каталог" Тогда
		Каталог = Узел.ОтносительныйПуть;
	КонецЕсли;
	ПараметрыСоздания = Новый Структура("Корень,Каталог,ВидУзла", ПутьWorkSpace, Каталог, ВидУзла);
	Оповещение = Новый ОписаниеОповещения("ПослеВводаИмениWorkSpace", ЭтаФорма, ПараметрыСоздания);
	ПоказатьВводСтроки(Оповещение, "", Подсказка);
КонецПроцедуры

// Создает каталог или черновик с указанным именем без перезаписи существующих объектов.
// Параметры:
//  ВведенноеИмя - Строка, Неопределено - результат ввода.
//  ПараметрыСоздания - Структура - корень, каталог и вид нового узла.
&НаКлиенте
Процедура ПослеВводаИмениWorkSpace(ВведенноеИмя, ПараметрыСоздания) Экспорт
	Если ОжидаемыйПереходWorkSpace <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ВведенноеИмя = Неопределено Или ПараметрыСоздания.Корень <> ПутьWorkSpace Тогда
		Возврат;
	КонецЕсли;
	Имя = СокрЛП(ВведенноеИмя);
	Если ПараметрыСоздания.ВидУзла = "Черновик" И НРег(Прав(Имя, 5)) <> ".json" Тогда
		Имя = Имя + ".json";
	КонецЕсли;
	ОшибкаИмени = ПроверитьИмяWorkSpace(ВведенноеИмя, Имя);
	Если Не ПустаяСтрока(ОшибкаИмени) Тогда
		СообщитьОФайле(ОшибкаИмени);
		Возврат;
	КонецЕсли;
	ОтносительныйПуть = ОтносительныйПутьWorkSpace(ПараметрыСоздания.Каталог, Имя);
	ПолныйПуть = ПолныйПутьWorkSpace(ОтносительныйПуть);
	Попытка
		Если КлиентскийHTTPДоступен Тогда
			ПроверитьСвободныйПутьWorkSpace(ПолныйПуть, Ложь);
			Если ПараметрыСоздания.ВидУзла = "Черновик" Тогда
				НачатьПереходWorkSpace(ПараметрыПереходаWorkSpace(ОтносительныйПуть, "Черновик", Истина));
			Иначе
				СохранитьАктивныйЧерновикWorkSpace();
				НачатьПодготовкуУзлаWorkSpace(ОтносительныйПуть, "Каталог");
			КонецЕсли;
			Возврат;
		КонецЕсли;
		ПроверитьСвободныйПутьWorkSpace(ПолныйПуть);
		КаталогНазначения = Новый Файл(ПолныйПутьWorkSpace(ПараметрыСоздания.Каталог));
		Если Не КаталогНазначения.Существует() Или Не КаталогНазначения.ЭтоКаталог() Тогда
			ВызватьИсключение "Целевой каталог отсутствует. Обновите дерево WorkSpace.";
		КонецЕсли;
		Если ПараметрыСоздания.ВидУзла = "Черновик" Тогда
			НачатьПереходWorkSpace(ПараметрыПереходаWorkSpace(ОтносительныйПуть, "Черновик", Истина));
			Возврат;
		КонецЕсли;
		СохранитьАктивныйЧерновикWorkSpace();
		СоздатьКаталог(ПолныйПуть);
		ПеречитатьWorkSpace();
		ВыделитьУзелWorkSpace(ОтносительныйПуть, ПараметрыСоздания.Каталог);

		ОбновитьКомандыWorkSpace();
	Исключение
		СообщитьОФайле("Не удалось добавить узел WorkSpace: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПроверитьИмяWorkSpace(ВведенноеИмя, ИмяФайла)
	Если ПустаяСтрока(ВведенноеИмя) Или СокрЛП(ВведенноеИмя) <> ВведенноеИмя
		Или ВведенноеИмя = "." Или ВведенноеИмя = ".." Тогда
		Возврат "Укажите имя без пробелов в начале и конце, не «.» или «..».";
	КонецЕсли;
	Если СтрДлина(ИмяФайла) > 255 Или Прав(ВведенноеИмя, 1) = "." Тогда
		Возврат "Имя слишком длинное или заканчивается точкой.";
	КонецЕсли;
	Для Позиция = 1 По СтрДлина(ВведенноеИмя) Цикл
		Символ = Сред(ВведенноеИмя, Позиция, 1);
		Если КодСимвола(Символ) < 32 Или Найти("/\:*?""<>|", Символ) > 0 Тогда
			Возврат "Имя содержит разделитель пути или недопустимый символ.";
		КонецЕсли;
	КонецЦикла;
	Основа = ВРег(ВведенноеИмя);
	ПозицияТочки = Найти(Основа, ".");
	Если ПозицияТочки > 0 Тогда
		Основа = Лев(Основа, ПозицияТочки - 1);
	КонецЕсли;
	Зарезервированные = ",CON,PRN,AUX,NUL,COM1,COM2,COM3,COM4,COM5,COM6,COM7,COM8,COM9,"
		+ "LPT1,LPT2,LPT3,LPT4,LPT5,LPT6,LPT7,LPT8,LPT9,";
	Если Найти(Зарезервированные, "," + Основа + ",") > 0 Тогда
		Возврат "Это имя зарезервировано операционной системой.";
	КонецЕсли;
	Возврат "";
КонецФункции

&НаКлиенте
Процедура ПроверитьСвободныйПутьWorkSpace(ПолныйПуть, ПроверятьФайл = Истина)
	Если ПроверятьФайл Тогда
		ФайлНазначения = Новый Файл(ПолныйПуть);
		Если ФайлНазначения.Существует() Тогда
			ВызватьИсключение "Файл, каталог или черновик с таким именем уже существует.";
		КонецЕсли;
	КонецЕсли;
	Для Каждого Черновик Из ЧерновикиWorkSpace Цикл
		Если НРег(Черновик.Ключ) = НРег(ПолныйПуть) Тогда
			ВызватьИсключение "Черновик с таким именем уже существует.";
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура НачатьПодготовкуУзлаWorkSpace(ОтносительныйПуть, ВидУзла, Переход = Неопределено)
	Если ПодготовкаУзлаWorkSpace <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПодготовкаУзлаWorkSpace = Новый Структура("Корень,Путь,ВидУзла,Переход",
		ПутьWorkSpace, ОтносительныйПуть, ВидУзла, Переход);
	ОбновитьКомандыWorkSpace();
	Попытка
		ПодготовитьУзелWorkSpaceАсинх(
			ПолныйПутьWorkSpace(ОтносительныйПуть), ВидУзла = "Каталог", ПодготовкаУзлаWorkSpace);
	Исключение
		ПодготовкаУзлаWorkSpace = Неопределено;
		ОбновитьКомандыWorkSpace();
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры

// Продолжает создание только после асинхронной проверки клиентского пути.
// Параметры:
//  Результат - Структура - ошибка проверки или создания каталога.
//  Подготовка - Структура - корень, целевой узел и ожидаемый переход.
&НаКлиенте
Процедура ПослеПодготовкиУзлаWorkSpace(Результат, Подготовка) Экспорт
	Если ФормаHTTPЗакрыта Или ПодготовкаУзлаWorkSpace <> Подготовка Тогда
		Возврат;
	КонецЕсли;
	ПодготовкаУзлаWorkSpace = Неопределено;
	Попытка
		Если Подготовка.Корень <> ПутьWorkSpace Тогда
			ВызватьИсключение "Корневой каталог изменился во время создания узла.";
		КонецЕсли;
		Если Не ПустаяСтрока(Результат.Ошибка) Тогда
			ВызватьИсключение Результат.Ошибка;
		КонецЕсли;
		ПроверитьСвободныйПутьWorkSpace(ПолныйПутьWorkSpace(Подготовка.Путь), Ложь);
		Если Подготовка.Переход <> Неопределено Тогда
			Если ОжидаемыйПереходWorkSpace = Подготовка.Переход Тогда
				ВыполнитьПереходWorkSpace(Подготовка.Переход, Истина);
			КонецЕсли;
		Иначе
			ПеречитатьWorkSpace(Подготовка.Путь);
		КонецЕсли;
	Исключение
		Если Подготовка.Переход <> Неопределено Тогда
			ЗавершитьПереходWorkSpace();
		КонецЕсли;
		СообщитьОФайле("Не удалось добавить узел WorkSpace: " + ОписаниеОшибки());
	КонецПопытки;
	ОбновитьКомандыWorkSpace();
КонецПроцедуры

&НаКлиенте
Процедура ВыделитьУзелWorkSpace(ОтносительныйПуть, Каталог)
	ОбновлениеWorkSpace = Истина;
	Узел = НайтиУзелWorkSpace(ДеревоWorkSpace.ПолучитьЭлементы(), ОтносительныйПуть);
	Если Узел <> Неопределено Тогда
		Элементы.ДеревоWorkSpace.ТекущаяСтрока = Узел.ПолучитьИдентификатор();
	КонецЕсли;
	ОбновлениеWorkSpace = Ложь;
	ОбновитьКомандыWorkSpace();
КонецПроцедуры

&НаКлиенте
Процедура СохранитьЗапросWorkSpace(ИмяСтраницы)
	Узел = Элементы.ДеревоWorkSpace.ТекущиеДанные;
	Если Узел = Неопределено Или (Узел.ВидУзла <> "Запрос" И Узел.ВидУзла <> "Черновик") Тогда
		Возврат;
	КонецЕсли;
	ПолныйПуть = ТекущийЗапросWorkSpace;
	ОшибкаЗаписи = ЗаписатьЗапросWorkSpace(ПолныйПуть, Узел.ВидУзла, ИмяСтраницы);
	Если Не ПустаяСтрока(ОшибкаЗаписи) Тогда
		ВызватьИсключение ОшибкаЗаписи;
	КонецЕсли;
	СообщитьОФайле("Состояние PostMegaMan сохранено: " + ПолныйПуть);
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПутьСРазделителемWorkSpace(Путь)
	НормализованныйПуть = СтрЗаменить(Путь, "\", "/");
	Если Прав(НормализованныйПуть, 1) = "/" Тогда
		Возврат НормализованныйПуть;
	КонецЕсли;
	Возврат НормализованныйПуть + "/";
КонецФункции

#КонецОбласти

#Область УправлениеЗапросамиWorkSpace

&НаКлиенте
Процедура РазвернутьКаталогиWorkSpace()
	Для Каждого Узел Из ДеревоWorkSpace.ПолучитьЭлементы() Цикл
		Если Узел.ВидУзла = "Каталог" Тогда
			Элементы.ДеревоWorkSpace.Развернуть(Узел.ПолучитьИдентификатор(), Истина);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Функция ПервыйЗапросWorkSpace(Узлы)
	Для Каждого Узел Из Узлы Цикл
		Если Узел.ВидУзла = "Запрос" Тогда
			Возврат Узел;
		КонецЕсли;
		Найденный = ПервыйЗапросWorkSpace(Узел.ПолучитьЭлементы());
		Если Найденный <> Неопределено Тогда
			Возврат Найденный;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

&НаКлиенте
Процедура ОткрытьПервыйЗапросWorkSpace()
	Если ЧтениеДереваWorkSpace <> Неопределено Тогда
		ОткрытьПервыйПослеЧтенияWorkSpace = Истина;
		Возврат;
	КонецЕсли;
	Элементы.ГруппаWorkSpace.Видимость = Истина;
	Элементы.ПереключитьПанельWorkSpace.Заголовок = "Скрыть боковую панель";
	Узел = ПервыйЗапросWorkSpace(ДеревоWorkSpace.ПолучитьЭлементы());
	Если Узел <> Неопределено Тогда
		ВыделитьУзелWorkSpace(Узел.ОтносительныйПуть, "");
		ДеревоWorkSpaceПриАктивизацииСтроки(Элементы.ДеревоWorkSpace);
	КонецЕсли;
	ОбновитьКомандыWorkSpace();
КонецПроцедуры

&НаКлиенте
Процедура УдалитьWorkSpaceОбработка(Команда)
	Если ОжидаемыйПереходWorkSpace <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	Узел = Элементы.ДеревоWorkSpace.ТекущиеДанные;
	Если Узел = Неопределено Или ЗагрузкаWorkSpace Или ПустаяСтрока(ПутьWorkSpace) Тогда
		Возврат;
	КонецЕсли;
	ПараметрыУдаления = Новый Структура("Корень,Путь,ВидУзла",
		ПутьWorkSpace, Узел.ОтносительныйПуть, Узел.ВидУзла);
	Если Узел.ВидУзла = "Каталог" Тогда
		ТекстВопроса = СтрШаблон("Удалить каталог «%1» со всеми вложенными запросами?", Узел.Имя);
	Иначе
		ТекстВопроса = СтрШаблон("Удалить запрос «%1»?", Узел.Имя);
	КонецЕсли;
	Оповещение = Новый ОписаниеОповещения("ПослеПодтвержденияУдаленияWorkSpace", ЭтаФорма, ПараметрыУдаления);
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, 0, КодВозвратаДиалога.Нет);
КонецПроцедуры

// Удаляет подтвержденный объект, если корень и выбор не изменились после вопроса.
// Параметры:
//  Ответ - КодВозвратаДиалога - результат подтверждения.
//  ПараметрыУдаления - Структура - корень, относительный путь и вид объекта.
&НаКлиенте
Процедура ПослеПодтвержденияУдаленияWorkSpace(Ответ, ПараметрыУдаления) Экспорт
	Если Ответ <> КодВозвратаДиалога.Да Или ПараметрыУдаления.Корень <> ПутьWorkSpace Тогда
		Возврат;
	КонецЕсли;
	Узел = Элементы.ДеревоWorkSpace.ТекущиеДанные;
	Если Узел = Неопределено Или ЗагрузкаWorkSpace Тогда
		Возврат;
	КонецЕсли;
	Если Узел.ОтносительныйПуть <> ПараметрыУдаления.Путь Или Узел.ВидУзла <> ПараметрыУдаления.ВидУзла Тогда
		Возврат;
	КонецЕсли;
	Попытка
		УдалитьОбъектWorkSpace(ПараметрыУдаления.Путь, ПараметрыУдаления.ВидУзла);
	Исключение
		СообщитьОФайле("Не удалось удалить объект WorkSpace: " + ОписаниеОшибки());
		ПеречитатьWorkSpace();
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Функция ПроверенныйПутьWorkSpace(ОтносительныйПуть)
	Если ПустаяСтрока(ПутьWorkSpace) Или ПустаяСтрока(ОтносительныйПуть) Тогда
		ВызватьИсключение "Корневой каталог WorkSpace изменять нельзя.";
	КонецЕсли;
	Нормализованный = СтрЗаменить(ОтносительныйПуть, "\", "/");
	Для Каждого ЧастьПути Из СтрРазделить(Нормализованный, "/", Истина) Цикл
		Если ПустаяСтрока(ЧастьПути) Или ЧастьПути = "." Или ЧастьПути = ".." Или Найти(ЧастьПути, ":") > 0 Тогда
			ВызватьИсключение "Путь находится за пределами WorkSpace.";
		КонецЕсли;
	КонецЦикла;
	ФайлОбъекта = Новый Файл(ПолныйПутьWorkSpace(Нормализованный));
	Корень = НРег(ПутьСРазделителемWorkSpace(ПутьWorkSpace));
	ПолныйПуть = СтрЗаменить(ФайлОбъекта.ПолноеИмя, "\", "/");
	Если Лев(НРег(ПолныйПуть), СтрДлина(Корень)) <> Корень Тогда
		ВызватьИсключение "Путь находится за пределами WorkSpace.";
	КонецЕсли;
	Возврат ПолныйПуть;
КонецФункции

&НаКлиенте
Процедура ПроверитьФайлПередУдалениемWorkSpace(ПолныйПуть)
	ФайлЗапроса = Новый Файл(ПолныйПуть);
	Если Не ФайлЗапроса.Существует() Или ФайлЗапроса.ЭтоКаталог() Тогда
		ВызватьИсключение "Файл отсутствует: " + ПолныйПуть;
	КонецЕсли;
	Если НРег(ФайлЗапроса.Расширение) <> ".json" Или Не ФайлPostMegaMan(ПолныйПуть) Тогда
		ВызватьИсключение "Удаление отменено: посторонний, поврежденный или недоступный файл «" + ПолныйПуть + "».";
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьКаталогПередУдалениемWorkSpace(ПолныйКаталог)
	Каталог = Новый Файл(ПолныйКаталог);
	Если Не Каталог.Существует() Или Не Каталог.ЭтоКаталог() Тогда
		ВызватьИсключение "Каталог отсутствует: " + ПолныйКаталог;
	КонецЕсли;
	Для Каждого ФайлКаталога Из НайтиФайлы(ПолныйКаталог, "*", Ложь) Цикл
		Если ФайлКаталога.ЭтоКаталог() Тогда
			ПроверитьКаталогПередУдалениемWorkSpace(ФайлКаталога.ПолноеИмя);
		Иначе
			ПроверитьФайлПередУдалениемWorkSpace(ФайлКаталога.ПолноеИмя);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Функция ПутьВОбъектеWorkSpace(Путь, ПолныйПутьОбъекта, ВидУзла)
	НормализованныйПуть = НРег(СтрЗаменить(Путь, "\", "/"));
	НормализованныйОбъект = НРег(СтрЗаменить(ПолныйПутьОбъекта, "\", "/"));
	Если НормализованныйПуть = НормализованныйОбъект Тогда
		Возврат Истина;
	КонецЕсли;
	Если ВидУзла <> "Каталог" Тогда
		Возврат Ложь;
	КонецЕсли;
	Префикс = ПутьСРазделителемWorkSpace(НормализованныйОбъект);
	Возврат Лев(НормализованныйПуть, СтрДлина(Префикс)) = Префикс;
КонецФункции

&НаКлиенте
Процедура УдалитьОбъектWorkSpace(ОтносительныйПуть, ВидУзла)
	ПолныйПуть = ПроверенныйПутьWorkSpace(ОтносительныйПуть);
	Если ВидУзла = "Каталог" Тогда
		ПроверитьКаталогПередУдалениемWorkSpace(ПолныйПуть);
	ИначеЕсли ВидУзла = "Запрос" Тогда
		ПроверитьФайлПередУдалениемWorkSpace(ПолныйПуть);
	ИначеЕсли ВидУзла = "Черновик" Тогда
		Если ЧерновикиWorkSpace.Получить(ПолныйПуть) = Неопределено Тогда
			ВызватьИсключение "Черновик отсутствует. Обновите дерево WorkSpace.";
		КонецЕсли;
	Иначе
		ВызватьИсключение "Этот объект WorkSpace удалять нельзя.";
	КонецЕсли;
	Если ВидУзла <> "Черновик" Тогда
		УдалитьФайлы(ПолныйПуть);
	КонецЕсли;
	УдаляемыеЧерновики = Новый Массив;
	Для Каждого Черновик Из ЧерновикиWorkSpace Цикл
		Если ПутьВОбъектеWorkSpace(Черновик.Ключ, ПолныйПуть, ВидУзла) Тогда
			УдаляемыеЧерновики.Добавить(Черновик.Ключ);
		КонецЕсли;
	КонецЦикла;
	Для Каждого ПутьЧерновика Из УдаляемыеЧерновики Цикл
		ЧерновикиWorkSpace.Удалить(ПутьЧерновика);
	КонецЦикла;
	Если ПутьВОбъектеWorkSpace(ТекущийЗапросWorkSpace, ПолныйПуть, ВидУзла) Тогда
		АктивныйЧерновикWorkSpace = "";
		ТекущийЗапросWorkSpace = "";
		ОчиститьВсеОбработка(Неопределено);
	КонецЕсли;
	ОбновлениеWorkSpace = Истина;
	Элементы.ДеревоWorkSpace.ТекущаяСтрока = Неопределено;
	ОбновлениеWorkSpace = Ложь;
	ПеречитатьWorkSpace();
КонецПроцедуры

&НаКлиенте
Процедура ДеревоWorkSpaceНачалоПеретаскивания(Элемент, ПараметрыПеретаскивания, Выполнение)
	Выполнение = Ложь;
	Если ОжидаемыйПереходWorkSpace <> Неопределено Тогда
		Если ОжидаемыйПереходWorkSpace.Начат Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	Узел = Элемент.ТекущиеДанные;
	Если Узел = Неопределено Или ЗагрузкаWorkSpace Или ПустаяСтрока(ПутьWorkSpace) Тогда
		Выполнение = Ложь;
		Возврат;
	КонецЕсли;
	Если Узел.ВидУзла <> "Запрос" И Узел.ВидУзла <> "Черновик" Тогда
		Выполнение = Ложь;
		Возврат;
	КонецЕсли;
	// Захват строки мышью отменяет её открытие, но не уже показанный вопрос о сохранении.
	Если ОжидаемыйПереходWorkSpace <> Неопределено Тогда
		ОтключитьОбработчикОжидания("ПродолжитьПереходWorkSpace");
		ОжидаемыйПереходWorkSpace = Неопределено;
	КонецЕсли;
	ПеретаскиваниеWorkSpace = Истина;
	Выполнение = Истина;
	ПараметрыПеретаскивания.Значение = Новый Структура("Форма,Корень,Путь,ВидУзла",
		УникальныйИдентификатор, ПутьWorkSpace, Узел.ОтносительныйПуть, Узел.ВидУзла);
	ПараметрыПеретаскивания.ДопустимыеДействия = ДопустимыеДействияПеретаскивания.Перемещение;
	ПараметрыПеретаскивания.Действие = ДействиеПеретаскивания.Перемещение;
КонецПроцедуры

&НаКлиенте
Процедура ДеревоWorkSpaceОкончаниеПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Если Не ПеретаскиваниеWorkSpace Тогда
		Возврат;
	КонецЕсли;
	ПеретаскиваниеWorkSpace = Ложь;
	ВосстановитьИсходныйВыборWorkSpace();
	ОбновитьКомандыWorkSpace();
КонецПроцедуры

&НаКлиенте
Функция ЦельПереносаWorkSpace(ДанныеПереноса, ИдентификаторСтроки)
	Если ЗагрузкаWorkSpace Или ПустаяСтрока(ПутьWorkSpace)
		Или ТипЗнч(ДанныеПереноса) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Не ДанныеПереноса.Свойство("Форма") Или Не ДанныеПереноса.Свойство("Корень")
		Или Не ДанныеПереноса.Свойство("Путь") Или Не ДанныеПереноса.Свойство("ВидУзла") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если ДанныеПереноса.Форма <> УникальныйИдентификатор Или ДанныеПереноса.Корень <> ПутьWorkSpace Тогда
		Возврат Неопределено;
	КонецЕсли;
	Источник = НайтиУзелWorkSpace(ДеревоWorkSpace.ПолучитьЭлементы(), ДанныеПереноса.Путь);
	Если Источник = Неопределено Или Источник.ВидУзла <> ДанныеПереноса.ВидУзла Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Источник.ВидУзла <> "Запрос" И Источник.ВидУзла <> "Черновик" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если ИдентификаторСтроки = Неопределено Тогда
		Возврат Новый Структура("ОтносительныйПуть", "");
	ИначеЕсли ТипЗнч(ИдентификаторСтроки) <> Тип("Число") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Цель = ДеревоWorkSpace.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если Цель = Неопределено Или Цель.ВидУзла <> "Каталог" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Цель;
КонецФункции

&НаКлиенте
Процедура ДеревоWorkSpaceПроверкаПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	СтандартнаяОбработка = Ложь;
	ПараметрыПеретаскивания.Действие = ДействиеПеретаскивания.Отмена;
	Если ЦельПереносаWorkSpace(ПараметрыПеретаскивания.Значение, Строка) <> Неопределено Тогда
		ПараметрыПеретаскивания.Действие = ДействиеПеретаскивания.Перемещение;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДеревоWorkSpaceПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	СтандартнаяОбработка = Ложь;
	Если ОжидаемыйПереходWorkSpace <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	Цель = ЦельПереносаWorkSpace(ПараметрыПеретаскивания.Значение, Строка);
	Если Цель = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Попытка
		ПереместитьЗапросWorkSpace(ПараметрыПеретаскивания.Значение, Цель.ОтносительныйПуть);
	Исключение
		СообщитьОФайле("Не удалось переместить запрос: " + ОписаниеОшибки());
		ПеречитатьWorkSpace();
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ПереместитьЗапросWorkSpace(ДанныеПереноса, КаталогНазначения)
	ИсходныйПуть = ПроверенныйПутьWorkSpace(ДанныеПереноса.Путь);
	Если КаталогНазначения = "" Тогда
		ЦелевойКаталог = Новый Файл(ПутьWorkSpace);
	Иначе
		ЦелевойКаталог = Новый Файл(ПроверенныйПутьWorkSpace(КаталогНазначения));
	КонецЕсли;
	Если Не ЦелевойКаталог.Существует() Или Не ЦелевойКаталог.ЭтоКаталог() Тогда
		ВызватьИсключение "Целевой каталог отсутствует. Обновите дерево WorkSpace.";
	КонецЕсли;
	ФайлИсточника = Новый Файл(ИсходныйПуть);
	НовыйОтносительныйПуть = ОтносительныйПутьWorkSpace(КаталогНазначения, ФайлИсточника.Имя);
	НовыйПуть = ПроверенныйПутьWorkSpace(НовыйОтносительныйПуть);
	Если НРег(ИсходныйПуть) = НРег(НовыйПуть) Тогда
		Возврат;
	КонецЕсли;
	ПроверитьСвободныйПутьWorkSpace(НовыйПуть);
	СохранитьАктивныйЧерновикWorkSpace();
	Если ДанныеПереноса.ВидУзла = "Запрос" Тогда
		ПроверитьФайлПередУдалениемWorkSpace(ИсходныйПуть);
		ПереместитьФайл(ИсходныйПуть, НовыйПуть);
	Иначе
		ТекстЧерновика = ЧерновикиWorkSpace.Получить(ИсходныйПуть);
		Если ТекстЧерновика = Неопределено Тогда
			ВызватьИсключение "Черновик отсутствует. Обновите дерево WorkSpace.";
		КонецЕсли;
		ЧерновикиWorkSpace.Вставить(НовыйПуть, ТекстЧерновика);
		ЧерновикиWorkSpace.Удалить(ИсходныйПуть);
	КонецЕсли;
	Если ТекущийЗапросWorkSpace = ИсходныйПуть Тогда
		ТекущийЗапросWorkSpace = НовыйПуть;
	КонецЕсли;
	Если АктивныйЧерновикWorkSpace = ИсходныйПуть Тогда
		АктивныйЧерновикWorkSpace = НовыйПуть;
	КонецЕсли;
	ПутьДляВыделения = НовыйОтносительныйПуть;
	Если Не ПустаяСтрока(ТекущийЗапросWorkSpace) Тогда
		ПутьДляВыделения = Сред(ТекущийЗапросWorkSpace, СтрДлина(ПутьСРазделителемWorkSpace(ПутьWorkSpace)) + 1);
	КонецЕсли;
	ПеречитатьWorkSpace(ПутьДляВыделения);
КонецПроцедуры

#КонецОбласти

#Область ВремяHTTPЗапроса

&НаКлиентеНаСервереБезКонтекста
Функция ПредставлениеВремениЗапроса(ВремяЗапроса)
	Если ТипЗнч(ВремяЗапроса) <> Тип("Число") Тогда
		Возврат "";
	КонецЕсли;
	Возврат Формат(ВремяЗапроса, "ЧГ=0;ЧДЦ=0;ЧН=0") + " мс";
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПроверитьВремяЗапроса(ВремяЗапроса)
	Если ВремяЗапроса = Неопределено Или ТипЗнч(ВремяЗапроса) = Тип("Null") Тогда
		Возврат "";
	КонецЕсли;
	Если ТипЗнч(ВремяЗапроса) <> Тип("Число") Тогда
		Возврат "Время запроса должно быть целым неотрицательным числом или null.";
	КонецЕсли;
	Если ВремяЗапроса < 0 Или ВремяЗапроса <> Цел(ВремяЗапроса) Тогда
		Возврат "Время запроса должно быть целым неотрицательным числом или null.";
	КонецЕсли;
	Возврат "";
КонецФункции

#КонецОбласти


#Область НесохраненныеЗапросыWorkSpace

&НаКлиенте
Процедура ПараметрЗапросаПриИзменении(Элемент)
	ОбновитьПредпросмотрURL();
	ОтметитьИзменениеЗапроса();
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаПараметровПриИзменении(Элемент)
	ТекущиеТаблицы = ТекстТаблицЗапроса();
	Если ТекущиеТаблицы <> СнимокТаблицЗапроса Тогда
		ОтметитьИзменениеЗапроса();
	КонецЕсли;
	СнимокТаблицЗапроса = ТекущиеТаблицы;
КонецПроцедуры

&НаКлиенте
Процедура ОтметитьИзменениеЗапроса()
	Если ПодавлениеИзмененийЗапроса Или ЗагрузкаWorkSpace Тогда
		Возврат;
	КонецЕсли;
	ЗапросИзменен = Истина;
	ОбновитьОтметкиWorkSpace(ДеревоWorkSpace.ПолучитьЭлементы());
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОтметкиWorkSpace(Узлы)
	Для Каждого Узел Из Узлы Цикл
		ФайлУзла = Новый Файл(ПолныйПутьWorkSpace(Узел.ОтносительныйПуть));
		Узел.Имя = ФайлУзла.Имя;
		Если Узел.ВидУзла = "Черновик"
			Или (Узел.ВидУзла = "Запрос" И ЗапросИзменен
				И ПолныйПутьWorkSpace(Узел.ОтносительныйПуть) = ТекущийЗапросWorkSpace) Тогда
			Узел.Имя = Узел.Имя + " (*)";
		КонецЕсли;
		ОбновитьОтметкиWorkSpace(Узел.ПолучитьЭлементы());
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Функция ТекстТаблицЗапроса()
	Данные = Новый Структура("ЗаголовкиЗапроса,ЗаголовкиТокена,ДеревоJSON",
		ЗаголовкиВМассив(ЗаголовкиЗапроса), ЗаголовкиВМассив(ЗаголовкиТокена),
		УзлыВМассив(ДеревоJSON.ПолучитьЭлементы()));
	Данные.Вставить("ПараметрыURL", ПараметрыURLВМассив(ПараметрыURL));
	Возврат ТекстДанныхДляСравнения(Данные);
КонецФункции

&НаКлиенте
Функция ТекстПараметровЗапроса()
	Данные = Новый Структура;
	Данные.Вставить("Метод", Метод);
	Данные.Вставить("КонтекстВыполнения", КонтекстВыполнения);
	Данные.Вставить("Адрес", АдресДляПоказа);
	Данные.Вставить("ТаймаутСекунд", ТаймаутСекунд);
	Данные.Вставить("ТелоЗапроса", ТелоЗапроса);
	Данные.Вставить("СпособАвторизации", СпособАвторизации);
	Данные.Вставить("Логин", Логин);
	Данные.Вставить("Пароль", Пароль);
	Данные.Вставить("ТокенBearer", ТокенBearer);
	Данные.Вставить("ИмяКлюча", ИмяКлюча);
	Данные.Вставить("ЗначениеКлюча", ЗначениеКлюча);
	Данные.Вставить("РасположениеКлюча", РасположениеКлюча);
	Данные.Вставить("АдресТокена", АдресТокена);
	Данные.Вставить("МетодТокена", МетодТокена);
	Данные.Вставить("ТелоТокена", ТелоТокена);
	Данные.Вставить("ПутьТокена", ПутьТокена);
	Данные.Вставить("Таблицы", ТекстТаблицЗапроса());
	Возврат ТекстДанныхДляСравнения(Данные);
КонецФункции

&НаКлиенте
Функция ТекстДанныхДляСравнения(Данные)
	Писатель = Новый ЗаписьJSON;
	Писатель.УстановитьСтроку();
	ЗаписатьJSON(Писатель, Данные);
	Возврат Писатель.Закрыть();
КонецФункции

&НаКлиенте
Функция ПараметрыПереходаWorkSpace(ЦелевойПуть, ЦелевойВид, Создать = Ложь)
	ИсходныйВид = "Запрос";
	Если Не ПустаяСтрока(АктивныйЧерновикWorkSpace) Тогда
		ИсходныйВид = "Черновик";
	КонецЕсли;
	Возврат Новый Структура("Корень,ИсходныйПуть,ИсходныйВид,ЦелевойПуть,ЦелевойВид,Создать,Начат",
		ПутьWorkSpace, ТекущийЗапросWorkSpace, ИсходныйВид, ЦелевойПуть, ЦелевойВид, Создать, Ложь);
КонецФункции

&НаКлиенте
Процедура НачатьПереходWorkSpace(Операция)
	Если HTTPЗапросВыполняется Или ОжидаемыйПереходWorkSpace <> Неопределено Или ЗагрузкаWorkSpace Тогда
		Возврат;
	КонецЕсли;
	ОжидаемыйПереходWorkSpace = Операция;
	// ПриАктивизацииСтроки запрещает серверный контекст. Ввод завершается до отложенного перехода.
	ПодключитьОбработчикОжидания("ПродолжитьПереходWorkSpace", 0.1, Истина);
КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьИсходныйВыборWorkSpace()
	ОбновлениеWorkSpace = Истина;
	Если Не ПустаяСтрока(ТекущийЗапросWorkSpace) Тогда
		ОтносительныйПуть = Сред(ТекущийЗапросWorkSpace, СтрДлина(ПутьСРазделителемWorkSpace(ПутьWorkSpace)) + 1);
		Узел = НайтиУзелWorkSpace(ДеревоWorkSpace.ПолучитьЭлементы(), ОтносительныйПуть);
		Если Узел <> Неопределено Тогда
			Элементы.ДеревоWorkSpace.ТекущаяСтрока = Узел.ПолучитьИдентификатор();
		КонецЕсли;
	КонецЕсли;
	ОбновлениеWorkSpace = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьПереходWorkSpace()
	Перем Операция;
	Операция = ОжидаемыйПереходWorkSpace;
	Если Операция = Неопределено Или ПеретаскиваниеWorkSpace Тогда
		Возврат;
	КонецЕсли;
	Если Не ПолучитьАктуальноеТелоЗапроса() Тогда
		ВосстановитьИсходныйВыборWorkSpace();
		ЗавершитьПереходWorkSpace();
		Возврат;
	КонецЕсли;
	Операция.Начат = Истина;
	ВосстановитьИсходныйВыборWorkSpace();
	ОбновитьКомандыWorkSpace();
	Если Операция.Корень <> ПутьWorkSpace Или Операция.ИсходныйПуть <> ТекущийЗапросWorkSpace Тогда
		ЗавершитьПереходWorkSpace();
		Возврат;
	КонецЕсли;
	Если Не ПустаяСтрока(ТекущийЗапросWorkSpace)
		И (ЗапросИзменен Или Не ПустаяСтрока(АктивныйЧерновикWorkSpace)) Тогда
		Оповещение = Новый ОписаниеОповещения("ПослеВопросаОСохраненииWorkSpace", ЭтаФорма, Операция);
		ПоказатьВопрос(Оповещение, "Запрос был отредактирован, сохранить?",
			РежимДиалогаВопрос.ДаНет, 0, КодВозвратаДиалога.Нет, "PostMegaMan");
	Иначе
		ПослеВопросаОСохраненииWorkSpace(КодВозвратаДиалога.Нет, Операция);
	КонецЕсли;
КонецПроцедуры

// Завершает подтвержденный переход; запись всегда адресована исходному запросу.
// Параметры:
//  Ответ - КодВозвратаДиалога - выбор пользователя.
//  Операция - Структура - захваченные исходный путь и цель перехода.
&НаКлиенте
Процедура ПослеВопросаОСохраненииWorkSpace(Ответ, Операция) Экспорт
	Если ОжидаемыйПереходWorkSpace <> Операция Тогда
		Возврат;
	КонецЕсли;
	Если Операция.Корень <> ПутьWorkSpace Или Операция.ИсходныйПуть <> ТекущийЗапросWorkSpace Тогда
		ЗавершитьПереходWorkSpace();
		Возврат;
	КонецЕсли;
	Если Ответ <> КодВозвратаДиалога.Да И Ответ <> КодВозвратаДиалога.Нет Тогда
		ЗавершитьПереходWorkSpace();
		Возврат;
	КонецЕсли;
	Попытка
		Если Ответ = КодВозвратаДиалога.Да Тогда
			ОшибкаЗаписи = ЗаписатьЗапросWorkSpace(Операция.ИсходныйПуть,
				Операция.ИсходныйВид, АктивнаяВкладкаДляСохранения());
			Если Не ПустаяСтрока(ОшибкаЗаписи) Тогда
				ВосстановитьИсходныйВыборWorkSpace();
				ЗавершитьПереходWorkSpace();
				СообщитьОФайле("Запрос не сохранен: " + ОшибкаЗаписи);
				Возврат;
			КонецЕсли;
		Иначе
			СохранитьАктивныйЧерновикWorkSpace();
		КонецЕсли;
		ВыполнитьПереходWorkSpace(Операция);
	Исключение
		СообщитьОФайле("Не удалось переключить запрос: " + ОписаниеОшибки());
		ЗавершитьПереходWorkSpace();
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПереходWorkSpace(Операция, ФайловыйПутьПроверен = Ложь)
	Если Операция.Создать Тогда
		Если Не ФайловыйПутьПроверен Тогда
			Если КлиентскийHTTPДоступен Тогда
				ПроверитьСвободныйПутьWorkSpace(ПолныйПутьWorkSpace(Операция.ЦелевойПуть), Ложь);
				НачатьПодготовкуУзлаWorkSpace(Операция.ЦелевойПуть, "Черновик", Операция);
				Возврат;
			КонецЕсли;
			ПроверитьСвободныйПутьWorkSpace(ПолныйПутьWorkSpace(Операция.ЦелевойПуть));
			КаталогНазначения = Новый Файл(ПолныйПутьWorkSpace(Операция.ЦелевойПуть));
			КаталогНазначения = Новый Файл(КаталогНазначения.Путь);
			Если Не КаталогНазначения.Существует() Или Не КаталогНазначения.ЭтоКаталог() Тогда
				ВызватьИсключение "Целевой каталог отсутствует. Обновите дерево WorkSpace.";
			КонецЕсли;
		КонецЕсли;
	Иначе
		Узел = НайтиУзелWorkSpace(ДеревоWorkSpace.ПолучитьЭлементы(), Операция.ЦелевойПуть);
		Если Узел = Неопределено Или Узел.ВидУзла <> Операция.ЦелевойВид Тогда
			ВызватьИсключение "Выбранный узел отсутствует. Обновите дерево WorkSpace.";
		КонецЕсли;
	КонецЕсли;
	// Даже переход через каталог прекращает связь с отклоненными правками сохраненного файла.
	ТекущийЗапросWorkSpace = "";
	АктивныйЧерновикWorkSpace = "";
	ЗапросИзменен = Ложь;
	ОбновитьОтметкиWorkSpace(ДеревоWorkSpace.ПолучитьЭлементы());
	Если Операция.Создать Тогда
		ПодавлениеИзмененийЗапроса = Истина;
		Если Операция.Свойство("ИмпортТекст") Тогда
			ПрименитьТекстИмпорта(Операция.ИмпортТекст);
		Иначе
			ОчиститьВсеОбработка(Неопределено);
		КонецЕсли;
		ПодавлениеИзмененийЗапроса = Ложь;
		ТекущийЗапросWorkSpace = ПолныйПутьWorkSpace(Операция.ЦелевойПуть);
		АктивныйЧерновикWorkSpace = ТекущийЗапросWorkSpace;
		ЗапросИзменен = Истина;
		СохранитьАктивныйЧерновикWorkSpace();
		ПеречитатьWorkSpace(Операция.ЦелевойПуть);
	Иначе
		ВыделитьУзелWorkSpace(Операция.ЦелевойПуть, "");
		Если Операция.ЦелевойВид = "Черновик" Тогда
			ТекстЧерновика = ЧерновикиWorkSpace.Получить(ПолныйПутьWorkSpace(Операция.ЦелевойПуть));
			ПодавлениеИзмененийЗапроса = Истина;
			РезультатЗагрузки = ЗагрузитьТекстСостоянияНаСервере(ТекстЧерновика, Истина);
			ПодавлениеИзмененийЗапроса = Ложь;
			Если Не ПустаяСтрока(РезультатЗагрузки.Ошибка) Тогда
				ВызватьИсключение РезультатЗагрузки.Ошибка;
			КонецЕсли;
			ПрименитьРезультатЗагрузки(РезультатЗагрузки);
			ТекущийЗапросWorkSpace = ПолныйПутьWorkSpace(Операция.ЦелевойПуть);
			АктивныйЧерновикWorkSpace = ТекущийЗапросWorkSpace;
			ЗапросИзменен = Истина;
		ИначеЕсли Операция.ЦелевойВид = "Запрос" Тогда
			ЗагрузкаWorkSpace = Истина;
			Файлы = Новый Массив;
			ПолныйПуть = ПолныйПутьWorkSpace(Операция.ЦелевойПуть);
			Файлы.Добавить(Новый ОписаниеПередаваемогоФайла(ПолныйПуть));
			Оповещение = Новый ОписаниеОповещения("ПослеЗагрузкиWorkSpace", ЭтаФорма, ПолныйПуть);
			НачатьПомещениеФайлов(Оповещение, Файлы, Ложь, УникальныйИдентификатор);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	СнимокТаблицЗапроса = ТекстТаблицЗапроса();
	ЗавершитьПереходWorkSpace();
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьПереходWorkSpace()
	ОжидаемыйПереходWorkSpace = Неопределено;
	ЗагрузкаWorkSpace = Ложь;
	ПодавлениеИзмененийЗапроса = Ложь;
	ОбновитьОтметкиWorkSpace(ДеревоWorkSpace.ПолучитьЭлементы());
	ОбновитьКомандыWorkSpace();
КонецПроцедуры

&НаКлиенте
Функция ЗаписатьЗапросWorkSpace(ПолныйПуть, ВидУзла, ИмяСтраницы)
	Если Не ПолучитьАктуальноеТелоЗапроса() Тогда
		Возврат "Актуальное тело запроса недоступно.";
	КонецЕсли;
	Попытка
		Если ПолныйПуть <> ТекущийЗапросWorkSpace Или ПустаяСтрока(ПолныйПуть) Тогда
			ВызватьИсключение "Исходный запрос уже изменился.";
		КонецЕсли;
		ОтносительныйПуть = Сред(ПолныйПуть, СтрДлина(ПутьСРазделителемWorkSpace(ПутьWorkSpace)) + 1);
		Если ПроверенныйПутьWorkSpace(ОтносительныйПуть) <> ПолныйПуть Тогда
			ВызватьИсключение "Исходный запрос находится вне WorkSpace.";
		КонецЕсли;
		ФайлНазначения = Новый Файл(ПолныйПуть);
		Если ВидУзла = "Черновик" И ФайлНазначения.Существует() Тогда
			ВызватьИсключение "По пути черновика уже появился файл или каталог. Выберите другое имя.";
		КонецЕсли;
		Если ВидУзла = "Запрос" И Не ФайлPostMegaMan(ПолныйПуть) Тогда
			ВызватьИсключение "Файл запроса исчез или заменен. Обновите дерево WorkSpace.";
		КонецЕсли;
		ТекстJSON = СериализоватьСостояниеНаСервере(ИмяСтраницы);
		Документ = Новый ТекстовыйДокумент;
		Документ.УстановитьТекст(ТекстJSON);
		Документ.Записать(ПолныйПуть, КодировкаТекста.UTF8);
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;
	ЧерновикиWorkSpace.Удалить(ПолныйПуть);
	АктивныйЧерновикWorkSpace = "";
	ЗапросИзменен = Ложь;
	СнимокТаблицЗапроса = ТекстТаблицЗапроса();
	ПеречитатьWorkSpace(ОтносительныйПуть);
	Возврат "";
КонецФункции

#КонецОбласти


#Область РедакторТелаЗапроса

&НаКлиенте
Процедура ИнициализироватьРедакторТела()
	РедакторТелаАктивен = Ложь;
	СеансРедактораТела = "";
	РевизияРедактораТела = 0;
	РевизияТекстаРедактора = 0;
	ОжиданиеРедактораТела = Истина;
	ПопыткиРедактораТела = 0;
	ДоступностьРедактораТела = Ложь;
	ПоказатьПолеТелаЗапроса();
	ТекстРедактораЗапроса = ПолучитьHTMLРедактораНаСервере();
	ПодключитьОбработчикОжидания("ПроверитьИзмененияРедактораТела", 1);
КонецПроцедуры

&НаСервере
Функция ПолучитьHTMLРедактораНаСервере()
	Обработка = РеквизитФормыВЗначение("Объект");
	Возврат Обработка.ПолучитьМакет("РедакторЗапросаHTML").ПолучитьТекст();
КонецФункции

&НаКлиенте
Процедура HTMLТелоЗапросаДокументСформирован(Элемент)
	Если ОжиданиеРедактораТела = Истина Тогда
		ПопытатьсяОткрытьРедакторТела();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция ДанныеМостаРедактора(ТекстJSON)
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ТекстJSON);
	Данные = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();
	Возврат Данные;
КонецФункции

&НаКлиенте
Функция ВыполнитьКомандуРедактораТела(КомандаМоста)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, КомандаМоста);
	Документ = Элементы.HTMLТелоЗапроса.Документ;
	Документ.getElementById("pm-result").value = "";
	Документ.getElementById("pm-command").value = Запись.Закрыть();
	Документ.getElementById("pm-go").click();
	Результат = ДанныеМостаРедактора(Документ.getElementById("pm-result").value);
	Если Не Результат.ok Или Результат.session <> КомандаМоста.session Тогда
		ВызватьИсключение "Редактор не подтвердил актуальный сеанс.";
	КонецЕсли;
	Возврат Результат;
КонецФункции

&НаКлиенте
Процедура ПопытатьсяОткрытьРедакторТела()
	Попытка
		Документ = Элементы.HTMLТелоЗапроса.Документ;
		Данные = ДанныеМостаРедактора(Документ.getElementById("pm-meta").value);
		Если Не Данные.ready Тогда
			ВызватьИсключение "HTML-редактор еще не готов.";
		КонецЕсли;
		СеансРедактораТела = Строка(Новый УникальныйИдентификатор);
		ДоступностьРедактораТела = Элементы.ОсновнаяОбласть.Доступность И Элементы.ПраваяОбласть.Доступность;
		КомандаМоста = Новый Структура("op,session,text,editable", "set", СеансРедактораТела,
			ТелоЗапроса, ДоступностьРедактораТела);
		Результат = ВыполнитьКомандуРедактораТела(КомандаМоста);
		РевизияРедактораТела = Результат.revision;
		РевизияТекстаРедактора = Результат.revision;
		ОжиданиеРедактораТела = Ложь;
		РедакторТелаАктивен = Результат.mode = "json";
		ПоказатьПолеТелаЗапроса();
	Исключение
		ПопыткиРедактораТела = ПопыткиРедактораТела + 1;
		Если ПопыткиРедактораТела >= 4 Тогда
			ОжиданиеРедактораТела = Ложь;
			РедакторТелаАктивен = Ложь;
			ПоказатьПолеТелаЗапроса();
		КонецЕсли;
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьПолеТелаЗапроса()
	Элементы.HTMLТелоЗапроса.Видимость = РедакторТелаАктивен Или ОжиданиеРедактораТела;
	Элементы.ТелоЗапроса.Видимость = Не Элементы.HTMLТелоЗапроса.Видимость;
КонецПроцедуры

&НаКлиенте
Процедура ЗаменитьТелоВРедакторе()
	РедакторТелаАктивен = Ложь;
	ОжиданиеРедактораТела = Истина;
	ПопыткиРедактораТела = 0;
	ПоказатьПолеТелаЗапроса();
	ПопытатьсяОткрытьРедакторТела();
КонецПроцедуры

// Полное тело читается только на границе операции, без передачи на сервер при вводе.
&НаКлиенте
Функция ПолучитьАктуальноеТелоЗапроса()
	Элементы.ПараметрыURL.ЗакончитьРедактированиеСтроки(Ложь);
	ЗаполнитьПараметрыИзАдресаURL();
	ПараметрыURLПриИзменении(Неопределено);
	Если Не РедакторТелаАктивен Тогда
		Возврат Истина;
	КонецЕсли;
	Попытка
		Результат = ВыполнитьКомандуРедактораТела(
			Новый Структура("op,session", "snapshot", СеансРедактораТела));
		Изменен = Результат.revision <> РевизияТекстаРедактора;
		ТелоЗапроса = Результат.text;
		РевизияРедактораТела = Результат.revision;
		РевизияТекстаРедактора = Результат.revision;
		Если Изменен Тогда
			ТелоЗапросаПриИзменении(Неопределено);
		КонецЕсли;
		Если Результат.mode = "native" Тогда
			РедакторТелаАктивен = Ложь;
			ПоказатьПолеТелаЗапроса();
		КонецЕсли;
		Возврат Истина;
	Исключение
		СообщитьОФайле("Не удалось прочитать актуальное тело запроса. Действие отменено. "
			+ "Текст остается в редакторе: " + ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;
КонецФункции

&НаКлиенте
Процедура ПроверитьИзмененияРедактораТела()
	Если Элементы.Страницы.ТекущаяСтраница <> Элементы.СтраницаЗапрос Тогда
		Возврат;
	КонецЕсли;
	Если ОжиданиеРедактораТела Тогда
		ПопытатьсяОткрытьРедакторТела();
		Возврат;
	КонецЕсли;
	Если Не РедакторТелаАктивен Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Данные = ДанныеМостаРедактора(Элементы.HTMLТелоЗапроса.Документ.getElementById("pm-meta").value);
		Если Данные.session <> СеансРедактораТела Тогда
			Возврат;
		КонецЕсли;
		Если Данные.revision <> РевизияРедактораТела Тогда
			РевизияРедактораТела = Данные.revision;
			ОтметитьИзменениеЗапроса();
			Если Данные.doom Тогда
				ОткрытьСтраницуDoom();
			ИначеЕсли Элементы.СтраницаDoom.Видимость Тогда
				СкрытьСтраницуDoom();
			КонецЕсли;
		КонецЕсли;
		Если Данные.mode = "native" Тогда
			ПолучитьАктуальноеТелоЗапроса();
		КонецЕсли;
	Исключение
		// Сбой чтения метаданных не заменяет тело старым снимком. Команда проверит мост повторно.
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДоступностьРедактораТела()
	Если Не РедакторТелаАктивен Тогда
		Возврат;
	КонецЕсли;
	НоваяДоступность = Элементы.ОсновнаяОбласть.Доступность И Элементы.ПраваяОбласть.Доступность;
	Если НоваяДоступность = ДоступностьРедактораТела Тогда
		Возврат;
	КонецЕсли;
	Попытка
		ВыполнитьКомандуРедактораТела(
			Новый Структура("op,session,editable", "readonly", СеансРедактораТела, НоваяДоступность));
		ДоступностьРедактораТела = НоваяДоступность;
	Исключение
		// Родительская группа остается заблокированной и при ошибке DOM-моста.
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьРедакторТела()
	ОтключитьОбработчикОжидания("ПроверитьИзмененияРедактораТела");
	Если ТипЗнч(РедакторТелаАктивен) <> Тип("Булево") Тогда
		РедакторТелаАктивен = Ложь;
	КонецЕсли;
	Если РедакторТелаАктивен Тогда
		Попытка
			ВыполнитьКомандуРедактораТела(Новый Структура("op,session", "destroy", СеансРедактораТела));
		Исключение
			// Закрытие формы также освобождает документ HTML-поля.
		КонецПопытки;
	КонецЕсли;
	РедакторТелаАктивен = Ложь;
	ОжиданиеРедактораТела = Ложь;
	ТекстРедактораЗапроса = "";
КонецПроцедуры

#КонецОбласти

#Область ИмпортЗапросов

&НаКлиенте
Процедура ИмпортироватьCURLОбработка(Команда)

	Контекст = НачатьИмпортЗапросов();
	Если Контекст = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Оповещение = Новый ОписаниеОповещения("ПослеВводаCURL", ЭтаФорма, Контекст);
		ОткрытьФорму("ВнешняяОбработка.PostMegaMan.Форма.ИмпортCURL", , ЭтаФорма, Истина, , ,
			Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Исключение
		ЗавершитьИмпортЗапросов();
		СообщитьОФайле("Не удалось открыть ввод cURL: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ИмпортироватьPostmanОбработка(Команда)

	Контекст = НачатьИмпортЗапросов();
	Если Контекст = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
		Диалог.Фильтр = "Postman JSON (*.json)|*.json";
		Диалог.Заголовок = "Импортировать запрос или коллекцию Postman";
		Диалог.МножественныйВыбор = Ложь;
		Оповещение = Новый ОписаниеОповещения("ПослеВыбораPostman", ЭтаФорма, Контекст);
		НачатьПомещениеФайлов(Оповещение, Диалог, Истина, УникальныйИдентификатор);
	Исключение
		ЗавершитьИмпортЗапросов();
		СообщитьОФайле("Не удалось выбрать файл Postman: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Функция НачатьИмпортЗапросов()

	Если HTTPЗапросВыполняется Или ИмпортВыполняется Или ЗагрузкаWorkSpace
		Или ОжидаемыйПереходWorkSpace <> Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Не ПолучитьАктуальноеТелоЗапроса() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Контекст = Новый Структура("Корень,Запрос,Параметры,Каталог",
		ПутьWorkSpace, ТекущийЗапросWorkSpace, ТекстПараметровЗапроса(), КаталогДляИмпорта());
	ИмпортВыполняется = Истина;
	ОбновитьКомандыWorkSpace();
	Возврат Контекст;

КонецФункции

&НаКлиенте
Функция КонтекстИмпортаАктуален(Контекст)

	Возврат Контекст.Корень = ПутьWorkSpace И Контекст.Запрос = ТекущийЗапросWorkSpace
		И Контекст.Параметры = ТекстПараметровЗапроса();

КонецФункции

// Принимает закрытие формы длинного ввода; отмена не меняет запрос.
// Параметры:
//  ТекстКоманды - Строка, Неопределено - введённая команда либо отмена.
//  Контекст - Структура - исходный запрос, корень и каталог.
&НаКлиенте
Процедура ПослеВводаCURL(ТекстКоманды, Контекст) Экспорт

	Попытка
		Если ТекстКоманды <> Неопределено И КонтекстИмпортаАктуален(Контекст) Тогда
			Результат = РазобратьИмпортНаСервере(ТекстКоманды, "cURL");
			ПрименитьИмпортЗапросов(Результат, Контекст, Истина);
		КонецЕсли;
	Исключение
		СообщитьОФайле("Не удалось импортировать cURL: " + ОписаниеОшибки());
	КонецПопытки;
	ЗавершитьИмпортЗапросов();

КонецПроцедуры

// Читает выбранный файл и очищает адреса временного хранилища, включая устаревший callback.
// Параметры:
//  ПомещенныеФайлы - Массив, Неопределено - результат передачи файла.
//  Контекст - Структура - исходное состояние импорта.
&НаКлиенте
Процедура ПослеВыбораPostman(ПомещенныеФайлы, Контекст) Экспорт

	Попытка
		Если ПомещенныеФайлы <> Неопределено И ПомещенныеФайлы.Количество() > 0 Тогда
			Если КонтекстИмпортаАктуален(Контекст) Тогда
				Результат = ПрочитатьИмпортPostmanНаСервере(ПомещенныеФайлы[0].Хранение);
				ПрименитьИмпортЗапросов(Результат, Контекст, Ложь);
			КонецЕсли;
		КонецЕсли;
	Исключение
		СообщитьОФайле("Не удалось импортировать Postman: " + ОписаниеОшибки());
	КонецПопытки;
	Если ПомещенныеФайлы <> Неопределено Тогда
		Для Каждого ФайлПередачи Из ПомещенныеФайлы Цикл
			УдалитьПодготовленныйФайлНаСервере(ФайлПередачи.Хранение);
		КонецЦикла;
	КонецЕсли;
	ЗавершитьИмпортЗапросов();

КонецПроцедуры

&НаСервере
Функция ПрочитатьИмпортPostmanНаСервере(АдресХранения)

	ВременныйПуть = ПолучитьИмяВременногоФайла("json");
	Попытка
		ДанныеФайла = ПолучитьИзВременногоХранилища(АдресХранения);
		Если ТипЗнч(ДанныеФайла) <> Тип("ДвоичныеДанные") Тогда
			ВызватьИсключение "Файл Postman не был передан.";
		КонецЕсли;
		ПроверитьUTF8ФайлаИмпорта(ДанныеФайла);
		ДанныеФайла.Записать(ВременныйПуть);
		Документ = Новый ТекстовыйДокумент;
		Документ.Прочитать(ВременныйПуть, КодировкаТекста.UTF8);
		Результат = РазобратьИмпортНаСервере(Документ.ПолучитьТекст(), "Postman");
	Исключение
		УдалитьФайлы(ВременныйПуть);
		ВызватьИсключение "Не удалось прочитать UTF-8 JSON файла Postman.";
	КонецПопытки;
	УдалитьФайлы(ВременныйПуть);
	Возврат Результат;

КонецФункции

// ТекстовыйДокумент заменяет повреждённые UTF-8 байты; до чтения требуется отказ без потери символов.
&НаСервереБезКонтекста
Процедура ПроверитьUTF8ФайлаИмпорта(ДанныеФайла)

	Основание64 = СтрЗаменить(СтрЗаменить(Base64Строка(ДанныеФайла), Символы.ПС, ""), Символы.ВК, "");
	Алфавит64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
	Состояние = Новый Структура("Осталось,Код,Минимум", 0, 0, 0);
	Позиция = 1;
	Пока Позиция <= СтрДлина(Основание64) Цикл
		КодБлока = 0;
		Для Смещение = 0 По 3 Цикл
			Знак = Сред(Основание64, Позиция + Смещение, 1);
			ЗначениеЗнака = 0;
			Если Знак <> "=" Тогда
				ЗначениеЗнака = Найти(Алфавит64, Знак) - 1;
			КонецЕсли;
			КодБлока = КодБлока * 64 + ЗначениеЗнака;
		КонецЦикла;
		ПроверитьБайтUTF8Импорта(Цел(КодБлока / 65536), Состояние);
		Если Сред(Основание64, Позиция + 2, 1) <> "=" Тогда
			ПроверитьБайтUTF8Импорта(Цел(КодБлока / 256) % 256, Состояние);
		КонецЕсли;
		Если Сред(Основание64, Позиция + 3, 1) <> "=" Тогда
			ПроверитьБайтUTF8Импорта(КодБлока % 256, Состояние);
		КонецЕсли;
		Позиция = Позиция + 4;
	КонецЦикла;
	Если Состояние.Осталось <> 0 Тогда
		ВызватьИсключение "Файл содержит незавершённую последовательность UTF-8.";
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПроверитьБайтUTF8Импорта(КодБайта, Состояние)

	Если Состояние.Осталось > 0 Тогда
		Если КодБайта < 128 Или КодБайта > 191 Тогда
			ВызватьИсключение "Некорректная кодировка UTF-8 файла импорта.";
		КонецЕсли;
		Состояние.Код = Состояние.Код * 64 + КодБайта - 128;
		Состояние.Осталось = Состояние.Осталось - 1;
		Если Состояние.Осталось = 0 Тогда
			Если Состояние.Код < Состояние.Минимум Или Состояние.Код > 1114111
				Или (Состояние.Код >= 55296 И Состояние.Код <= 57343) Тогда
				ВызватьИсключение "Некорректная Unicode-последовательность файла импорта.";
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли КодБайта <= 127 Тогда
		Возврат;
	ИначеЕсли КодБайта >= 194 И КодБайта <= 223 Тогда
		Состояние.Осталось = 1;
		Состояние.Код = КодБайта - 192;
		Состояние.Минимум = 128;
	ИначеЕсли КодБайта >= 224 И КодБайта <= 239 Тогда
		Состояние.Осталось = 2;
		Состояние.Код = КодБайта - 224;
		Состояние.Минимум = 2048;
	ИначеЕсли КодБайта >= 240 И КодБайта <= 244 Тогда
		Состояние.Осталось = 3;
		Состояние.Код = КодБайта - 240;
		Состояние.Минимум = 65536;
	Иначе
		ВызватьИсключение "Некорректная кодировка UTF-8 файла импорта.";
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция РазобратьИмпортНаСервере(Текст, Вид)

	ОбработкаИмпорта = РеквизитФормыВЗначение("Объект");
	Если Вид = "cURL" Тогда
		Результат = ОбработкаИмпорта.РазобратьCURL(Текст);
	Иначе
		Результат = ОбработкаИмпорта.РазобратьPostman(Текст);
	КонецЕсли;
	Если ПустаяСтрока(Результат.Ошибка) Тогда
		ПроверитьУзлыИмпорта(Результат.Узлы);
	КонецЕсли;
	Возврат Результат;

КонецФункции

&НаСервере
Процедура ПроверитьУзлыИмпорта(Узлы)

	Для Каждого Узел Из Узлы Цикл
		Если Узел.Каталог Тогда
			ПроверитьУзлыИмпорта(Узел.Дети);
		Иначе
			Читатель = Новый ЧтениеJSON;
			Читатель.УстановитьСтроку(Узел.ТекстСостояния);
			Пакет = ПрочитатьJSON(Читатель);
			Читатель.Закрыть();
			ПараметрыИмпорта = Новый Массив;
			Если Узел.СведенияQuery <> Неопределено Тогда
				Для Каждого Сведения Из Узел.СведенияQuery Цикл
					ПараметрИмпорта = ПараметрыИзАдресаURL("?" + Сведения.Пара)[0];
					ПараметрИмпорта.Используется = Сведения.Используется;
					ПараметрИмпорта.НеразрешенныйШаблон = Сведения.НеразрешенныйШаблон;
					ПараметрыИмпорта.Добавить(ПараметрИмпорта);
				КонецЦикла;
			Иначе
				ПараметрыИмпорта = ПараметрыИзАдресаURL(Пакет.Данные.Адрес);
			КонецЕсли;
			Пакет.Данные.Вставить("ПараметрыURL", ПараметрыИмпорта);
			ОшибкаПакета = ПроверитьПакетСостояния(Пакет);
			Если Не ПустаяСтрока(ОшибкаПакета) Тогда
				ВызватьИсключение "Запрос импорта " + Узел.Имя + ": " + ОшибкаПакета;
			КонецЕсли;
			ЧитаемоеТело = ПодготовитьТелоОтветаДляПоказа(Пакет.Данные.ТелоЗапроса);
			Если ЧитаемоеТело <> Пакет.Данные.ТелоЗапроса Тогда
				Пакет.Данные.ТелоЗапроса = ЧитаемоеТело;
			КонецЕсли;
			Пакет.Данные.Вставить("КонтекстВыполнения", "Сервер");
			Писатель = Новый ЗаписьJSON;
			Писатель.УстановитьСтроку();
			ЗаписатьJSON(Писатель, Пакет);
			Узел.ТекстСостояния = Писатель.Закрыть();
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ПрименитьИмпортЗапросов(Результат, Контекст, ЗаменитьТекущий)
	Перем Операция;

	Если Не ПустаяСтрока(Результат.Ошибка) Тогда
		СообщитьОФайле("Импорт отменён: " + Результат.Ошибка);
		Возврат;
	КонецЕсли;
	Если Не КонтекстИмпортаАктуален(Контекст) Тогда
		Возврат;
	КонецЕсли;
	Если Результат.Вид = "Дерево" Тогда
		ЗаписатьДеревоИмпорта(Результат);
	ИначеЕсли ЗаменитьТекущий И (ПустаяСтрока(ПутьWorkSpace) Или Не ПустаяСтрока(ТекущийЗапросWorkSpace)) Тогда
		ПрименитьТекстИмпорта(ИмпортСТекущимКонтекстом(Результат.Узлы[0].ТекстСостояния));
	ИначеЕсли Не ПустаяСтрока(ПутьWorkSpace) Тогда
		Узел = Результат.Узлы[0];
		ПутьЧерновика = СвободноеИмяИмпорта(Контекст.Каталог, Узел.Имя, Ложь, Новый Соответствие);
		Операция = ПараметрыПереходаWorkSpace(ПутьЧерновика, "Черновик", Истина);
		Операция.Вставить("ИмпортТекст", Узел.ТекстСостояния);
		НачатьПереходWorkSpace(Операция);
	Иначе
		Контекст.Вставить("ИмпортТекст", Результат.Узлы[0].ТекстСостояния);
		Если ЗапросИзменен Тогда
			Оповещение = Новый ОписаниеОповещения("ПослеВопросаИмпортаБезWorkSpace", ЭтаФорма, Контекст);
			ПоказатьВопрос(Оповещение, "Запрос был отредактирован, сохранить?",
				РежимДиалогаВопрос.ДаНет, 0, КодВозвратаДиалога.Нет, "PostMegaMan");
		Иначе
			ПрименитьТекстИмпорта(Контекст.ИмпортТекст);
		КонецЕсли;
	КонецЕсли;
	Если Результат.Предупреждения.Количество() > 0 Тогда
		СообщитьОФайле(СтрСоединить(Результат.Предупреждения, Символы.ПС));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПрименитьТекстИмпорта(ТекстСостояния)

	ПрежнееСостояние = СериализоватьСостояниеНаСервере(АктивнаяВкладкаДляСохранения(), Ложь);
	Попытка
		Результат = ЗагрузитьТекстСостоянияНаСервере(ТекстСостояния);
		Если Не ПустаяСтрока(Результат.Ошибка) Тогда
			ВызватьИсключение Результат.Ошибка;
		КонецЕсли;
		ПрименитьРезультатЗагрузки(Результат);
	Исключение
		ЗагрузитьТекстСостоянияНаСервере(ПрежнееСостояние, Истина);
		ЗаменитьТелоВРедакторе();
		ВызватьИсключение;
	КонецПопытки;
	ЗапросИзменен = Истина;
	СохранитьАктивныйЧерновикWorkSpace();
	СнимокТаблицЗапроса = ТекстТаблицЗапроса();
	ОбновитьОтметкиWorkSpace(ДеревоWorkSpace.ПолучитьЭлементы());
	ОбновитьКомандыWorkSpace();

КонецПроцедуры

// Сохраняет старый запрос перед одиночным импортом в режиме без WorkSpace.
// Параметры:
//  Ответ - КодВозвратаДиалога - решение о сохранении.
//  Контекст - Структура - исходное состояние и импортированный пакет.
&НаКлиенте
Процедура ПослеВопросаИмпортаБезWorkSpace(Ответ, Контекст) Экспорт

	Если Не КонтекстИмпортаАктуален(Контекст) Тогда
		Возврат;
	КонецЕсли;
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		ПрименитьТекстИмпорта(Контекст.ИмпортТекст);
	ИначеЕсли Ответ = КодВозвратаДиалога.Да Тогда
		АдресХранения = "";
		Попытка
			АдресХранения = ПодготовитьФайлНастроекНаСервере(АктивнаяВкладкаДляСохранения());
			Контекст.Вставить("Хранение", АдресХранения);
			Файлы = Новый Массив;
			Файлы.Добавить(Новый ОписаниеПередаваемогоФайла("PostMegaMan.json", АдресХранения));
			Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
			Диалог.Фильтр = "Файлы JSON (*.json)|*.json";
			Диалог.ПолноеИмяФайла = "PostMegaMan.json";
			Оповещение = Новый ОписаниеОповещения("ПослеСохраненияПередИмпортом", ЭтаФорма, Контекст);
			НачатьПолучениеФайлов(Оповещение, Файлы, Диалог, Истина);
		Исключение
			УдалитьПодготовленныйФайлНаСервере(АдресХранения);
			СообщитьОФайле("Импорт отменён: не удалось сохранить запрос.");
		КонецПопытки;
	КонецЕсли;

КонецПроцедуры

// Продолжает импорт только после успешной записи выбранного пользователем файла.
// Параметры:
//  ПолученныеФайлы - Массив, Неопределено - результат записи.
//  Контекст - Структура - исходные параметры и адрес временного файла.
&НаКлиенте
Процедура ПослеСохраненияПередИмпортом(ПолученныеФайлы, Контекст) Экспорт

	УдалитьПодготовленныйФайлНаСервере(Контекст.Хранение);
	Если ПолученныеФайлы <> Неопределено И ПолученныеФайлы.Количество() > 0
		И КонтекстИмпортаАктуален(Контекст) Тогда
		ПрименитьТекстИмпорта(Контекст.ИмпортТекст);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьИмпортЗапросов()

	ИмпортВыполняется = Ложь;
	ОбновитьКомандыWorkSpace();

КонецПроцедуры

&НаКлиенте
Функция КаталогДляИмпорта()

	Узел = Элементы.ДеревоWorkSpace.ТекущиеДанные;
	Если Узел = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Если Узел.ВидУзла = "Каталог" Тогда
		Возврат Узел.ОтносительныйПуть;
	КонецЕсли;
	ПутьУзла = СтрЗаменить(Узел.ОтносительныйПуть, "\", "/");
	ПоследнийРазделитель = 0;
	Для Позиция = 1 По СтрДлина(ПутьУзла) Цикл
		Если Сред(ПутьУзла, Позиция, 1) = "/" Тогда
			ПоследнийРазделитель = Позиция;
		КонецЕсли;
	КонецЦикла;
	Если ПоследнийРазделитель = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат Лев(ПутьУзла, ПоследнийРазделитель - 1);

КонецФункции

&НаКлиенте
Функция БезопасноеИмяИмпорта(Имя, Каталог)

	Результат = "";
	Для Позиция = 1 По СтрДлина(Имя) Цикл
		Знак = Сред(Имя, Позиция, 1);
		Если КодСимвола(Знак) < 32 Или Найти("/\:*?""<>|", Знак) > 0 Тогда
			Знак = "_";
		КонецЕсли;
		Результат = Результат + Знак;
	КонецЦикла;
	Результат = СокрЛП(Результат);
	Пока Прав(Результат, 1) = "." Или Прав(Результат, 1) = " " Цикл
		Результат = Лев(Результат, СтрДлина(Результат) - 1);
	КонецЦикла;
	Если Не Каталог И НРег(Прав(Результат, 5)) = ".json" Тогда
		Результат = Лев(Результат, СтрДлина(Результат) - 5);
	КонецЕсли;
	Если Результат = "" Тогда
		Результат = "Запрос";
		Если Каталог Тогда
			Результат = "Каталог";
		КонецЕсли;
	КонецЕсли;
	Результат = Лев(Результат, 180);
	Если Не ПустаяСтрока(ПроверитьИмяWorkSpace(Результат, Результат)) Тогда
		Результат = "_" + Результат;
	КонецЕсли;
	Возврат Результат;

КонецФункции

&НаКлиенте
Функция СвободноеИмяИмпорта(КаталогРодитель, Имя, Каталог, Занятые)

	РодительскийКаталог = Новый Файл(ПолныйПутьWorkSpace(КаталогРодитель));
	Если РодительскийКаталог.Существует() Тогда
		Для Каждого Сосед Из НайтиФайлы(РодительскийКаталог.ПолноеИмя, "*") Цикл
			Занятые.Вставить(НРег(СтрЗаменить(Сосед.ПолноеИмя, "\", "/")), Истина);
		КонецЦикла;
	КонецЕсли;
	Основа = БезопасноеИмяИмпорта(Имя, Каталог);
	Суффикс = 1;
	Пока Истина Цикл
		ИмяОбъекта = Основа;
		Если Суффикс > 1 Тогда
			ИмяОбъекта = ИмяОбъекта + " (" + Формат(Суффикс, "ЧГ=0") + ")";
		КонецЕсли;
		Если Не Каталог Тогда
			ИмяОбъекта = ИмяОбъекта + ".json";
		КонецЕсли;
		Относительный = ОтносительныйПутьWorkSpace(КаталогРодитель, ИмяОбъекта);
		Полный = ПроверенныйПутьWorkSpace(Относительный);
		Свободен = Занятые.Получить(НРег(Полный)) = Неопределено;
		ФайлНазначения = Новый Файл(Полный);
		Свободен = Свободен И Не ФайлНазначения.Существует();
		Для Каждого Черновик Из ЧерновикиWorkSpace Цикл
			Если НРег(Черновик.Ключ) = НРег(Полный) Тогда
				Свободен = Ложь;
			КонецЕсли;
		КонецЦикла;
		Если Свободен Тогда
			Занятые.Вставить(НРег(Полный), Истина);
			Возврат Относительный;
		КонецЕсли;
		Суффикс = Суффикс + 1;
	КонецЦикла;

КонецФункции

&НаКлиенте
Процедура ПодготовитьПланИмпорта(Узлы, Родитель, Занятые, План)

	Для Каждого Узел Из Узлы Цикл
		Путь = СвободноеИмяИмпорта(Родитель, Узел.Имя, Узел.Каталог, Занятые);
		План.Добавить(Новый Структура("Путь,Каталог,ТекстСостояния", Путь, Узел.Каталог, Узел.ТекстСостояния));
		Если Узел.Каталог Тогда
			ПодготовитьПланИмпорта(Узел.Дети, Путь, Занятые, План);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьДеревоИмпорта(Результат)

	Корень = Новый Файл(ПутьWorkSpace);
	Если ПустаяСтрока(ПутьWorkSpace) Или Не Корень.Существует() Или Не Корень.ЭтоКаталог() Тогда
		ВызватьИсключение "Для импорта дерева сначала выберите доступный каталог WorkSpace.";
	КонецЕсли;
	Если Не ПолучитьАктуальноеТелоЗапроса() Тогда
		ВызватьИсключение "Актуальное тело запроса недоступно.";
	КонецЕсли;
	Занятые = Новый Соответствие;
	ПутьКоллекции = СвободноеИмяИмпорта("", Результат.Имя, Истина, Занятые);
	План = Новый Массив;
	План.Добавить(Новый Структура("Путь,Каталог,ТекстСостояния", ПутьКоллекции, Истина, ""));
	ПодготовитьПланИмпорта(Результат.Узлы, ПутьКоллекции, Занятые, План);
	Созданные = Новый Массив;
	ПервыйПуть = "";
	Попытка
		Для Каждого Пункт Из План Цикл
			Полный = ПроверенныйПутьWorkSpace(Пункт.Путь);
			ПроверитьСвободныйПутьWorkSpace(Полный);
			Если Пункт.Каталог Тогда
				СоздатьКаталог(Полный);
				Созданные.Добавить(Новый Структура("Путь,Каталог,Текст", Полный, Истина, ""));
			Иначе
				Документ = Новый ТекстовыйДокумент;
				Документ.УстановитьТекст(Пункт.ТекстСостояния);
				Созданные.Добавить(Новый Структура("Путь,Каталог,Текст", Полный, Ложь, Документ.ПолучитьТекст()));
				Документ.Записать(Полный, КодировкаТекста.UTF8);
				Если ПервыйПуть = "" Тогда
					ПервыйПуть = Пункт.Путь;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	Исключение
		ОшибкаЗаписи = ОписаниеОшибки();
		ОшибкаУборки = УбратьСозданныеИмпортом(Созданные);
		Если Не ПустаяСтрока(ОшибкаУборки) Тогда
			ОшибкаЗаписи = ОшибкаЗаписи + Символы.ПС + "Остался неполный импорт: "
				+ ПолныйПутьWorkSpace(ПутьКоллекции) + Символы.ПС + ОшибкаУборки;
		КонецЕсли;
		ВызватьИсключение ОшибкаЗаписи;
	КонецПопытки;
	ПеречитатьWorkSpace();
	Если ПустаяСтрока(ТекущийЗапросWorkSpace) Тогда
		Если ПервыйПуть <> "" Тогда
			НачатьПереходWorkSpace(ПараметрыПереходаWorkSpace(ПервыйПуть, "Запрос"));
		Иначе
			ВыделитьУзелWorkSpace(ПутьКоллекции, "");
			ОбновитьКомандыWorkSpace();
		КонецЕсли;
	КонецЕсли;
	СообщитьОФайле("Коллекция добавлена в WorkSpace: " + ПутьКоллекции);

КонецПроцедуры

&НаКлиенте
Функция УбратьСозданныеИмпортом(Созданные)

	Ошибки = Новый Массив;
	Индекс = Созданные.Количество() - 1;
	Пока Индекс >= 0 Цикл
		ОбъектУборки = Созданные[Индекс];
		Попытка
			ФайлУборки = Новый Файл(ОбъектУборки.Путь);
			Если ФайлУборки.Существует() Тогда
				Если ОбъектУборки.Каталог Тогда
					Содержимое = НайтиФайлы(ОбъектУборки.Путь, "*");
					Если Содержимое.Количество() <> 0 Тогда
						ВызватьИсключение "Каталог содержит оставшиеся или посторонние файлы.";
					КонецЕсли;
				Иначе
					Документ = Новый ТекстовыйДокумент;
					Документ.Прочитать(ОбъектУборки.Путь, КодировкаТекста.UTF8);
					Если Документ.ПолучитьТекст() <> ОбъектУборки.Текст Тогда
						ВызватьИсключение "Созданный файл изменён извне; автоматическая уборка отменена.";
					КонецЕсли;
				КонецЕсли;
				УдалитьФайлы(ОбъектУборки.Путь);
			КонецЕсли;
		Исключение
			Ошибки.Добавить(ОписаниеОшибки());
		КонецПопытки;
		Индекс = Индекс - 1;
	КонецЦикла;
	Возврат СтрСоединить(Ошибки, Символы.ПС);

КонецФункции

#КонецОбласти

#Область ПараметрыURL

&НаКлиенте
Процедура ПараметрыURLПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)

	Если НоваяСтрока И Не Копирование Тогда
		Элемент.ТекущиеДанные.Используется = Истина;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПараметрыURLПриИзменении(Элемент)

	НовыйСнимок = ТекстДанныхДляСравнения(ПараметрыURLВМассив(ПараметрыURL));
	Если НовыйСнимок = СнимокПараметровURL Тогда
		Возврат;
	КонецЕсли;
	Попытка
		АдресПараметровURL = СобратьАдресПараметровURL(АдресПараметровURL, ПараметрыURL);
		АдресДляПоказа = АдресПараметровURL;
		ПрименитьДлинуАдресаURL();
	Исключение
		ОшибкаПараметровURL = ОписаниеОшибки();
		ОтметитьИзменениеЗапроса();
		Возврат;
	КонецПопытки;
	СнимокПараметровURL = НовыйСнимок;
	ОбновитьПредпросмотрURL();
	ОтметитьИзменениеЗапроса();
	СнимокТаблицЗапроса = ТекстТаблицЗапроса();

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПараметрыИзАдресаURL()

	Если Не ПустаяСтрока(ПутьWorkSpace) Тогда
		// При выборе каталога в шапке показана подсказка; это не правка URL черновика.
		УзелWorkSpace = Элементы.ДеревоWorkSpace.ТекущиеДанные;
		Если ПустаяСтрока(ТекущийЗапросWorkSpace) Или УзелWorkSpace = Неопределено Тогда
			Возврат;
		КонецЕсли;
		Если УзелWorkSpace.ВидУзла <> "Запрос" И УзелWorkSpace.ВидУзла <> "Черновик" Тогда
			Возврат;
		КонецЕсли;
		Если ТекущийЗапросWorkSpace <> ПолныйПутьWorkSpace(УзелWorkSpace.ОтносительныйПуть) Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	Если АдресДляПоказа = АдресПараметровURL Тогда
		Возврат;
	КонецЕсли;
	Попытка
		НовыеПараметры = ПараметрыИзАдресаURL(АдресДляПоказа);
		ЗаполнитьСтрокиПараметровURL(ПараметрыURL, НовыеПараметры);
		АдресПараметровURL = АдресДляПоказа;
		СнимокПараметровURL = ТекстДанныхДляСравнения(НовыеПараметры);
		ПрименитьДлинуАдресаURL();
		ОбновитьПредпросмотрURL();
	Исключение
		ОшибкаПараметровURL = ОписаниеОшибки();
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ПрименитьДлинуАдресаURL()

	Если СтрДлина(АдресПараметровURL) <= 2048 Тогда
		Адрес = АдресПараметровURL;
	Иначе
		Адрес = "";
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПредпросмотрURL()

	ОшибкаПараметровURL = ПроверитьАдресПараметровURL(АдресПараметровURL, ПараметрыURL);
	ПредпросмотрURL = АдресПараметровURL;
	Если Не ПустаяСтрока(ОшибкаПараметровURL) Или ПустаяСтрока(АдресПараметровURL) Тогда
		Возврат;
	КонецЕсли;
	Попытка
		ПодготовленныйАдрес = ПодготовитьАдресОтправкиURL(АдресПараметровURL,
			СпособАвторизации, РасположениеКлюча, ИмяКлюча, ЗначениеКлюча);
		ОшибкаПараметровURL = ПодготовленныйАдрес.Ошибка;
		Если ПустаяСтрока(ОшибкаПараметровURL) Тогда
			ПредпросмотрURL = ПодготовленныйАдрес.Адрес;
		КонецЕсли;
	Исключение
		ОшибкаПараметровURL = ОписаниеОшибки();
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Функция ПодготовитьПараметрыURLКДействию()

	Элементы.ПараметрыURL.ЗакончитьРедактированиеСтроки(Ложь);
	ЗаполнитьПараметрыИзАдресаURL();
	ПараметрыURLПриИзменении(Неопределено);
	ДанныеURL = Новый Структура("Адрес,ПараметрыURL", АдресДляПоказа, ПараметрыURLВМассив(ПараметрыURL));
	Ошибка = ПроверитьПараметрыПакетаURL(ДанныеURL, Ложь);
	Если Не ПустаяСтрока(Ошибка) Тогда
		СообщитьОФайле(Ошибка);
		Возврат Ложь;
	КонецЕсли;
	Если АдресДляПоказа <> АдресПараметровURL Тогда
		СообщитьОФайле(ОшибкаПараметровURL);
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция НовыйПараметрURL(Имя = "", ЗначениеПараметра = "", Используется = Истина)

	Возврат Новый Структура("Имя,Значение,Используется,ИсходнаяПара,ИсходноеИмя,ИсходноеЗначение,"
		+ "ЕстьИсходнаяПара,НеразрешенныйШаблон", Имя, ЗначениеПараметра, Используется,
		"", "", "", Ложь, Ложь);

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПараметрыURLВМассив(СтрокиПараметров)

	Результат = Новый Массив;
	Для Каждого СтрокаПараметра Из СтрокиПараметров Цикл
		ДанныеСтроки = НовыйПараметрURL();
		Для Каждого Поле Из ДанныеСтроки Цикл
			ДанныеСтроки[Поле.Ключ] = СтрокаПараметра[Поле.Ключ];
		КонецЦикла;
		Результат.Добавить(ДанныеСтроки);
	КонецЦикла;
	Возврат Результат;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьСтрокиПараметровURL(Коллекция, СтрокиПараметров)

	Коллекция.Очистить();
	Для Каждого ДанныеСтроки Из СтрокиПараметров Цикл
		СтрокаПараметра = Коллекция.Добавить();
		Для Каждого Поле Из ДанныеСтроки Цикл
			СтрокаПараметра[Поле.Ключ] = Поле.Значение;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПараметрыИзАдресаURL(ПолныйАдрес)

	Результат = Новый Массив;
	НачалоQuery = Найти(ПолныйАдрес, "?");
	Если НачалоQuery = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Пара Из СтрРазделить(Сред(ПолныйАдрес, НачалоQuery + 1), "&") Цикл
		Если Пара = "" Тогда
			Продолжить;
		КонецЕсли;
		Равно = Найти(Пара, "=");
		Если Равно = 0 Тогда
			Имя = Пара;
			ЗначениеПараметра = "";
		Иначе
			Имя = Лев(Пара, Равно - 1);
			ЗначениеПараметра = Сред(Пара, Равно + 1);
		КонецЕсли;
		СтрокаПараметра = НовыйПараметрURL(РаскодироватьПараметрURL(Имя),
			РаскодироватьПараметрURL(ЗначениеПараметра));
		СтрокаПараметра.ИсходнаяПара = Пара;
		СтрокаПараметра.ИсходноеИмя = СтрокаПараметра.Имя;
		СтрокаПараметра.ИсходноеЗначение = СтрокаПараметра.Значение;
		СтрокаПараметра.ЕстьИсходнаяПара = Истина;
		Результат.Добавить(СтрокаПараметра);
	КонецЦикла;
	Возврат Результат;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПараПараметраURL(СтрокаПараметра)

	Если СтрокаПараметра.ЕстьИсходнаяПара
		И СтрокаПараметра.Имя = СтрокаПараметра.ИсходноеИмя
		И СтрокаПараметра.Значение = СтрокаПараметра.ИсходноеЗначение Тогда
		Возврат СтрокаПараметра.ИсходнаяПара;
	КонецЕсли;
	Возврат ЗакодироватьПараметрURL(СтрокаПараметра.Имя) + "="
		+ ЗакодироватьПараметрURL(СтрокаПараметра.Значение);

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СобратьАдресПараметровURL(ПолныйАдрес, СтрокиПараметров)

	НачалоQuery = Найти(ПолныйАдрес, "?");
	БазовыйАдрес = ПолныйАдрес;
	Если НачалоQuery > 0 Тогда
		БазовыйАдрес = Лев(ПолныйАдрес, НачалоQuery - 1);
	КонецЕсли;
	Пары = Новый Массив;
	Для Каждого СтрокаПараметра Из СтрокиПараметров Цикл
		Если СтрокаПараметра.Используется И ЗаполненПараметрURL(СтрокаПараметра) Тогда
			Пары.Добавить(ПараПараметраURL(СтрокаПараметра));
		КонецЕсли;
	КонецЦикла;
	Если Пары.Количество() = 0 Тогда
		Возврат БазовыйАдрес;
	КонецЕсли;
	Возврат БазовыйАдрес + "?" + СтрСоединить(Пары, "&");

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПроверитьАдресПараметровURL(ПолныйАдрес, СтрокиПараметров)

	Если СтрДлина(ПолныйАдрес) > 2048 Тогда
		Возврат "URL превышает 2048 символов. Сократите адрес или параметры перед отправкой и сохранением.";
	КонецЕсли;
	Для Каждого СтрокаПараметра Из СтрокиПараметров Цикл
		Если СтрокаПараметра.Используется И СтрокаПараметра.НеразрешенныйШаблон
			И (Найти(СтрокаПараметра.Имя, "{{") > 0 Или Найти(СтрокаПараметра.Значение, "{{") > 0) Тогда
			Возврат "Замените неизвестную переменную в параметре URL: " + СтрокаПараметра.Имя;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЗаполненПараметрURL(СтрокаПараметра)

	Возврат СтрокаПараметра.Имя <> "" Или СтрокаПараметра.Значение <> ""
		Или (СтрокаПараметра.ЕстьИсходнаяПара И СтрокаПараметра.ИсходнаяПара = "="
			И СтрокаПараметра.ИсходноеИмя = "" И СтрокаПараметра.ИсходноеЗначение = "");

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПараметрыПакетаURL(Данные)

	Если Данные.Свойство("ПараметрыURL") Тогда
		Возврат Данные.ПараметрыURL;
	КонецЕсли;
	Возврат ПараметрыИзАдресаURL(Данные.Адрес);

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПроверитьПараметрыПакетаURL(Данные, Черновик)

	Попытка
		Если Данные.Свойство("ПараметрыURL") Тогда
			Если ТипЗнч(Данные.ПараметрыURL) <> Тип("Массив") Тогда
				Возврат "Повреждена таблица параметров URL.";
			КонецЕсли;
			Для Каждого ПараметрURL Из Данные.ПараметрыURL Цикл
				ОшибкаСтроки = ПроверитьСтрокуПараметровURL(ПараметрURL);
				Если Не ПустаяСтрока(ОшибкаСтроки) Тогда
					Возврат ОшибкаСтроки;
				КонецЕсли;
			КонецЦикла;
			АдресПоСтрокам = СобратьАдресПараметровURL(Данные.Адрес, Данные.ПараметрыURL);
			АдресПоQuery = СобратьАдресПараметровURL(Данные.Адрес, ПараметрыИзАдресаURL(Данные.Адрес));
			Если АдресПоСтрокам <> АдресПоQuery Тогда
				Возврат "Параметры URL не соответствуют сохраненному адресу.";
			КонецЕсли;
		КонецЕсли;
		Если Не Черновик Тогда
			Возврат ПроверитьАдресПараметровURL(Данные.Адрес, ПараметрыПакетаURL(Данные));
		КонецЕсли;
	Исключение
		Возврат "Не удалось разобрать параметры URL: " + ОписаниеОшибки();
	КонецПопытки;
	Возврат "";

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПроверитьСтрокуПараметровURL(СтрокаПараметра)

	Если ТипЗнч(СтрокаПараметра) <> Тип("Структура") Тогда
		Возврат "Повреждена строка параметров URL.";
	КонецЕсли;
	Для Каждого Поле Из НовыйПараметрURL() Цикл
		Если Не СтрокаПараметра.Свойство(Поле.Ключ)
			Или ТипЗнч(СтрокаПараметра[Поле.Ключ]) <> ТипЗнч(Поле.Значение) Тогда
			Возврат "Повреждено поле параметра URL: " + Поле.Ключ;
		КонецЕсли;
	КонецЦикла;
	Если СтрокаПараметра.ЕстьИсходнаяПара Тогда
		ИсходныеСтроки = ПараметрыИзАдресаURL("?" + СтрокаПараметра.ИсходнаяПара);
		Если ИсходныеСтроки.Количество() <> 1 Тогда
			Возврат "Повреждена исходная пара параметра URL.";
		КонецЕсли;
		Если ИсходныеСтроки[0].Имя <> СтрокаПараметра.ИсходноеИмя
			Или ИсходныеСтроки[0].Значение <> СтрокаПараметра.ИсходноеЗначение Тогда
			Возврат "Исходное кодирование параметра URL не соответствует его значениям.";
		КонецЕсли;
	КонецЕсли;
	Возврат "";

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПодготовитьАдресОтправкиURL(ПолныйАдрес, Авторизация, Размещение, Имя, ЗначениеКлючаURL)

	Части = РазобратьАдрес(ПолныйАдрес);
	Части.Вставить("Адрес", ПолныйАдрес);
	Если Не ПустаяСтрока(Части.Ошибка) Тогда
		Возврат Части;
	КонецЕсли;
	Если Авторизация = "APIKey" И Размещение = "ПараметрURL" Тогда
		Если ПустаяСтрока(Имя) Или ПустаяСтрока(ЗначениеКлючаURL) Тогда
			Части.Ошибка = "Укажите имя и значение API key.";
			Возврат Части;
		КонецЕсли;
		Если ЕстьПараметрВАдресе(Части.Ресурс, Имя) Тогда
			Части.Ошибка = "Параметр API key уже указан в URL.";
			Возврат Части;
		КонецЕсли;
		ДобавитьКлючКАдресу(Части, Имя, ЗначениеКлючаURL);
	КонецЕсли;
	Схема = "http://";
	Если Части.HTTPS Тогда
		Схема = "https://";
	КонецЕсли;
	Части.Адрес = Схема + Части.Узел + Части.Ресурс;
	Если СтрДлина(Части.Адрес) > 2048 Тогда
		Части.Ошибка = "Итоговый URL превышает 2048 символов, включая API key.";
	КонецЕсли;
	Возврат Части;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЗакодироватьПараметрURL(Текст)

	Результат = "";
	Позиция = 1;
	БезКодирования = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-._~";
	Пока Позиция <= СтрДлина(Текст) Цикл
		Знак = Сред(Текст, Позиция, 1);
		Код = КодСимвола(Текст, Позиция);
		Если Код >= 55296 И Код <= 56319 И Позиция < СтрДлина(Текст) Тогда
			Младший = КодСимвола(Текст, Позиция + 1);
			Если Младший >= 56320 И Младший <= 57343 Тогда
				Код = 65536 + (Код - 55296) * 1024 + Младший - 56320;
				Позиция = Позиция + 1;
			КонецЕсли;
		КонецЕсли;
		Если Найти(БезКодирования, Знак) > 0 Тогда
			Результат = Результат + Знак;
		ИначеЕсли Код < 128 Тогда
			Результат = Результат + ПроцентныйБайтURL(Код);
		ИначеЕсли Код < 2048 Тогда
			Результат = Результат + ПроцентныйБайтURL(192 + Цел(Код / 64))
				+ ПроцентныйБайтURL(128 + Код % 64);
		ИначеЕсли Код >= 55296 И Код <= 57343 Тогда
			ВызватьИсключение "Некорректный символ Unicode в параметре URL.";
		ИначеЕсли Код < 65536 Тогда
			Результат = Результат + ПроцентныйБайтURL(224 + Цел(Код / 4096))
				+ ПроцентныйБайтURL(128 + Цел(Код / 64) % 64) + ПроцентныйБайтURL(128 + Код % 64);
		Иначе
			Результат = Результат + ПроцентныйБайтURL(240 + Цел(Код / 262144))
				+ ПроцентныйБайтURL(128 + Цел(Код / 4096) % 64)
				+ ПроцентныйБайтURL(128 + Цел(Код / 64) % 64) + ПроцентныйБайтURL(128 + Код % 64);
		КонецЕсли;
		Позиция = Позиция + 1;
	КонецЦикла;
	Возврат Результат;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПроцентныйБайтURL(Код)

	Цифры = "0123456789ABCDEF";
	Возврат "%" + Сред(Цифры, Цел(Код / 16) + 1, 1) + Сред(Цифры, Код % 16 + 1, 1);

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция РаскодироватьПараметрURL(Текст)

	Результат = "";
	Позиция = 1;
	Осталось = 0;
	Код = 0;
	Минимум = 0;
	Цифры = "0123456789ABCDEF";
	Пока Позиция <= СтрДлина(Текст) Цикл
		Знак = Сред(Текст, Позиция, 1);
		Старший = Найти(Цифры, ВРег(Сред(Текст, Позиция + 1, 1))) - 1;
		Младший = Найти(Цифры, ВРег(Сред(Текст, Позиция + 2, 1))) - 1;
		Если Знак <> "%" Или Позиция + 2 > СтрДлина(Текст) Или Старший < 0 Или Младший < 0 Тогда
			Если Осталось > 0 Тогда
				ВызватьИсключение "Незавершенная UTF-8 последовательность в параметре URL.";
			КонецЕсли;
			Если Знак = "+" Тогда
				Знак = " ";
			КонецЕсли;
			Результат = Результат + Знак;
			Позиция = Позиция + 1;
			Продолжить;
		КонецЕсли;
		Байт = Старший * 16 + Младший;
		Позиция = Позиция + 3;
		Если Осталось > 0 Тогда
			Если Байт < 128 Или Байт > 191 Тогда
				ВызватьИсключение "Некорректная UTF-8 последовательность в параметре URL.";
			КонецЕсли;
			Код = Код * 64 + Байт - 128;
			Осталось = Осталось - 1;
			Если Осталось = 0 Тогда
				Если Код < Минимум Или Код > 1114111 Или (Код >= 55296 И Код <= 57343) Тогда
					ВызватьИсключение "Некорректный символ UTF-8 в параметре URL.";
				КонецЕсли;
				Результат = Результат + СимволUnicodeURL(Код);
			КонецЕсли;
		ИначеЕсли Байт < 128 Тогда
			Результат = Результат + Символ(Байт);
		ИначеЕсли Байт >= 194 И Байт <= 223 Тогда
			Осталось = 1;
			Код = Байт - 192;
			Минимум = 128;
		ИначеЕсли Байт >= 224 И Байт <= 239 Тогда
			Осталось = 2;
			Код = Байт - 224;
			Минимум = 2048;
		ИначеЕсли Байт >= 240 И Байт <= 244 Тогда
			Осталось = 3;
			Код = Байт - 240;
			Минимум = 65536;
		Иначе
			ВызватьИсключение "Некорректный байт UTF-8 в параметре URL.";
		КонецЕсли;
	КонецЦикла;
	Если Осталось > 0 Тогда
		ВызватьИсключение "Незавершенная UTF-8 последовательность в параметре URL.";
	КонецЕсли;
	Возврат Результат;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СимволUnicodeURL(Код)

	Если Код < 65536 Тогда
		Возврат Символ(Код);
	КонецЕсли;
	Код = Код - 65536;
	Возврат Символ(55296 + Цел(Код / 1024)) + Символ(56320 + Код % 1024);

КонецФункции

#КонецОбласти


#Область КонтекстHTTP

&НаКлиенте
Процедура ИнициализироватьКлиентскийHTTP()
	HTTPЗапросВыполняется = Ложь;
	ФормаHTTPЗакрыта = Ложь;
	КлиентскийHTTPДоступен = Ложь;
	ПричинаКлиентскогоHTTP = "";
	Элементы.КонтекстВыполнения.Видимость = Ложь;
	Если Не ВерсияПоддерживаетКлиентскийHTTP() Тогда
		Возврат;
	КонецЕсли;
#Если ТонкийКлиент Или ТолстыйКлиентУправляемоеПриложение Тогда
	Попытка
		Соединение = Новый HTTPСоединение("127.0.0.1");
		ЗапросHTTP = Новый HTTPЗапрос("/");
		КлиентскийHTTPДоступен = Соединение <> Неопределено И ЗапросHTTP <> Неопределено;
	Исключение
		ПричинаКлиентскогоHTTP = ОписаниеОшибки();
	КонецПопытки;
#КонецЕсли
	Элементы.КонтекстВыполнения.РежимВыбораИзСписка = Истина;
	Элементы.КонтекстВыполнения.СписокВыбора.Очистить();
	Элементы.КонтекстВыполнения.СписокВыбора.Добавить("Сервер", "На сервере");
	Элементы.КонтекстВыполнения.СписокВыбора.Добавить("Клиент", "На клиенте");
	Элементы.КонтекстВыполнения.Видимость = КлиентскийHTTPДоступен;
КонецПроцедуры

&НаКлиенте
Функция ВерсияПоддерживаетКлиентскийHTTP()

	Информация = Новый СистемнаяИнформация;
	ЧастиВерсии = СтрРазделить(Информация.ВерсияПриложения, ".");
	Если ЧастиВерсии.Количество() < 3 Тогда

		Возврат Ложь;

	КонецЕсли;
	МинимальнаяВерсия = Новый Массив;
	МинимальнаяВерсия.Добавить(8);
	МинимальнаяВерсия.Добавить(3);
	МинимальнаяВерсия.Добавить(21);
	Для Позиция = 0 По 2 Цикл

		КомпонентВерсии = Число(ЧастиВерсии[Позиция]);
		Если КомпонентВерсии > МинимальнаяВерсия[Позиция] Тогда

			Возврат Истина;

		ИначеЕсли КомпонентВерсии < МинимальнаяВерсия[Позиция] Тогда

			Возврат Ложь;

		КонецЕсли;

	КонецЦикла;
	Возврат Истина;

КонецФункции



&НаКлиенте
Процедура ЗавершитьКлиентскийHTTP()
	ПодготовкаУзлаWorkSpace = Неопределено;
	ЧтениеДереваWorkSpace = Неопределено;
	ФормаHTTPЗакрыта = Истина;
	HTTPЗапросВыполняется = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура КонтекстВыполненияПриИзменении(Элемент)

	ОтметитьИзменениеЗапроса();

КонецПроцедуры

&НаКлиенте
Функция НастройкиОсновногоHTTP()

	Настройки = НоваяНастройкаЗапроса(Адрес, Метод, ТелоЗапроса, ЗаголовкиЗапроса);
	Настройки.СпособАвторизации = СпособАвторизации;
	Настройки.Логин = Логин;
	Настройки.Пароль = Пароль;
	Настройки.ТокенBearer = ТокенBearer;
	Настройки.ТокенJWT = ТокенJWT;
	Настройки.ИмяКлюча = ИмяКлюча;
	Настройки.ЗначениеКлюча = ЗначениеКлюча;
	Настройки.РасположениеКлюча = РасположениеКлюча;
	Настройки.ТаймаутСекунд = ТаймаутСекунд;
	Настройки.Вставить("КонтекстВыполнения", КонтекстВыполнения);
	Возврат Настройки;

КонецФункции

&НаКлиенте
Процедура НачатьHTTPВКонтексте(Настройки)

	Если HTTPЗапросВыполняется Тогда

		Возврат;

	КонецЕсли;
	Подготовка = ПодготовитьHTTPЗапрос(Настройки);
	Если Не ПустаяСтрока(Подготовка.Результат.Ошибка) Тогда

		ЗавершитьHTTPВКонтексте(Подготовка.Результат, Настройки);
		Возврат;

	КонецЕсли;
	Если Настройки.КонтекстВыполнения = "Клиент" И Не КлиентскийHTTPДоступен Тогда

		Подготовка.Результат.Ошибка = "Клиентский HTTP недоступен в текущем сеансе.";
		ЗавершитьHTTPВКонтексте(Подготовка.Результат, Настройки);
		Возврат;

	КонецЕсли;
	HTTPЗапросВыполняется = Истина;
	ОбновитьКомандыWorkSpace();
	Попытка

		Если Настройки.КонтекстВыполнения = "Клиент" Тогда

			ОтправитьКлиентскийHTTPАсинх(Подготовка, Настройки);

		Иначе

			Результат = ВыполнитьПодготовленныйHTTPНаСервере(Подготовка);
			ЗавершитьHTTPВКонтексте(Результат, Настройки);

		КонецЕсли;

	Исключение

		Подготовка.Результат.Ошибка = ОписаниеОшибки();
		ЗавершитьHTTPВКонтексте(Подготовка.Результат, Настройки);

	КонецПопытки;

КонецПроцедуры

// Принимает ответ клиентского исполнителя для живого экземпляра основной формы.
// Параметры:
//  Результат - Структура - код, заголовки, тело, ошибка и время HTTP.
//  Настройки - Структура - снимок параметров отправленного запроса.
&НаКлиенте
Процедура ПослеКлиентскогоHTTP(Результат, Настройки) Экспорт

	Если ФормаHTTPЗакрыта Тогда

		Возврат;

	КонецЕсли;
	Попытка

		ЗавершитьHTTPВКонтексте(Результат, Настройки);

	Исключение

		HTTPЗапросВыполняется = Ложь;
		ОшибкаЗапроса = "Не удалось отобразить результат клиентского HTTP: " + ОписаниеОшибки();
		ОбновитьКомандыWorkSpace();

	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьHTTPВКонтексте(Результат, Настройки)

	HTTPЗапросВыполняется = Ложь;
	Если ФормаHTTPЗакрыта Тогда

		Возврат;

	КонецЕсли;
	ОбновитьКомандыWorkSpace();
	Если Настройки.ЗапросТокена Тогда

		Результат = ДополнитьРезультатТокеном(Результат, Настройки.ПутьТокена);

	КонецЕсли;
	ПоказатьРезультат(Результат);
	Если Настройки.ЗапросТокена И Не ПустаяСтрока(Результат.Токен) Тогда

		ТокенJWT = Результат.Токен;
		СпособАвторизации = "JWT";
		СостояниеТокена = "Токен получен и готов к отправке";
		ОбновитьВидимостьАвторизации();
		ОбновитьПредпросмотрURL();
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаАвторизация;

	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция КонтекстДанныхЗапроса(Данные)

	Если Данные.Свойство("КонтекстВыполнения") Тогда

		Возврат Данные.КонтекстВыполнения;

	КонецЕсли;
	Возврат "Сервер";

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПроверитьКонтекстПакета(Данные)

	Если Не Данные.Свойство("КонтекстВыполнения") Тогда

		Возврат "";

	КонецЕсли;
	Если ТипЗнч(Данные.КонтекстВыполнения) <> Тип("Строка") Тогда

		Возврат "Некорректный тип контекста выполнения запроса.";

	КонецЕсли;
	Если Данные.КонтекстВыполнения <> "Сервер" И Данные.КонтекстВыполнения <> "Клиент" Тогда

		Возврат "Неизвестный контекст выполнения запроса.";

	КонецЕсли;
	Возврат "";

КонецФункции

&НаКлиенте
Функция ИмпортСТекущимКонтекстом(ТекстСостояния)

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ТекстСостояния);
	Пакет = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();
	Пакет.Данные.Вставить("КонтекстВыполнения", КонтекстВыполнения);
	Писатель = Новый ЗаписьJSON;
	Писатель.УстановитьСтроку();
	ЗаписатьJSON(Писатель, Пакет);
	Возврат Писатель.Закрыть();

КонецФункции

&НаКлиенте
Асинх Процедура ПрочитатьWorkSpaceАсинх(Путь, Чтение)
	Результат = Новый Структура("Узлы,Ошибка,Предупреждения", Новый Массив, "", Новый Массив);
	Попытка
		Результат.Узлы = Ждать ПрочитатьКаталогWorkSpaceАсинх(Путь, Результат.Предупреждения);
	Исключение
		Результат.Ошибка = ОписаниеОшибки();
	КонецПопытки;
	Если Не ФормаHTTPЗакрыта Тогда
		ПослеЧтенияДереваWorkSpace(Результат, Чтение);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Асинх Функция ПрочитатьКаталогWorkSpaceАсинх(Путь, Предупреждения)
	Каталог = Новый Файл(Путь);
	Существует = Ждать Каталог.СуществуетАсинх();
	Если Не Существует Тогда
		ВызватьИсключение "Каталог отсутствует: " + Путь;
	КонецЕсли;
	ЭтоКаталог = Ждать Каталог.ЭтоКаталогАсинх();
	Если Не ЭтоКаталог Тогда
		ВызватьИсключение "Путь не является каталогом: " + Путь;
	КонецЕсли;
	Файлы = Ждать НайтиФайлыАсинх(Путь, "*", Ложь);
	Узлы = Новый Массив;
	Для Каждого ФайлКаталога Из Файлы Цикл
		ЭтоКаталог = Ждать ФайлКаталога.ЭтоКаталогАсинх();
		Если ЭтоКаталог Тогда
			Узел = Новый Структура("Имя,Каталог,Дети,Текст", ФайлКаталога.Имя, Истина, Новый Массив, "");
			Узлы.Добавить(Узел);
			Попытка
				Узел.Дети = Ждать ПрочитатьКаталогWorkSpaceАсинх(ФайлКаталога.ПолноеИмя, Предупреждения);
			Исключение
				Предупреждения.Добавить("Не удалось прочитать каталог «" + ФайлКаталога.Имя + "»: " + ОписаниеОшибки());
			КонецПопытки;
		ИначеЕсли НРег(ФайлКаталога.Расширение) = ".json" Тогда
			Попытка
				Документ = Новый ТекстовыйДокумент;
				Ждать Документ.ПрочитатьАсинх(ФайлКаталога.ПолноеИмя, КодировкаТекста.UTF8);
				Узлы.Добавить(Новый Структура("Имя,Каталог,Дети,Текст", ФайлКаталога.Имя,
					Ложь, Новый Массив, Документ.ПолучитьТекст()));
			Исключение
				// Недоступные файлы пропускаются, как при прежней проверке формата.
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	Возврат Узлы;
КонецФункции

&НаКлиенте
Асинх Процедура ПодготовитьУзелWorkSpaceАсинх(Путь, СоздатьПапку, Подготовка)
	Результат = Новый Структура("Ошибка", "");
	Попытка
		ФайлНазначения = Новый Файл(Путь);
		Существует = Ждать ФайлНазначения.СуществуетАсинх();
		Если Существует Тогда
			ВызватьИсключение "Файл или каталог с таким именем уже существует.";
		КонецЕсли;
		КаталогНазначения = Новый Файл(ФайлНазначения.Путь);
		Существует = Ждать КаталогНазначения.СуществуетАсинх();
		Если Не Существует Тогда
			ВызватьИсключение "Целевой каталог отсутствует. Обновите дерево WorkSpace.";
		КонецЕсли;
		ЭтоКаталог = Ждать КаталогНазначения.ЭтоКаталогАсинх();
		Если Не ЭтоКаталог Тогда
			ВызватьИсключение "Целевой путь не является каталогом. Обновите дерево WorkSpace.";
		КонецЕсли;
		Если СоздатьПапку И Не ФормаHTTPЗакрыта Тогда
			Ждать СоздатьКаталогАсинх(Путь);
		КонецЕсли;
	Исключение
		Результат.Ошибка = ОписаниеОшибки();
	КонецПопытки;
	Если Не ФормаHTTPЗакрыта Тогда
		ПослеПодготовкиУзлаWorkSpace(Результат, Подготовка);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Асинх Процедура ОтправитьКлиентскийHTTPАсинх(Подготовка, Настройки)
	Попытка
		Результат = Ждать ВыполнитьПодготовленныйHTTPАсинх(Подготовка);
	Исключение
		Результат = Подготовка.Результат;
		Результат.Ошибка = ОписаниеОшибки();
	КонецПопытки;
	Если Не ФормаHTTPЗакрыта Тогда
		ПослеКлиентскогоHTTP(Результат, Настройки);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Асинх Функция ВыполнитьПодготовленныйHTTPАсинх(Подготовка)
	Результат = Подготовка.Результат;
	Если Не ПустаяСтрока(Результат.Ошибка) Тогда

		Возврат Результат;

	КонецЕсли;
	ЧастиАдреса = Подготовка.ЧастиАдреса;
	Заголовки = Подготовка.Заголовки;
	ЛогинСоединения = Подготовка.ЛогинСоединения;
	ПарольСоединения = Подготовка.ПарольСоединения;
	МетодЗапроса = Подготовка.МетодЗапроса;
	НачалоЗапросаМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Попытка
		Если ЧастиАдреса.HTTPS Тогда
			ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL;
		Иначе
			ЗащищенноеСоединение = Неопределено;
		КонецЕсли;
		Соединение = Новый HTTPСоединение(ЧастиАдреса.Сервер, ЧастиАдреса.Порт,
			ЛогинСоединения, ПарольСоединения, Неопределено,
			Подготовка.ТаймаутСекунд, ЗащищенноеСоединение);
		Запрос = Новый HTTPЗапрос(ЧастиАдреса.Ресурс, Заголовки);
		Если Не ПустаяСтрока(Подготовка.Тело) Тогда
			Запрос.УстановитьТелоИзСтроки(Подготовка.Тело, КодировкаТекста.UTF8);
		КонецЕсли;
		Ответ = Ждать Соединение.ВызватьHTTPМетодАсинх(МетодЗапроса, Запрос);
		Результат.Код = Ответ.КодСостояния;
		Для Каждого ЗаголовокОтвета Из Ответ.Заголовки Цикл
			Результат.Заголовки = Результат.Заголовки + ЗаголовокОтвета.Ключ
				+ ": " + ЗаголовокОтвета.Значение + Символы.ПС;
		КонецЦикла;
	Исключение
		Результат.Код = 0;
		Результат.Заголовки = "";
		Результат.Тело = "";
		Результат.Ошибка = "Ошибка HTTP-соединения или чтения ответа. Проверьте адрес, сертификат и сеть.";
		Результат.ВремяЗапросаМс = Макс(0, Цел(ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоЗапросаМс));
		Возврат Результат;
	КонецПопытки;
	Попытка
		Результат.Тело = Ответ.ПолучитьТелоКакСтроку();
	Исключение
		Результат.Тело = "[Тело ответа не удалось прочитать как текст.]";
	КонецПопытки;
	Результат.ВремяЗапросаМс = Макс(0, Цел(ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоЗапросаМс));
	Возврат Результат;
КонецФункции

#КонецОбласти
